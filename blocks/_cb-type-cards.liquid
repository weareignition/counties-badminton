<div
  class="cb-type__cards"
  style="--cbty-columns: {{ block.settings.columns }}; --cbty-card-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  /* Phones 2 per row, tablets 3, desktop the chosen number. */
  .cb-type__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media screen and (min-width: 750px) {
    .cb-type__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--cbty-card-gap, 18px);
    }
  }

  @media screen and (min-width: 990px) {
    .cb-type__cards {
      grid-template-columns: repeat(var(--cbty-columns, 6), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Type cards",
  "tag": null,
  "blocks": [{ "type": "_cb-type-card" }],
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "Cards per row on desktop",
      "info": "Tablets show 3 per row, phones 2.",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "[CB] Type cards",
      "blocks": {
        "card_1": { "type": "_cb-type-card" },
        "card_2": { "type": "_cb-type-card" },
        "card_3": { "type": "_cb-type-card" }
      },
      "block_order": ["card_1", "card_2", "card_3"]
    }
  ]
}
{% endschema %}
