{%- liquid
  assign product = block.settings.product
  assign image = block.settings.image | default: product.featured_image

  # Title: the product's own title once a product is chosen, unless "Use custom title" is on.
  # The custom title also previews the card before a product is chosen.
  assign card_title = product.title
  if product == blank or block.settings.use_custom_title
    assign card_title = block.settings.card_title | default: product.title
  endif
  assign card_title = card_title | default: 'Product title'

  # Brand: the brand typed on the card, otherwise the product's vendor.
  assign vendor = block.settings.vendor_label | default: product.vendor

  assign url = product.url | default: block.settings.button_link | default: routes.all_products_collection_url
  assign button_url = block.settings.button_link | default: url

  # Space-separated keys the filter pills match: this card's categories plus the product's tags.
  assign filter_keys = ''
  assign categories = block.settings.filter_keys | split: ','
  for category in categories
    assign key = category | strip | handleize
    if key != blank
      assign filter_keys = filter_keys | append: ' ' | append: key
    endif
  endfor
  for tag in product.tags
    assign key = tag | handleize
    assign filter_keys = filter_keys | append: ' ' | append: key
  endfor

  # Stock label shows while the product is available (and in the editor before a product is chosen).
  assign stock_label = block.settings.stock_label
  assign sold_out = false
  if product != blank and product.available == false
    assign stock_label = 'content.product_badge_sold_out' | t
    assign sold_out = true
  endif

  # Price: a chosen product always shows its real price; the typed price is for cards without a product.
  assign price = ''
  if product != blank
    assign price = product.price | money_without_trailing_zeros
    if product.price_varies
      assign price = 'content.price_from' | t: price: price
    endif
  elsif block.settings.custom_price != blank
    assign custom_cents = block.settings.custom_price | remove: '$' | remove: ',' | strip | times: 100 | round
    if custom_cents > 0
      assign price = custom_cents | money_without_trailing_zeros
    endif
  endif

  # Rating: the reviews app's rating when the product has one, otherwise the typed rating (if above 0).
  assign rating = product.metafields.reviews.rating.value.rating
  assign rating_scale = product.metafields.reviews.rating.value.scale_max | default: 5
  assign rating_count = product.metafields.reviews.rating_count
  if rating == blank and block.settings.custom_rating > 0
    assign rating = block.settings.custom_rating
    assign rating_scale = 5
    assign rating_count = block.settings.custom_rating_count
  endif
  if rating != blank
    assign rating_percent = rating | times: 100.0 | divided_by: rating_scale
  endif

  assign specs = block.settings.specs | split: ','
-%}

<article
  class="cb-frame-card"
  data-cb-filter-keys="{{ filter_keys | strip }}"
  style="
    --cb-frames-card-badge-size: {{ block.settings.badge_size }}px;
    --cb-frames-card-badge-weight: {{ block.settings.badge_weight }};
    --cb-frames-card-stock-size: {{ block.settings.stock_size }}px;
    --cb-frames-card-stock-weight: {{ block.settings.stock_weight }};
    --cb-frames-card-vendor-size: {{ block.settings.vendor_size }}px;
    --cb-frames-card-vendor-weight: {{ block.settings.vendor_weight }};
    --cb-frames-card-title-size: {{ block.settings.title_size }}px;
    --cb-frames-card-title-weight: {{ block.settings.title_weight }};
    --cb-frames-card-rating-size: {{ block.settings.rating_size }}px;
    --cb-frames-card-rating-weight: {{ block.settings.rating_weight }};
    --cb-frames-card-price-size: {{ block.settings.price_size }}px;
    --cb-frames-card-price-weight: {{ block.settings.price_weight }};
    --cb-frames-card-compare-size: {{ block.settings.compare_size }}px;
    --cb-frames-card-compare-weight: {{ block.settings.compare_weight }};
    --cb-frames-card-currency-size: {{ block.settings.currency_size }}px;
    --cb-frames-card-currency-weight: {{ block.settings.currency_weight }};
    --cb-frames-card-perk-size: {{ block.settings.perk_size }}px;
    --cb-frames-card-perk-weight: {{ block.settings.perk_weight }};
    --cb-frames-card-specs-size: {{ block.settings.specs_size }}px;
    --cb-frames-card-specs-weight: {{ block.settings.specs_weight }};
    --cb-frames-card-button-size: {{ block.settings.button_size }}px;
    --cb-frames-card-button-weight: {{ block.settings.button_weight }};
  "
  {{ block.shopify_attributes }}
>
  <div class="cb-frame-card__media">
    <a href="{{ url }}" class="cb-frame-card__image-link" tabindex="-1" aria-hidden="true">
      {%- if image != blank -%}
        {{
          image
          | image_url: width: 800
          | image_tag:
            widths: '240, 360, 480, 640, 800',
            sizes: '(min-width: 990px) 22vw, (min-width: 750px) 45vw, 78vw',
            loading: 'lazy',
            class: 'cb-frame-card__image'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'cb-frame-card__image cb-frame-card__image--placeholder' }}
      {%- endif -%}
    </a>

    {%- if block.settings.badge_text != blank -%}
      <span class="cb-frame-card__badge cb-frame-card__badge--{{ block.settings.badge_style }}">
        {{- block.settings.badge_text | escape -}}
      </span>
    {%- endif -%}

    {%- if stock_label != blank -%}
      <span class="cb-frame-card__stock{% if sold_out %} cb-frame-card__stock--sold-out{% endif %}">
        {{- stock_label | escape -}}
      </span>
    {%- endif -%}
  </div>

  <div class="cb-frame-card__body">
    {%- if vendor != blank -%}
      <p class="cb-frame-card__vendor">{{ vendor | escape }}</p>
    {%- endif -%}

    <h3 class="cb-frame-card__title">
      <a href="{{ url }}">{{ card_title | escape }}</a>
    </h3>

    {%- if block.settings.show_rating and rating != blank -%}
      <p class="cb-frame-card__rating">
        <span class="cb-frame-card__stars" style="--cbp-rating: {{ rating_percent }}%;" aria-hidden="true"></span>
        <span class="cb-frame-card__rating-value">{{ rating | times: 1.0 | round: 1 }}</span>
        {%- if rating_count != blank -%}
          <span class="cb-frame-card__rating-count">({{ rating_count }})</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    <div class="cb-frame-card__price-row">
      {%- if price != blank -%}
        <p class="cb-frame-card__price">
          <span class="cb-frame-card__amount">{{ price }}</span>
          {%- if product != blank and product.compare_at_price > product.price -%}
            <s class="cb-frame-card__compare">{{ product.compare_at_price | money_without_trailing_zeros }}</s>
          {%- endif -%}
          {%- if block.settings.show_currency -%}
            <span class="cb-frame-card__currency">{{ cart.currency.iso_code }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if block.settings.show_perk and block.settings.perk_text != blank -%}
        <span class="cb-frame-card__perk">{{ block.settings.perk_text | escape }}</span>
      {%- endif -%}
    </div>

    {%- if specs.size > 0 -%}
      <ul class="cb-frame-card__specs" role="list">
        {%- for spec in specs -%}
          {%- assign spec_label = spec | strip -%}
          {%- if spec_label != blank -%}
            <li>{{ spec_label | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if block.settings.button_label != blank -%}
      <a href="{{ button_url }}" class="cb-frame-card__button">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>
        </svg>
        {{- block.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .cb-frame-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 12px;
    background: var(--cbp-card);
    border: 1px solid var(--cbp-border);
    border-radius: var(--cbp-radius);
    transition: border-color 0.2s ease;
  }

  .cb-frame-card[hidden] {
    display: none;
  }

  .cb-frame-card:hover {
    border-color: var(--cbp-border-hover);
  }

  .cb-frame-card__media {
    position: relative;
    aspect-ratio: var(--cbp-image-ratio, 1 / 1);
    overflow: hidden;
    border-radius: calc(var(--cbp-radius) * 0.5);
    background: var(--cbp-image-bg);
  }

  .cb-frame-card__image-link {
    position: absolute;
    inset: 0;
    display: block;
  }

  .cb-frame-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--cbp-image-fit, contain);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cb-frame-card__image--placeholder {
    fill: rgb(0 0 0 / 0.2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cb-frame-card:hover .cb-frame-card__image {
      transform: scale(1.04);
    }
  }

  .cb-frame-card__badge,
  .cb-frame-card__stock {
    position: absolute;
    z-index: 1;
    max-width: calc(100% - 16px);
    border-radius: 3px;
    font-family: var(--cbp-font-body);
    font-weight: var(--cb-frames-card-badge-weight, var(--cbp-font-body-strong));
    font-size: var(--cb-frames-card-badge-size, 9px);
    line-height: 1.25;
    pointer-events: none;
  }

  .cb-frame-card__badge {
    top: 8px;
    left: 8px;
    padding: 3px 7px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cb-frame-card__badge--dark {
    background: #111;
    color: #fff;
  }

  .cb-frame-card__badge--accent {
    background: var(--cbp-accent);
    color: var(--cbp-accent-text);
  }

  .cb-frame-card__badge--muted {
    background: #4a4a4a;
    color: #fff;
  }

  .cb-frame-card__stock {
    right: 8px;
    bottom: 8px;
    padding: 4px 8px;
    border: 1px solid rgb(0 0 0 / 0.12);
    background: #fff;
    font-weight: var(--cb-frames-card-stock-weight, var(--cbp-font-body-strong));
    font-size: var(--cb-frames-card-stock-size, 9px);
    color: #111;
  }

  .cb-frame-card__stock--sold-out {
    border-color: rgb(255 255 255 / 0.2);
    background: #111;
    color: #fff;
  }

  .cb-frame-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 6px;
    padding: 0 2px;
  }

  .cb-frame-card__vendor {
    margin: 0;
    font-family: var(--cbp-font-body);
    font-weight: var(--cb-frames-card-vendor-weight, var(--cbp-font-body-strong));
    font-size: var(--cb-frames-card-vendor-size, 9px);
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cbp-accent);
  }

  .cb-frame-card__title {
    margin: 0;
    font-family: var(--cbp-font-heading);
    font-weight: var(--cb-frames-card-title-weight, var(--cbp-font-heading-weight));
    font-size: var(--cb-frames-card-title-size, 15px);
    line-height: 1.25;
    color: var(--cbp-text);
  }

  .cb-frame-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .cb-frame-card__title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cb-frame-card__rating {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0;
    font-family: var(--cbp-font-body);
    font-weight: var(--cb-frames-card-rating-weight, inherit);
    font-size: var(--cb-frames-card-rating-size, 11px);
    line-height: 1;
    color: var(--cbp-muted);
  }

  .cb-frame-card__rating-value {
    font-weight: max(var(--cb-frames-card-rating-weight, 0), var(--cbp-font-body-strong));
    color: var(--cbp-text);
  }

  /* Five stars; the gold layer is clipped to the rating percentage. */
  .cb-frame-card__stars {
    position: relative;
    display: inline-block;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--cbp-star-empty);
  }

  .cb-frame-card__stars::before {
    content: '★★★★★';
  }

  .cb-frame-card__stars::after {
    content: '★★★★★';
    position: absolute;
    inset: 0;
    width: var(--cbp-rating, 0%);
    overflow: hidden;
    white-space: nowrap;
    color: var(--cbp-star);
  }

  .cb-frame-card__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--cbp-border);
  }

  .cb-frame-card__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin: 0;
  }

  .cb-frame-card__amount {
    font-family: var(--cbp-font-heading);
    font-weight: var(--cb-frames-card-price-weight, var(--cbp-font-heading-weight));
    font-size: var(--cb-frames-card-price-size, 19px);
    line-height: 1;
    color: var(--cbp-text);
  }

  .cb-frame-card__compare {
    font-family: var(--cbp-font-body);
    font-weight: var(--cb-frames-card-compare-weight, inherit);
    font-size: var(--cb-frames-card-compare-size, 12px);
    color: var(--cbp-muted);
  }

  .cb-frame-card__currency {
    font-family: var(--cbp-font-body);
    font-weight: var(--cb-frames-card-currency-weight, var(--cbp-font-body-strong));
    font-size: var(--cb-frames-card-currency-size, 9px);
    letter-spacing: 0.04em;
    color: var(--cbp-muted);
  }

  .cb-frame-card__perk {
    padding: 3px 7px;
    border: 1px solid color-mix(in srgb, var(--cbp-perk) 35%, transparent);
    border-radius: 4px;
    background: color-mix(in srgb, var(--cbp-perk) 12%, transparent);
    font-family: var(--cbp-font-body);
    font-weight: var(--cb-frames-card-perk-weight, var(--cbp-font-body-strong));
    font-size: var(--cb-frames-card-perk-size, 9px);
    line-height: 1.25;
    white-space: nowrap;
    color: var(--cbp-perk);
  }

  .cb-frame-card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 6px 0 8px;
    padding: 0;
    list-style: none;
  }

  .cb-frame-card__specs li {
    padding: 4px 8px;
    border: 1px solid var(--cbp-border);
    border-radius: 4px;
    background: var(--cbp-surface);
    font-family: var(--cbp-font-body);
    font-weight: var(--cb-frames-card-specs-weight, var(--cbp-font-body-weight));
    font-size: var(--cb-frames-card-specs-size, 10px);
    line-height: 1.25;
    color: var(--cbp-text);
  }

  .cb-frame-card__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    margin-top: auto;
    padding: 10px 12px;
    border: 1px solid var(--cbp-border);
    border-radius: 6px;
    background: var(--cbp-surface-strong);
    font-family: var(--cbp-font-body);
    font-weight: var(--cb-frames-card-button-weight, var(--cbp-font-body-strong));
    font-size: var(--cb-frames-card-button-size, 11px);
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    color: var(--cbp-text);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .cb-frame-card__button svg {
    flex: none;
  }

  .cb-frame-card__button:hover {
    border-color: var(--cbp-border-hover);
    background: var(--cbp-border);
  }

  .cb-frame-card__title a:focus-visible,
  .cb-frame-card__button:focus-visible {
    outline: 2px solid var(--cbp-text);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Product card",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Price, stock, rating and links come from this product."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the product's image."
    },
    {
      "type": "checkbox",
      "id": "use_custom_title",
      "label": "Use custom title",
      "info": "Off: the card shows the product's own title.",
      "default": false
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Custom title",
      "info": "Used when the box above is on, and as a preview before a product is chosen."
    },
    {
      "type": "text",
      "id": "vendor_label",
      "label": "Brand",
      "info": "Leave empty to use the product's vendor."
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge"
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge style",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" },
        { "value": "muted", "label": "Grey" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "stock_label",
      "label": "In-stock label",
      "info": "Shown while the product is in stock. Shows \"Sold out\" when it isn't.",
      "default": "In Stock Papakura"
    },
    {
      "type": "checkbox",
      "id": "show_perk",
      "label": "Show perk tag",
      "default": true
    },
    {
      "type": "text",
      "id": "perk_text",
      "label": "Perk tag",
      "default": "Free Custom String",
      "visible_if": "{{ block.settings.show_perk }}"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show review rating",
      "info": "Shows the product's rating from your reviews app, or the star rating set below.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency code",
      "default": true
    },
    {
      "type": "header",
      "content": "Price and rating"
    },
    {
      "type": "text",
      "id": "custom_price",
      "label": "Price",
      "info": "For cards without a product, e.g. 339. A chosen product always shows its real price."
    },
    {
      "type": "range",
      "id": "custom_rating",
      "label": "Star rating",
      "info": "Used when there's no product, or the product has no rating from a reviews app. 0 hides the stars.",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "default": 0
    },
    {
      "type": "number",
      "id": "custom_rating_count",
      "label": "Number of reviews",
      "info": "Shown in brackets after the rating."
    },
    {
      "type": "header",
      "content": "Specs and filtering"
    },
    {
      "type": "text",
      "id": "specs",
      "label": "Specs",
      "info": "Separate with commas, e.g. 4U (83g), Head-Heavy, Stiff"
    },
    {
      "type": "text",
      "id": "filter_keys",
      "label": "Filter categories",
      "info": "Separate with commas, e.g. Head-Heavy, Speed. The product's tags also count."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "Configure String & Tension"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link",
      "info": "Leave empty to link to the product page. On cards without a product, the image and title link here too."
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Badge size",
