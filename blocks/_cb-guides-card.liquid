{%- liquid
  assign guide_article = block.settings.article

  # Once an article is chosen its own title and excerpt show, unless "Use custom title and summary" is on.
  # The custom ones also preview the card before an article is chosen.
  assign use_custom_text = block.settings.use_custom_text
  if guide_article == blank
    assign use_custom_text = true
  endif

  assign card_title = guide_article.title
  assign summary = ''
  if use_custom_text
    assign card_title = block.settings.card_title | default: guide_article.title
    assign summary = block.settings.summary
  endif
  if summary == blank and guide_article != blank
    assign summary = guide_article.excerpt | default: guide_article.content | strip_html | truncatewords: 30
  endif
  assign card_title = card_title | default: 'Guide title'

  assign url = block.settings.link | default: guide_article.url
  assign tag = 'div'
  if url != blank
    assign tag = 'a'
  endif
-%}

<{{ tag }}
  {% if url != blank %}
    href="{{ url }}"
  {% endif %}
  class="cb-guide-card"
  style="
    --cb-guides-card-label-size: {{ block.settings.label_size }}px;
    --cb-guides-card-label-weight: {{ block.settings.label_weight }};
    --cb-guides-card-title-size: {{ block.settings.title_size }}px;
    --cb-guides-card-title-weight: {{ block.settings.title_weight }};
    --cb-guides-card-summary-size: {{ block.settings.summary_size }}px;
    --cb-guides-card-summary-weight: {{ block.settings.summary_weight }};
    --cb-guides-card-point-size: {{ block.settings.point_size }}px;
    --cb-guides-card-point-weight: {{ block.settings.point_weight }};
    --cb-guides-card-link-size: {{ block.settings.link_size }}px;
    --cb-guides-card-link-weight: {{ block.settings.link_weight }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.label != blank -%}
    <p class="cb-guide-card__label">
      {%- if block.settings.custom_icon != blank -%}
        {%- render 'cb-icon-upload', image: block.settings.custom_icon, size: 14, tint: block.settings.custom_icon_tint -%}
      {%- elsif block.settings.icon != 'none' -%}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'player' -%}
              <circle cx="12" cy="6" r="2.5"/><path d="M6.5 21v-2a5.5 5.5 0 0 1 11 0v2"/>
            {%- when 'racket' -%}
              <ellipse cx="9" cy="9" rx="5" ry="6.2" transform="rotate(-45 9 9)"/><path d="m12.6 12.6 7.4 7.4"/>
            {%- when 'strings' -%}
              <ellipse cx="12" cy="9.5" rx="6" ry="7.5"/><path d="M12 17v5M9.5 2.5v14M14.5 2.5v14M6 7.5h12M6 11.5h12"/>
            {%- when 'shoe' -%}
              <path d="M3 18h17a1 1 0 0 0 .4-1.9L15 13.5 13 9h-3l-1 2-3-1-3 1z"/><path d="M3 21h18"/>
            {%- when 'shield' -%}
              <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.1 7.5 9.5 4.3-1.4 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/>
            {%- when 'book' -%}
              <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20"/>
            {%- when 'bulb' -%}
              <path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/>
            {%- when 'info' -%}
              <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
            {%- when 'athlete' -%}
              <circle cx="14.5" cy="4" r="2"/><path d="m12.5 7.5-2 6 3.5 3-1 4.5"/><path d="m10.5 13.5-3 7"/><path d="m7.5 10 5-2.5 3.5 2.5 2.5-3"/>
            {%- when 'bag' -%}
              <rect x="5" y="7" width="14" height="14" rx="2.5"/><path d="M9 7V4.5h6V7"/><path d="M9 13h6v2"/>
            {%- when 'wrench' -%}
              <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>
            {%- when 'ruler' -%}
              <path fill="currentColor" fill-rule="evenodd" stroke="none" d="M4 18a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2zm0-2h16V8h-3v4h-2V8h-2v4h-2V8H9v4H7V8H4z"/>
            {%- when 'runner' -%}
              <path fill="currentColor" stroke="none" d="M13.49 5.48c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm-3.6 13.9 1-4.4 2.1 2v6h2v-7.5l-2.1-2 .6-3c1.3 1.5 3.3 2.5 5.5 2.5v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1l-5.2 2.2v4.7h2v-3.4l1.8-.7-1.6 8.1-4.9-1-.4 2 7 1.4z"/>
            {%- when 'lunge' -%}
              <path fill="currentColor" stroke="none" d="M4 6c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zM1 9h6l7-5 1.31 1.52-4.17 2.98H14L21.8 4 23 5.4 14.5 12 14 22h-2l-.5-10L8 11H1V9z"/>
          {%- endcase -%}
        </svg>
      {%- endif -%}
      {{- block.settings.label | escape -}}
    </p>
  {%- endif -%}

  <h3 class="cb-guide-card__title">{{ card_title | escape }}</h3>

  {%- if summary != blank -%}
    {%- comment -%}
      An empty line in the summary starts a new paragraph (with a one-line gap). Single line breaks flow on as
      before, so text pasted with hard wraps keeps reading as one paragraph.
    {%- endcomment -%}
    {%- assign paragraphs = summary | escape | newline_to_br | strip_newlines | split: '<br /><br />' -%}
    <div class="cb-guide-card__summary">
      {%- for paragraph in paragraphs -%}
        {%- assign line = paragraph | replace: '<br />', ' ' | strip -%}
        {%- if line != blank -%}
          <p>{{ line }}</p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if block.settings.point_text != blank -%}
    {%- liquid
      assign has_point_icon = false
      if block.settings.point_custom_icon != blank or block.settings.point_icon != 'none'
        assign has_point_icon = true
      endif
    -%}
    <p class="cb-guide-card__point{% if has_point_icon %} cb-guide-card__point--icon{% endif %}">
      {%- if block.settings.point_custom_icon != blank -%}
        {%- render 'cb-icon-upload', image: block.settings.point_custom_icon, size: 14, tint: block.settings.point_custom_icon_tint -%}
      {%- elsif block.settings.point_icon != 'none' -%}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          {%- case block.settings.point_icon -%}
            {%- when 'racket' -%}
              <path d="M19.52 2.49C17.18.15 12.9.62 9.97 3.55c-1.6 1.6-2.52 3.87-2.54 5.46-.02 1.58.26 3.89-1.35 5.5l-4.24 4.24 1.42 1.42 4.24-4.24c1.61-1.61 3.92-1.33 5.5-1.35s3.86-.94 5.46-2.54c2.92-2.93 3.4-7.21 1.06-9.55zm-9.2 9.19c-1.53-1.53-1.05-4.61 1.06-6.72s5.18-2.59 6.72-1.06c1.53 1.53 1.05 4.61-1.06 6.72s-5.18 2.59-6.72 1.06zM18 17c.53 0 1.04.21 1.41.59.78.78.78 2.05 0 2.83-.37.37-.88.58-1.41.58s-1.04-.21-1.41-.59c-.78-.78-.78-2.05 0-2.83.37-.37.88-.58 1.41-.58m0-2c-1.06 0-2.08.42-2.83 1.17-1.56 1.56-1.56 4.09 0 5.66.75.75 1.77 1.17 2.83 1.17s2.08-.42 2.83-1.17c1.56-1.56 1.56-4.09 0-5.66-.75-.75-1.77-1.17-2.83-1.17z"/>
            {%- when 'compress' -%}
              <path d="M8 19h3v3h2v-3h3l-4-4-4 4zm8-15h-3V1h-2v3H8l4 4 4-4zM4 9v2h16V9H4z"/><path d="M4 12h16v2H4z"/>
            {%- when 'store' -%}
              <path d="M20 4H4v2h16V4zm1 10v-2l-1-5H4l-1 5v2h1v6h10v-6h4v6h2v-6h1zm-9 4H6v-4h6v4z"/>
          {%- endcase -%}
        </svg>
      {%- endif -%}
      {{- block.settings.point_text | escape -}}
    </p>
  {%- endif -%}

  {%- if block.settings.link_label != blank -%}
    <span class="cb-guide-card__cta">
      {{- block.settings.link_label | escape -}}
      <svg class="cb-guide-card__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  {%- endif -%}
</{{ tag }}>

{% stylesheet %}
  .cb-guide-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    min-width: 0;
    padding: 20px;
    background: var(--cbg-card);
    border: 1px solid var(--cbg-border);
    border-radius: var(--cbg-radius);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  a.cb-guide-card:hover {
    border-color: var(--cbg-border-hover);
  }

  a.cb-guide-card:focus-visible {
    outline: 2px solid var(--cbg-text);
    outline-offset: 3px;
  }

  .cb-guide-card__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 4px;
    font-family: var(--cbg-font-body);
    font-weight: var(--cb-guides-card-label-weight, var(--cbg-font-body-strong));
    font-size: var(--cb-guides-card-label-size, 10px);
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cbg-accent);
  }

  .cb-guide-card__label svg {
    flex: none;
  }

  .cb-guide-card__title {
    margin: 0;
    font-family: var(--cbg-font-heading);
    font-weight: var(--cb-guides-card-title-weight, var(--cbg-font-heading-weight));
    font-size: var(--cb-guides-card-title-size, 17px);
    line-height: 1.3;
    color: var(--cbg-text);
  }

  .cb-guide-card__summary > p {
    margin: 0;
  }

  /* One empty line between paragraphs (1.6em = the line height, for browsers without the lh unit). */
  .cb-guide-card__summary > p + p {
    margin-top: 1.6em;
    margin-top: 1lh;
  }

  .cb-guide-card__summary {
    margin: 0;
    font-family: var(--cbg-font-body);
    font-weight: var(--cb-guides-card-summary-weight, var(--cbg-font-body-weight));
    font-size: var(--cb-guides-card-summary-size, 13px);
    line-height: 1.6;
    color: var(--cbg-muted);
  }

  /* Key point under a divider, with an accent dot. */
  .cb-guide-card__point {
    display: flex;
    align-items: center;
    align-self: stretch;
    gap: 8px;
    margin: 4px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--cbg-border);
    font-family: var(--cbg-font-body);
    font-weight: var(--cb-guides-card-point-weight, var(--cbg-font-body-weight));
    font-size: var(--cb-guides-card-point-size, 12px);
    line-height: 1.4;
    color: var(--cbg-text);
  }

  .cb-guide-card__point::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbg-accent);
  }

  /* An icon takes the dot's place. */
  .cb-guide-card__point.cb-guide-card__point--icon::before {
    display: none;
  }

  .cb-guide-card__point svg,
  .cb-guide-card__point .cb-icon-upload {
    flex: none;
    color: var(--cbg-accent);
  }

  /* margin-top: auto keeps the links lined up along the bottom of every card. */
  .cb-guide-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--cbg-font-body);
    font-weight: var(--cb-guides-card-link-weight, var(--cbg-font-body-strong));
    font-size: var(--cb-guides-card-link-size, 12px);
    line-height: 1.3;
    color: var(--cbg-accent);
  }

  .cb-guide-card__arrow {
    transition: transform 0.2s ease;
  }

  a.cb-guide-card:hover .cb-guide-card__arrow {
    transform: translateX(3px);
  }

  @media screen and (min-width: 750px) {
    .cb-guide-card {
      padding: 22px 22px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Guide card",
  "tag": null,
  "settings": [
    {
      "type": "article",
      "id": "article",
      "label": "Article",
      "info": "The card links to this blog post and shows its title and excerpt."
    },
    {
      "type": "checkbox",
      "id": "use_custom_text",
      "label": "Use custom title and summary",
      "info": "Off: the card shows the article's own title and excerpt.",
      "default": false
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Custom title",
      "info": "Used when the box above is on, and as a preview before an article is chosen."
    },
    {
      "type": "textarea",
      "id": "summary",
      "label": "Custom summary",
      "info": "Used when the box above is on, and as a preview before an article is chosen. Leave an empty line to start a new paragraph with a gap."
    },
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "player", "label": "Player" },
        { "value": "racket", "label": "Racket" },
        { "value": "strings", "label": "Strings" },
        { "value": "shoe", "label": "Shoe" },
        { "value": "shield", "label": "Shield" },
        { "value": "book", "label": "Book" },
        { "value": "bulb", "label": "Light bulb" },
        { "value": "info", "label": "Info" },
        { "value": "athlete", "label": "Athlete" },
        { "value": "bag", "label": "Bag" },
        { "value": "wrench", "label": "Wrench" },
        { "value": "ruler", "label": "Ruler" },
        { "value": "runner", "label": "Runner" },
        { "value": "lunge", "label": "Lunge" },
        { "value": "none", "label": "None" }
      ],
      "default": "book"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Upload your own SVG (or PNG). It replaces the built-in icon above."
    },
    {
      "type": "checkbox",
      "id": "custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses this section's icon colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.custom_icon != blank }}"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Shown in capitals above the title.",
      "default": "Guide"
    },
    {
      "type": "text",
      "id": "point_text",
      "label": "Key point",
      "info": "Optional line under a divider, with an accent dot."
    },
    {
      "type": "select",
      "id": "point_icon",
      "label": "Key point icon",
      "info": "Replaces the dot.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "racket", "label": "Racket" },
        { "value": "compress", "label": "Compression" },
        { "value": "store", "label": "Shop" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "point_custom_icon",
      "label": "Custom key point icon",
      "info": "Upload your own SVG (or PNG). It replaces the key point icon above."
    },
    {
      "type": "checkbox",
      "id": "point_custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses this section's accent colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.point_custom_icon != blank }}"
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Read the guide"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave empty to link to the article."
    },
    {
      "type": "header",
