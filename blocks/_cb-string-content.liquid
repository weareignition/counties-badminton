<div class="cb-string__content" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-string__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Content",
  "tag": null,
  "blocks": [
    { "type": "_cb-string-badge" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" },
    { "type": "_cb-string-features" },
    { "type": "_cb-string-actions" }
  ],
  "presets": [
    {
      "name": "[CB] Content",
      "blocks": {
        "badge": { "type": "_cb-string-badge" },
        "heading": {
          "type": "cb-heading",
          "settings": {
            "heading_text": "Professional stringing. Seven days a week.",
            "size": 44,
            "mobile_sizing": "fluid",
            "fluid_min": 30,
            "line_height": 108,
            "letter_spacing": -2
          }
        },
        "text": {
          "type": "cb-paragraph",
          "settings": {
            "body_text": "<p>Tell customers about your stringing service.</p>",
            "line_height": 165,
            "max_width_unit": "ch",
            "max_width_ch": 62
          }
        }
      },
      "block_order": ["badge", "heading", "text"]
    }
  ]
}
{% endschema %}
