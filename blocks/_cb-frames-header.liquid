<div
  class="cb-frames__header{% if block.settings.show_divider %} cb-frames__header--divider{% endif %}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-frames__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: end;
  }

  .cb-frames__header--divider {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--cbp-border);
  }

  .cb-frames__header > .cb-frames__filters {
    margin-top: 16px;
  }

  @media screen and (min-width: 750px) {
    /* The filter bar moves to the right, bottom-aligned with the heading; the heading keeps at least 40%. */
    .cb-frames__header {
      grid-template-columns: minmax(40%, 1fr) minmax(0, max-content);
      grid-auto-flow: row dense;
      column-gap: 32px;
    }

    .cb-frames__header > * {
      grid-column: 1;
    }

    .cb-frames__header > .cb-frames__filters {
      grid-column: 2;
      grid-row: span 2;
      align-self: end;
      margin-top: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Header",
  "tag": null,
  "blocks": [
    { "type": "_cb-frames-eyebrow" },
    { "type": "_cb-frames-heading" },
    { "type": "_cb-frames-filters" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider below",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "[CB] Header",
      "blocks": {
        "eyebrow": { "type": "_cb-frames-eyebrow" },
        "heading": { "type": "_cb-frames-heading" }
      },
      "block_order": ["eyebrow", "heading"]
    }
  ]
}
{% endschema %}
