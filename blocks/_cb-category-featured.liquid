{%- liquid
  assign linked_collection = block.settings.collection
  assign image = block.settings.image | default: linked_collection.featured_image
  assign card_title = block.settings.card_title | default: linked_collection.title
  assign url = block.settings.link | default: linked_collection.url | default: routes.collections_url
  assign link_label = block.settings.link_label | replace: '[count]', linked_collection.products_count
-%}

<a
  href="{{ url }}"
  class="cb-category__card cb-category-featured"
  style="
    --cbc-image-ratio: {{ block.settings.image_ratio }};
    --cb-category-featured-badge-size: {{ block.settings.badge_size }}px;
    --cb-category-featured-badge-weight: {{ block.settings.badge_weight }};
    --cb-category-featured-image-label-size: {{ block.settings.image_label_size }}px;
    --cb-category-featured-image-label-weight: {{ block.settings.image_label_weight }};
    --cb-category-featured-title-size: {{ block.settings.title_size }}px;
    --cb-category-featured-title-weight: {{ block.settings.title_weight }};
    --cb-category-featured-description-size: {{ block.settings.description_size }}px;
    --cb-category-featured-description-weight: {{ block.settings.description_weight }};
    --cb-category-featured-link-size: {{ block.settings.link_size }}px;
    --cb-category-featured-link-weight: {{ block.settings.link_weight }};
  "
  {{ block.shopify_attributes }}
>
  <div class="cb-category-featured__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 1600
        | image_tag:
          widths: '400, 600, 800, 1000, 1200, 1600',
          sizes: '(min-width: 990px) 55vw, 100vw',
          loading: 'lazy',
          class: 'cb-category__image'
      }}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'cb-category__image cb-category__image--placeholder' }}
    {%- endif -%}

    {%- if block.settings.badge_text != blank -%}
      <span class="cb-category__badge cb-category__badge--{{ block.settings.badge_style }}">
        {{- block.settings.badge_text | escape -}}
      </span>
    {%- endif -%}

    {%- if block.settings.image_label != blank -%}
      <span class="cb-category-featured__label">{{ block.settings.image_label | escape }}</span>
    {%- endif -%}
  </div>

  <div class="cb-category-featured__body">
    {%- if card_title != blank -%}
      <div class="cb-category-featured__title-row">
        <h3 class="cb-category-featured__title">{{ card_title | escape }}</h3>
        <svg class="cb-category__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    {%- endif -%}

    {%- if block.settings.description != blank -%}
      <p class="cb-category-featured__description">
        {{- block.settings.description | escape | newline_to_br -}}
      </p>
    {%- endif -%}

    {%- if link_label != blank -%}
      <span class="cb-category__cta cb-category__cta--{{ block.settings.link_style }}">
        {{- link_label | escape -}}
        <svg class="cb-category__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    {%- endif -%}
  </div>
</a>

{% stylesheet %}
  .cb-category-featured {
    flex-direction: column;
    gap: 16px;
    padding: 14px;
  }

  /* Grows to fill the card when the card list beside it is taller. */
  .cb-category-featured__media {
    position: relative;
    flex: 1 0 auto;
    aspect-ratio: var(--cbc-image-ratio, 16 / 10);
    overflow: hidden;
    border-radius: calc(var(--cbc-radius) * 0.6);
    background: var(--cbc-surface);
  }

  .cb-category-featured .cb-category__badge {
    top: 10px;
    left: 10px;
    padding: 4px 8px;
    font-weight: var(--cb-category-featured-badge-weight, var(--cbc-font-body-strong));
    font-size: var(--cb-category-featured-badge-size, 10px);
  }

  .cb-category-featured__label {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 1;
    max-width: calc(100% - 20px);
    padding: 5px 9px;
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: 4px;
    background: rgb(0 0 0 / 0.7);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--cbc-font-body);
    font-weight: var(--cb-category-featured-image-label-weight, var(--cbc-font-body-strong));
    font-size: var(--cb-category-featured-image-label-size, 11px);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cb-category-featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 0 4px 4px;
  }

  .cb-category-featured__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    align-self: stretch;
  }

  .cb-category-featured__title-row .cb-category__arrow {
    color: var(--cbc-muted);
  }

  .cb-category-featured:hover .cb-category-featured__title-row .cb-category__arrow {
    color: var(--cbc-text);
  }

  .cb-category-featured__title {
    margin: 0;
    font-family: var(--cbc-font-heading);
    font-weight: var(--cb-category-featured-title-weight, var(--cbc-font-heading-weight));
    font-size: clamp(calc(var(--cb-category-featured-title-size, 26px) * 20 / 26), 3vw, var(--cb-category-featured-title-size, 26px));
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--cbc-text);
  }

  .cb-category-featured__description {
    margin: 0;
    max-width: 56ch;
    font-family: var(--cbc-font-body);
    font-weight: var(--cb-category-featured-description-weight, var(--cbc-font-body-weight));
    font-size: var(--cb-category-featured-description-size, 14px);
    line-height: 1.55;
    color: var(--cbc-muted);
  }

  .cb-category-featured .cb-category__cta {
    margin-top: 6px;
    font-weight: var(--cb-category-featured-link-weight, var(--cbc-font-body-strong));
    font-size: var(--cb-category-featured-link-size, 13px);
  }

  @media screen and (min-width: 750px) {
    .cb-category-featured {
      gap: 20px;
      padding: 20px;
    }
  }
{% endstylesheet %}

