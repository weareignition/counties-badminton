{%- if block.settings.eyebrow_text != blank -%}
  <p class="cb-guides__eyebrow" {{ block.shopify_attributes }}>
    {{- block.settings.eyebrow_text | escape -}}
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-guides__eyebrow {
    margin: 0 0 -4px;
    font-family: var(--cbg-font-body);
    font-weight: var(--cbg-font-body-strong);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cbg-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Eyebrow",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Text",
      "info": "Shown in capitals.",
      "default": "Technical guidance"
    }
  ],
  "presets": [{ "name": "[CB] Eyebrow" }]
}
{% endschema %}
