{%- if block.settings.note_text != blank -%}
  <p
    class="cb-advice__note"
    style="--cbn-note-space: {{ block.settings.space_above }}px; --cb-advice-note-text-size: {{ block.settings.text_size }}px; --cb-advice-note-text-weight: {{ block.settings.text_weight }};"
    {{ block.shopify_attributes }}
  >
    {{- block.settings.note_text | escape -}}
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-advice__note {
    margin: var(--cbn-note-space, 16px) 0 0;
    font-family: var(--cbn-font-body);
    font-weight: var(--cb-advice-note-text-weight, var(--cbn-font-body-weight));
    font-size: var(--cb-advice-note-text-size, 12px);
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--cbn-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Note",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "note_text",
      "label": "Text",
      "default": "41r Elliot Street, Papakura • Open 7 days"
    },
    {
      "type": "range",
      "id": "space_above",
      "label": "Extra space above",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Note" }]
}
{% endschema %}
