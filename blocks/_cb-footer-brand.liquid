<div class="cb-footer__brand" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Brand column",
  "tag": null,
  "blocks": [
    { "type": "_cb-footer-logo" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" },
    { "type": "_cb-footer-badge" }
  ],
  "presets": [
    {
      "name": "[CB] Brand column",
      "blocks": {
        "logo": { "type": "_cb-footer-logo" },
        "text": {
          "type": "cb-paragraph",
          "settings": {
            "body_text": "<p>Tell customers about your store.</p>",
            "color": "soft",
            "max_width_unit": "ch",
            "max_width_ch": 46
          }
        }
      },
      "block_order": ["logo", "text"]
    }
  ]
}
{% endschema %}
