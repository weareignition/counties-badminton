{%- if block.settings.eyebrow_text != blank -%}
  <p class="cb-tactics__eyebrow" {{ block.shopify_attributes }}>
    {%- if block.settings.show_dot -%}
      <span class="cb-tactics__eyebrow-dot" aria-hidden="true"></span>
    {%- endif -%}
    {{- block.settings.eyebrow_text | escape -}}
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-tactics__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--cbt-font-body);
    font-weight: var(--cbt-font-body-strong);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cbt-soft);
  }

  .cb-tactics__eyebrow-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbt-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Eyebrow",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Text",
      "info": "Shown in capitals.",
      "default": "Choose by playing tactics"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show accent dot",
      "default": true
    }
  ],
  "presets": [{ "name": "[CB] Eyebrow" }]
}
{% endschema %}
