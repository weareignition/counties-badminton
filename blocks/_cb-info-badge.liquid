{%- if block.settings.badge_text != blank -%}
  <p
    class="cb-info__badge cb-info__badge--{{ block.settings.style }}"
    style="--cb-info-badge-text-size: {{ block.settings.text_size }}px; --cb-info-badge-text-weight: {{ block.settings.text_weight }};"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.show_dot -%}
      <span class="cb-info__badge-dot" aria-hidden="true"></span>
    {%- endif -%}
    {{- block.settings.badge_text | escape -}}
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-info__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    margin: 0;
    padding: 6px 12px;
    border: 1px solid var(--cbi-border);
    border-radius: 999px;
    font-family: var(--cbi-font-body);
    font-weight: var(--cb-info-badge-text-weight, var(--cbi-font-body-strong));
    font-size: var(--cb-info-badge-text-size, 11px);
    line-height: 1.3;
  }

  .cb-info__badge--dark {
    background: var(--cbi-card);
    color: var(--cbi-text);
  }

  .cb-info__badge--accent {
    border-color: color-mix(in srgb, var(--cbi-accent) 45%, transparent);
    background: color-mix(in srgb, var(--cbi-accent) 14%, transparent);
    color: color-mix(in srgb, var(--cbi-accent) 55%, #fff);
  }

  .cb-info__badge-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbi-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Text",
      "default": "Badge"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent tint" }
      ],
      "default": "dark"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show accent dot",
      "default": false
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Badge" }]
}
{% endschema %}
