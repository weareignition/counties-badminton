{%- liquid
  assign s = block.settings
  assign variant = product.selected_or_first_available_variant

  assign brand = ''
  if s.note_text contains '[brand]'
    capture brand
      render 'cb-product-brand', product: product, brands: section.settings.brand_names
    endcapture
    assign brand = brand | strip
  endif
  assign note = s.note_text | replace: '[brand]', brand | replace: '  ', ' ' | strip
-%}

{%- assign boxed = false -%}
{%- if s.style == 'box' -%}{%- assign boxed = true -%}{%- endif -%}
<div
  class="cb-pd-price{% if boxed %} cb-pd-price--box{% endif %}{% if s.stock_style == 'dot' %} cb-pd-price--dot{% endif %}"
  style="--cbpd-price-size: {{ s.price_size }}px; --cbpd-price-weight: {{ s.price_weight }}; --cb-pd-price-compare-size: {{ s.compare_size }}px; --cb-pd-price-compare-weight: {{ s.compare_weight }}; --cb-pd-price-stock-size: {{ s.stock_size }}px; --cb-pd-price-stock-weight: {{ s.stock_weight }}; --cb-pd-price-code-size: {{ s.code_size }}px; --cb-pd-price-code-weight: {{ s.code_weight }}; --cb-pd-price-note-size: {{ s.note_size }}px; --cb-pd-price-note-weight: {{ s.note_weight }};"
  {{ block.shopify_attributes }}
>
  <div class="cb-pd-price__row">
    <p class="cb-pd-price__amount">
      {%- if boxed -%}
        {%- comment -%} Box: the amount, then the currency code in small type. {%- endcomment -%}
        <span data-cb-pdp-price data-format="short">{{ variant.price | money }}</span>
        <span class="cb-pd-price__code">{{ cart.currency.iso_code }}</span>
        <s data-cb-pdp-compare data-format="short" {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>
          {{- variant.compare_at_price | money -}}
        </s>
      {%- else -%}
        <span data-cb-pdp-price>{{ variant.price | money_with_currency }}</span>
        <s data-cb-pdp-compare {% unless variant.compare_at_price > variant.price %}hidden{% endunless %}>
          {{- variant.compare_at_price | money_with_currency -}}
        </s>
      {%- endif -%}
    </p>
    {%- if s.show_stock -%}
      <p
        class="cb-pd-price__stock{% unless variant.available %} is-out{% endunless %}"
        data-cb-pdp-stock
        data-in="{{ s.in_stock_text | escape }}"
        data-out="{{ s.sold_out_text | escape }}"
      >
        {%- if variant.available -%}{{ s.in_stock_text | escape }}{%- else -%}{{ s.sold_out_text | escape }}{%- endif -%}
      </p>
    {%- endif -%}
  </div>
  {%- if note != blank -%}
    <p class="cb-pd-price__note">{{ note | escape }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .cb-pd-price__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .cb-pd-price .cb-pd-price__amount {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0;
    font-family: var(--cb-font-heading, var(--font-heading--family));
    font-weight: var(--cbpd-price-weight, var(--cb-font-heading-weight, 700));
    font-size: var(--cbpd-price-size, 28px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--cb-color-text, #ffffff);
  }

  .cb-pd-price__amount s {
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-pd-price-compare-weight, var(--cb-font-body-weight, 400));
    font-size: var(--cb-pd-price-compare-size, 14px);
    color: var(--cbpd-grey, #a1a1aa);
  }

  .cb-pd-price .cb-pd-price__stock {
    margin: 0;
    padding: 4px 9px;
    border-radius: 2px;
    background: var(--cbpd-card, #222222);
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-pd-price-stock-weight, 500);
    font-size: var(--cb-pd-price-stock-size, 10px);
    line-height: 1.1;
    color: #f2aaa0;
  }

  .cb-pd-price .cb-pd-price__stock.is-out {
    color: var(--cbpd-grey, #a1a1aa);
  }

  /* Box style: a dark panel with the price on the left and stock on the right. */
  .cb-pd-price--box .cb-pd-price__row {
    min-height: 55px;
    box-sizing: border-box;
    padding: 8px 15px;
    border-radius: 4px;
    background: var(--cbpd-panel, #181818);
  }

  .cb-pd-price--box .cb-pd-price__amount {
    align-items: baseline;
    gap: 7px;
  }

  .cb-pd-price .cb-pd-price__code {
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-pd-price-code-weight, var(--cb-font-body-weight, 400));
    font-size: var(--cb-pd-price-code-size, 9.5px);
    letter-spacing: 0.04em;
    color: var(--cbpd-grey, #8a8a8a);
  }

  /* Dot style stock: a green (or grey) dot and plain text. */
  .cb-pd-price.cb-pd-price--dot .cb-pd-price__stock {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border-radius: 0;
    background: none;
    font-weight: var(--cb-pd-price-stock-weight, 500);
    font-size: calc(var(--cb-pd-price-stock-size, 10px) * 11.5 / 10);
    color: var(--cb-color-text, #ffffff);
  }

  .cb-pd-price--dot .cb-pd-price__stock::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
  }

  .cb-pd-price.cb-pd-price--dot .cb-pd-price__stock.is-out {
    color: var(--cbpd-grey, #a1a1aa);
  }

  .cb-pd-price--dot .cb-pd-price__stock.is-out::before {
    background: #71717a;
  }

  .cb-pd-price .cb-pd-price__note {
    margin: 4px 0 0;
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-pd-price-note-weight, inherit);
    font-size: var(--cb-pd-price-note-size, 10px);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--cbpd-grey, #a1a1aa);
  }
{% endstylesheet %}

