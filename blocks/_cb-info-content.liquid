<div class="cb-info__content{% if block.settings.group_width > 0 %} cb-group-w{% endif %}" style="--cb-group-w: {{ block.settings.group_width }}px;" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-info__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Content",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "group_width",
      "label": "Width",
      "info": "0 follows the section.",
      "min": 0,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    { "type": "_cb-info-badges" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" },
    { "type": "_cb-info-details" },
    { "type": "_cb-info-buttons" }
  ],
  "presets": [
    {
      "name": "[CB] Content",
      "blocks": {
        "heading": {
          "type": "cb-heading",
          "settings": {
            "heading_text": "Strung by players who play and coaches who coach.",
            "size": 44,
            "mobile_sizing": "fluid",
            "fluid_min": 30,
            "line_height": 108,
            "letter_spacing": -2
          }
        },
        "text": {
          "type": "cb-paragraph",
          "settings": {
            "body_text": "<p>Tell customers about your shop.</p>",
            "line_height": 165,
            "max_width_unit": "ch",
            "max_width_ch": 64
          }
        }
      },
      "block_order": ["heading", "text"]
    }
  ]
}
{% endschema %}
