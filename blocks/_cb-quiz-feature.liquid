{%- if block.settings.feature_text != blank -%}
  <li
    class="cb-quiz__feature"
    style="--cb-quiz-feature-text-size: {{ block.settings.text_size }}px; --cb-quiz-feature-text-weight: {{ block.settings.text_weight }};"
    {{ block.shopify_attributes }}
  >
    {{- block.settings.feature_text | escape -}}
  </li>
{%- endif -%}

{% stylesheet %}
  .cb-quiz__feature {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--cbq-font-body);
    font-weight: var(--cb-quiz-feature-text-weight, var(--cbq-font-body-weight));
    font-size: var(--cb-quiz-feature-text-size, 11px);
    line-height: 1.4;
    color: var(--cbq-soft);
  }

  .cb-quiz__feature::before {
    content: '';
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cbq-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Feature",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "feature_text",
      "label": "Text",
      "default": "60-Second Guided Match"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Feature" }]
}
{% endschema %}
