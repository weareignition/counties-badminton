{%- if block.settings.badge_text != blank -%}
  <p class="cb-string__badge" style="--cb-string-badge-text-size: {{ block.settings.text_size }}px; --cb-string-badge-text-weight: {{ block.settings.text_weight }};" {{ block.shopify_attributes }}>
    {%- if block.settings.show_dot -%}
      <span class="cb-string__badge-dot" aria-hidden="true"></span>
    {%- endif -%}
    {{- block.settings.badge_text | escape -}}
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-string__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    margin: 0;
    padding: 6px 12px;
    border: 1px solid var(--cbs-border);
    border-radius: 999px;
    background: var(--cbs-card);
    font-family: var(--cbs-font-body);
    font-weight: var(--cb-string-badge-text-weight, var(--cbs-font-body-strong));
    font-size: var(--cb-string-badge-text-size, 10px);
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cbs-text);
  }

  .cb-string__badge-dot {
    position: relative;
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbs-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cb-string__badge-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: cb-string-pulse 2s ease-out infinite;
    }
  }

  @keyframes cb-string-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Text",
      "info": "Shown in capitals.",
      "default": "Master stringer workshop"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show accent dot",
      "default": true
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Badge" }]
}
{% endschema %}
