<p
  class="cb-footer__copyright"
  style="--cb-footer-copyright-text-size: {{ block.settings.text_size }}px; --cb-footer-copyright-text-weight: {{ block.settings.text_weight }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.show_year %}&copy; {{ 'now' | date: '%Y' }} {% endif -%}
  {{- block.settings.copyright_text | escape -}}
</p>

{% stylesheet %}
  .cb-footer__copyright {
    margin: 0;
    font-family: var(--cbft-font-body);
    font-weight: var(--cb-footer-copyright-text-weight, var(--cbft-font-body-weight));
    font-size: var(--cb-footer-copyright-text-size, 13px);
    line-height: 1.5;
    color: var(--cbft-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Copyright",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_year",
      "label": "Show © and the current year",
      "info": "The year updates automatically.",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Text",
      "default": "All rights reserved."
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Copyright" }]
}
{% endschema %}
