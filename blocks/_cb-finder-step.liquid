<li
  class="cb-finder-step{% if block.settings.highlight %} cb-finder-step--active{% endif %}"
  style="
    --cb-finder-step-number-size: {{ block.settings.number_size }}px;
    --cb-finder-step-number-weight: {{ block.settings.number_weight }};
    --cb-finder-step-label-size: {{ block.settings.label_size }}px;
    --cb-finder-step-label-weight: {{ block.settings.label_weight }};
    --cb-finder-step-name-size: {{ block.settings.name_size }}px;
    --cb-finder-step-name-weight: {{ block.settings.name_weight }};
  "
  {{ block.shopify_attributes }}
>
  <span class="cb-finder-step__index" aria-hidden="true"></span>
  {%- if block.settings.step_label != blank -%}
    <span class="cb-finder-step__label">{{ block.settings.step_label | escape }}</span>
  {%- endif -%}
  {%- if block.settings.step_name != blank -%}
    <span class="cb-finder-step__name">{{ block.settings.step_name | escape }}</span>
  {%- endif -%}
</li>

{% stylesheet %}
  .cb-finder-step {
    counter-increment: cb-finder-step;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 16px;
    background: var(--cbf-card);
    border: 1px solid var(--cbf-border);
    border-radius: var(--cbf-radius);
  }

  .cb-finder-step__index {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    font-family: var(--cbf-font-heading);
    font-weight: var(--cb-finder-step-number-weight, var(--cbf-font-heading-regular-weight));
    font-size: var(--cb-finder-step-number-size, 20px);
    line-height: 1;
    color: var(--cbf-muted);
  }

  .cb-finder-step__index::before {
    content: counter(cb-finder-step, decimal-leading-zero);
  }

  .cb-finder-step__index::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--cbf-border);
  }

  .cb-finder-step--active .cb-finder-step__index {
    color: var(--cbf-accent);
  }

  .cb-finder-step--active .cb-finder-step__index::after {
    height: 2px;
    background: var(--cbf-accent);
  }

  .cb-finder-step__label {
    font-family: var(--cbf-font-body);
    font-weight: var(--cb-finder-step-label-weight, var(--cbf-font-body-strong));
    font-size: var(--cb-finder-step-label-size, 9px);
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cbf-muted);
  }

  .cb-finder-step__name {
    font-family: var(--cbf-font-heading);
    font-weight: var(--cb-finder-step-name-weight, var(--cbf-font-heading-weight));
    font-size: calc(var(--cb-finder-step-name-size, 15px) * 14 / 15);
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--cbf-text);
    overflow-wrap: anywhere;
  }

  @media screen and (min-width: 750px) {
    .cb-finder-step {
      padding: 18px 16px 20px;
    }

    .cb-finder-step__name {
      font-size: var(--cb-finder-step-name-size, 15px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Step",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Steps are numbered automatically (01, 02…) in the order they appear."
    },
    {
      "type": "text",
      "id": "step_label",
      "label": "Label",
      "info": "Shown in small capitals above the name.",
      "default": "Step one"
    },
    {
      "type": "text",
      "id": "step_name",
      "label": "Name",
      "default": "Step name"
    },
    {
      "type": "checkbox",
      "id": "highlight",
      "label": "Highlight in accent color",
      "default": false
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "number_size",
      "label": "Number size",
      "min": 10,
      "max": 56,
      "step": 0.5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "select",
      "id": "number_weight",
      "label": "Number weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 9
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Name size",
      "info": "Scaled down on phones.",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "name_weight",
      "label": "Name weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Step" }]
}
{% endschema %}
