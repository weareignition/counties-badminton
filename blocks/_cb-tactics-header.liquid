<div class="cb-tactics__header" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-tactics__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Header",
  "tag": null,
  "blocks": [
    { "type": "cb-subheader" },
    { "type": "_cb-tactics-note" }
  ],
  "presets": [
    {
      "name": "[CB] Header",
      "blocks": {
        "eyebrow": {
          "type": "cb-subheader",
          "settings": {
            "subheader_text": "Choose by playing tactics",
            "show_dot": true,
            "size": 11,
            "color": "soft",
            "letter_spacing": 12
          }
        },
        "note": { "type": "_cb-tactics-note" }
      },
      "block_order": ["eyebrow", "note"]
    }
  ]
}
{% endschema %}
