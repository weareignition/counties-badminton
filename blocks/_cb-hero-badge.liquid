{%- if block.settings.badge_text != blank -%}
  <p
    class="cb-hero__badge"
    style="--cb-hero-badge-text-size: {{ block.settings.text_size }}px; --cb-hero-badge-text-weight: {{ block.settings.text_weight }};"
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.show_dot -%}
      <span class="cb-hero__badge-dot" aria-hidden="true"></span>
    {%- endif -%}
    <span class="cb-hero__badge-main">{{ block.settings.badge_text | escape }}</span>
    {%- if block.settings.badge_secondary != blank -%}
      <span class="cb-hero__badge-sep" aria-hidden="true">•</span>
      <span class="cb-hero__badge-secondary">{{ block.settings.badge_secondary | escape }}</span>
    {%- endif -%}
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 12px;
    border: 1px solid var(--cbh-border);
    border-radius: 999px;
    background: var(--cbh-surface);
    font-family: var(--cbh-font-body);
    font-size: var(--cb-hero-badge-text-size, 12px);
    font-weight: var(--cb-hero-badge-text-weight, var(--cbh-font-body-strong));
    line-height: 1.3;
    color: var(--cbh-text);
    max-width: 100%;
  }

  .cb-hero__badge-sep,
  .cb-hero__badge-secondary {
    color: var(--cbh-muted);
  }

  .cb-hero__badge-dot {
    position: relative;
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbh-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cb-hero__badge-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: cb-hero-pulse 2s ease-out infinite;
    }
  }

  @keyframes cb-hero-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Text",
      "default": "Official Store"
    },
    {
      "type": "text",
      "id": "badge_secondary",
      "label": "Second part",
      "info": "Optional. Shown after a dot in a muted colour, e.g. Papakura HQ."
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show accent dot",
      "default": true
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Badge" }]
}
{% endschema %}
