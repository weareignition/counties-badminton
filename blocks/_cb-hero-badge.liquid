{%- if block.settings.badge_text != blank -%}
  <p class="cb-hero__badge" {{ block.shopify_attributes }}>
    {%- if block.settings.show_dot -%}
      <span class="cb-hero__badge-dot" aria-hidden="true"></span>
    {%- endif -%}
    <span class="cb-hero__badge-main">{{ block.settings.badge_text | escape }}</span>
    {%- if block.settings.badge_secondary != blank -%}
      <span class="cb-hero__badge-sep" aria-hidden="true">•</span>
      <span class="cb-hero__badge-secondary">{{ block.settings.badge_secondary | escape }}</span>
    {%- endif -%}
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 12px;
    border: 1px solid var(--cbh-border);
    border-radius: 999px;
    background: var(--cbh-surface);
    font-family: var(--cbh-font-body);
    font-size: 12px;
    font-weight: var(--cbh-font-body-strong);
    line-height: 1.3;
    color: var(--cbh-text);
    max-width: 100%;
  }

  .cb-hero__badge-sep,
  .cb-hero__badge-secondary {
    color: var(--cbh-muted);
  }

  .cb-hero__badge-dot {
    position: relative;
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbh-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cb-hero__badge-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: cb-hero-pulse 2s ease-out infinite;
    }
  }

  @keyframes cb-hero-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Text",
      "default": "Official Store"
    },
    {
      "type": "text",
      "id": "badge_secondary",
      "label": "Second part",
      "info": "Optional. Shown after a dot in a muted colour, e.g. Papakura HQ."
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show accent dot",
      "default": true
    }
  ],
  "presets": [{ "name": "[CB] Badge" }]
}
{% endschema %}
