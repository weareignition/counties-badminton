<div
  class="cb-lab__boxes"
  style="--cbl-box-columns: {{ block.settings.columns }};"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-lab__boxes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    width: 100%;
  }

  @media screen and (min-width: 600px) {
    .cb-lab__boxes {
      grid-template-columns: repeat(var(--cbl-box-columns, 2), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Info boxes",
  "tag": null,
  "blocks": [{ "type": "_cb-lab-box" }],
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "Boxes per row",
      "info": "Phones show 1 per row.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "[CB] Info boxes",
      "blocks": {
        "box_1": { "type": "_cb-lab-box" },
        "box_2": {
          "type": "_cb-lab-box",
          "settings": {
            "box_title": "Exact tension calibration",
            "box_text": "Calibrated down to 0.5 lbs increments from 20 to 32 lbs tension with pre-stretch options."
          }
        }
      },
      "block_order": ["box_1", "box_2"]
    }
  ]
}
{% endschema %}
