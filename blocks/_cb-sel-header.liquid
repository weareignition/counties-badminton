<div
  class="cb-sel__header cb-sel__header--{{ block.settings.alignment }}"
  style="--cbx-header-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-sel__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cbx-header-gap, 6px);
    min-width: 0;
  }

  .cb-sel__header--center {
    align-items: center;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Header",
  "tag": null,
  "blocks": [
    { "type": "cb-subheader" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between lines",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "[CB] Header",
      "blocks": {
        "eyebrow": { "type": "cb-subheader", "settings": { "subheader_text": "Quick selector" } },
        "heading": {
          "type": "cb-heading",
          "settings": { "heading_text": "Choose your shuttle", "size": 26, "mobile_scale": 85, "wrap": "wrap" }
        },
        "text": {
          "type": "cb-paragraph",
          "settings": {
            "body_text": "<p>Start with how and where you play.</p>",
            "size": 12,
            "mobile_size": 12,
            "max_width_unit": "ch",
            "max_width_ch": 70
          }
        }
      },
      "block_order": ["eyebrow", "heading", "text"]
    }
  ]
}
{% endschema %}
