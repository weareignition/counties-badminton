<div
  class="cb-hero__buttons{% if block.settings.stack_mobile %} cb-hero__buttons--stack{% endif %}"
  style="--cbh-buttons-space: {{ block.settings.space_above }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--cbh-buttons-space, 0px);
  }

  @media screen and (max-width: 559px) {
    .cb-hero__buttons--stack {
      flex-direction: column;
      align-self: stretch;
    }

    .cb-hero__buttons--stack > .cb-hero__button {
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Button group",
  "tag": null,
  "blocks": [{ "type": "_cb-hero-button" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "stack_mobile",
      "label": "Full-width buttons on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "space_above",
      "label": "Extra space above",
      "info": "Added to the content gap.",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "[CB] Button group",
      "blocks": {
        "button_1": {
          "type": "_cb-hero-button",
          "settings": { "label": "Shop now", "style": "primary" }
        }
      },
      "block_order": ["button_1"]
    }
  ]
}
{% endschema %}
