<div
  class="cb-pguides__header cb-pguides__header--{{ block.settings.alignment }}"
  style="--cbpg-header-lines: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-pguides__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cbpg-header-lines, 12px);
    min-width: 0;
  }

  .cb-pguides__header--center {
    align-items: center;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Header",
  "tag": null,
  "blocks": [
    { "type": "cb-subheader" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between lines",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "[CB] Header",
      "blocks": {
        "eyebrow": {
          "type": "cb-subheader",
          "settings": { "subheader_text": "Guides", "size": 11, "space_below": 3 }
        },
        "heading": {
          "type": "cb-heading",
          "settings": {
            "heading_text": "Start with the questions players ask most",
            "size": 40,
            "mobile_scale": 70,
            "line_height": 120
          }
        },
        "text": {
          "type": "cb-paragraph",
          "settings": { "body_text": "<p>No jargon for the sake of it. Just useful advice, explained in plain language.</p>", "size": 15 }
        }
      },
      "block_order": ["eyebrow", "heading", "text"]
    }
  ]
}
{% endschema %}
