{%- comment -%}
  A link card for a collection. The title is "Shop" plus the collection's own name unless "Use custom title" is on;
  the custom title also previews the card before a collection is picked. A custom link overrides the collection page.
{%- endcomment -%}
{%- liquid
  assign linked = block.settings.collection
  assign card_title = block.settings.card_title
  if linked != blank and block.settings.use_custom_title == false
    assign card_title = block.settings.title_prefix | append: ' ' | append: linked.title | strip
  endif

  assign url = block.settings.link | default: linked.url
  assign tag = 'div'
  if url != blank
    assign tag = 'a'
  endif
-%}

<{{ tag }}
  {% if url != blank %}
    href="{{ url }}"
  {% endif %}
  class="cb-shoplink-card"
  style="--cb-shoplink-card-label-size: {{ block.settings.label_size }}px; --cb-shoplink-card-label-weight: {{ block.settings.label_weight }}; --cb-shoplink-card-title-size: {{ block.settings.title_size }}px; --cb-shoplink-card-title-weight: {{ block.settings.title_weight }};"
  {{ block.shopify_attributes }}
>
  <span class="cb-shoplink-card__body">
    {%- if block.settings.label != blank -%}
      <span class="cb-shoplink-card__label">{{ block.settings.label | escape }}</span>
    {%- endif -%}
    {%- if card_title != blank -%}
      <span class="cb-shoplink-card__title">{{ card_title | escape }}</span>
    {%- endif -%}
  </span>
  <svg class="cb-shoplink-card__arrow" width="16" height="14" viewBox="4 5 16 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M5 12h14M13 6l6 6-6 6"/>
  </svg>
</{{ tag }}>

{% stylesheet %}
  .cb-shoplink-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-width: 0;
    min-height: 84px;
    padding: 20px 22px;
    border-radius: var(--cbsl-radius);
    background: var(--cbsl-card);
    color: inherit;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  a.cb-shoplink-card:hover {
    background: color-mix(in srgb, var(--cbsl-text) 4%, var(--cbsl-card));
  }

  a.cb-shoplink-card:focus-visible {
    outline: 2px solid var(--cbsl-text);
    outline-offset: 2px;
  }

  .cb-shoplink-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .cb-shoplink-card__label {
    font-family: var(--cbsl-font-body);
    font-weight: var(--cb-shoplink-card-label-weight, var(--cbsl-font-body-strong));
    font-size: var(--cb-shoplink-card-label-size, 9px);
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cbsl-muted);
  }

  .cb-shoplink-card__title {
    font-family: var(--cbsl-font-heading);
    font-weight: var(--cb-shoplink-card-title-weight, var(--cbsl-font-heading-regular-weight));
    font-size: var(--cb-shoplink-card-title-size, 18px);
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--cbsl-text);
  }

  .cb-shoplink-card__arrow {
    flex: none;
    color: var(--cbsl-accent);
    transition: transform 0.2s ease;
  }

  a.cb-shoplink-card:hover .cb-shoplink-card__arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-shoplink-card,
    .cb-shoplink-card__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Link card",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Small text above the title, shown in capitals.",
      "default": "Equipment"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "The card links to it, and the title becomes the start text plus its name."
    },
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Title start",
      "info": "Shown before the collection's name.",
      "default": "Shop"
    },
    {
      "type": "checkbox",
      "id": "use_custom_title",
      "label": "Use custom title",
      "info": "Off: the title comes from the collection.",
      "default": false
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Custom title",
      "info": "Used when the box above is on, and as a preview before a collection is chosen.",
      "default": "Shop rackets"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Custom link",
      "info": "Leave empty to open the collection."
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 9
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 10,
      "max": 56,
      "step": 0.5,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Link card" }]
}
{% endschema %}
