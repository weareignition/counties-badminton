{%- comment -%}
  One row of the [CB] Racket specs table: a label and a value. By default the value comes from the product (its
  custom.racket_* metafield, else detected from the title and description); the text setting is used when nothing is
  found, or always with "Text below". The text setting can also be connected to any metafield in the editor.
  "A product metafield" reads any metafield by its namespace.key (e.g. custom.upper_construction).
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign value = ''
  if s.source == 'product' and product != blank
    case s.trait
      when 'brand'
        assign brand_list = section.settings.brand_names | default: 'Yonex, Victor, Li-Ning, Li Ning, Babolat, Ashaway, Hundred, Code Alpha, Kiwi, Apacs, Felet, RSL, Carlton'
        capture value
          render 'cb-product-brand', product: product, brands: brand_list
        endcapture
      when 'collection'
        assign value = collection.title | default: product.collections.first.title
      when 'type'
        assign value = product.type
      when 'sku'
        assign value = product.selected_or_first_available_variant.sku
      else
        capture value
          render 'cb-racket-trait', product: product, trait: s.trait
        endcapture
    endcase
    assign value = value | strip
    if value != blank and s.format != blank and s.format contains '[value]'
      assign value = s.format | replace: '[value]', value
    endif
  endif
  if s.source == 'metafield' and product != blank and s.metafield contains '.'
    assign mf_namespace = s.metafield | split: '.' | first | strip
    assign mf_key = s.metafield | split: '.' | last | strip
    assign value = product.metafields[mf_namespace][mf_key].value | strip
    if value != blank and s.format != blank and s.format contains '[value]'
      assign value = s.format | replace: '[value]', value
    endif
  endif
  if value == blank
    assign value = s.value_text
  endif
-%}

{%- if value != blank -%}
  <div class="cb-spec{% if s.highlight %} cb-spec--highlight{% endif %}" {{ block.shopify_attributes }}>
    <span class="cb-spec__label">{{ s.label | escape }}</span>
    <span class="cb-spec__value">
      {%- if s.show_dot -%}<span class="cb-spec__dot" aria-hidden="true"></span>{%- endif -%}
      {{- value | escape -}}
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .cb-spec {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px 16px;
    min-height: var(--cbsp-row-height, 41px);
    box-sizing: border-box;
    padding: 6px var(--cbsp-row-padding, 16px);
    break-inside: avoid;
    background: var(--cbsp-row, #181818);
  }

  .cb-spec__label {
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cbsp-label-weight, var(--cb-font-body-weight, 400));
    font-size: var(--cbsp-label-size, 13px);
    line-height: 1.3;
    color: var(--cbsp-label, #a1a1aa);
  }

  .cb-spec__value {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--cbsp-value-family, var(--cb-font-heading, var(--font-heading--family)));
    font-weight: var(--cbsp-value-weight, 700);
    font-size: var(--cbsp-value-size, 11px);
    line-height: 1.3;
    text-align: right;
    color: var(--cb-color-text, #ffffff);
  }

  .cb-spec--highlight .cb-spec__value {
    color: var(--cbsp-highlight, #f2aaa0);
  }

  .cb-spec__dot {
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cb-color-accent, #d71f27);
  }

  .cb-spec--empty .cb-spec__value {
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: min(var(--cbsp-value-weight, 1000), 400);
    color: rgb(255 255 255 / 0.5);
  }

  /* Phones: label above value. */
  @media screen and (max-width: 749px) {
    .cb-spec {
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      padding-block: 9px;
    }

    .cb-spec__value {
      text-align: left;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Spec row",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Playing style"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Value",
      "options": [
        { "value": "product", "label": "From the product" },
        { "value": "metafield", "label": "A product metafield" },
        { "value": "text", "label": "Text below" }
      ],
      "default": "product"
    },
    {
      "type": "select",
      "id": "trait",
      "label": "Product detail",
      "info": "Racket details come from the custom.racket_<detail> metafield (e.g. custom.racket_flex), else the title and description.",
      "options": [
        { "value": "style", "label": "Playing style" },
        { "value": "level", "label": "Player level" },
        { "value": "weight", "label": "Weight" },
        { "value": "grip", "label": "Grip size" },
        { "value": "balance", "label": "Balance" },
        { "value": "flex", "label": "Flex" },
        { "value": "tension", "label": "String tension" },
        { "value": "brand", "label": "Brand" },
        { "value": "collection", "label": "Collection" },
        { "value": "type", "label": "Product type" },
        { "value": "sku", "label": "SKU" }
      ],
      "default": "style",
      "visible_if": "{{ block.settings.source == 'product' }}"
    },
    {
      "type": "text",
      "id": "metafield",
      "label": "Metafield",
      "info": "namespace.key, e.g. custom.upper_construction",
      "visible_if": "{{ block.settings.source == 'metafield' }}"
    },
    {
      "type": "text",
      "id": "format",
      "label": "Format",
      "info": "[value] is the product detail, e.g. \"Ask the Pro Shop ([value])\".",
      "default": "[value]",
      "visible_if": "{{ block.settings.source != 'text' }}"
    },
    {
      "type": "text",
      "id": "value_text",
      "label": "Text",
      "info": "With \"From the product\", shown when nothing is found. Leave empty to hide the row then."
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Red dot before the value",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "highlight",
      "label": "Highlight the value",
      "info": "Uses the section's highlight colour.",
      "default": false
    }
  ],
  "presets": [{ "name": "[CB] Spec row" }]
}
{% endschema %}
