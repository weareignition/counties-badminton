{%- liquid
  assign tag = 'div'
  if block.settings.link != blank
    assign tag = 'a'
  endif
-%}

<{{ tag }}
  {% if block.settings.link != blank %}
    href="{{ block.settings.link }}"
  {% endif %}
  class="cb-info-brand"
  style="--cb-info-brand-name-size: {{ block.settings.name_size }}px; --cb-info-brand-name-weight: {{ block.settings.name_weight }}; --cb-info-brand-caption-size: {{ block.settings.caption_size }}px; --cb-info-brand-caption-weight: {{ block.settings.caption_weight }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.logo != blank -%}
    {{
      block.settings.logo
      | image_url: width: 320
      | image_tag:
        widths: '160, 240, 320',
        sizes: '160px',
        loading: 'lazy',
        alt: block.settings.brand_name,
        class: 'cb-info-brand__logo'
    }}
  {%- elsif block.settings.brand_name != blank -%}
    <span class="cb-info-brand__name">{{ block.settings.brand_name | escape }}</span>
  {%- endif -%}
  {%- if block.settings.caption != blank -%}
    <span class="cb-info-brand__caption">{{ block.settings.caption | escape }}</span>
  {%- endif -%}
</{{ tag }}>

{% stylesheet %}
  .cb-info-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 0;
    min-height: 76px;
    padding: 14px 10px;
    background: var(--cbi-tile);
    border: 1px solid var(--cbi-border);
    border-radius: calc(var(--cbi-radius) * 0.6);
    text-align: center;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  a.cb-info-brand:hover {
    border-color: var(--cbi-border-hover);
  }

  a.cb-info-brand:focus-visible {
    outline: 2px solid var(--cbi-text);
    outline-offset: 2px;
  }

  .cb-info-brand__name {
    font-family: var(--cbi-font-heading);
    font-weight: var(--cb-info-brand-name-weight, var(--cbi-font-heading-weight));
    font-size: var(--cb-info-brand-name-size, 15px);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--cbi-text);
  }

  .cb-info-brand__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: 26px;
    object-fit: contain;
  }

  .cb-info-brand__caption {
    font-family: var(--cbi-font-body);
    font-weight: var(--cb-info-brand-caption-weight, var(--cbi-font-body-weight));
    font-size: var(--cb-info-brand-caption-size, 10px);
    line-height: 1.35;
    color: var(--cbi-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Brand tile",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand",
      "info": "Shown in capitals.",
      "default": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. Shown instead of the brand name."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Brand name size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "name_weight",
      "label": "Brand name weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "caption_size",
      "label": "Caption size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "caption_weight",
      "label": "Caption weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Brand tile" }]
}
{% endschema %}
