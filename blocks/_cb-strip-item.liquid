<div
  class="cb-strip__item{% if block.settings.link != blank %} cb-strip__item--link{% endif %}"
  style="
    --cb-strip-item-title-size: {{ block.settings.title_size }}px;
    --cb-strip-item-title-weight: {{ block.settings.title_weight }};
    --cb-strip-item-text-size: {{ block.settings.text_size }}px;
    --cb-strip-item-text-weight: {{ block.settings.text_weight }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
    <span class="cb-strip__icon" aria-hidden="true">
      {%- if block.settings.custom_icon != blank -%}
        {%- render 'cb-icon-upload', image: block.settings.custom_icon, size: 18, tint: block.settings.custom_icon_tint -%}
      {%- else -%}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          {%- case block.settings.icon -%}
            {%- when 'racket' -%}
              <ellipse cx="9" cy="9" rx="5" ry="6.2" transform="rotate(-45 9 9)"/><path d="m12.6 12.6 7.4 7.4"/>
            {%- when 'people' -%}
              <circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-4-6"/>
            {%- when 'store' -%}
              <path d="M4.5 9 6 4h12l1.5 5"/><path d="M4.5 9h15v1.2a2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0z"/><path d="M6 12.5V20h12v-7.5M10 20v-4h4v4"/>
            {%- when 'heart_hand' -%}
              <path d="M11 14h2a2 2 0 1 0 0-4h-3c-.6 0-1.1.2-1.4.6L3 16"/><path d="m7 20 1.6-1.4c.3-.4.8-.6 1.4-.6h4c1.1 0 2.1-.4 2.8-1.2l4.6-4.4a2 2 0 0 0-2.75-2.91l-4.2 3.9"/><path d="m2 15 6 6"/><path d="M19.5 8.5c.7-.7 1.5-1.6 1.5-2.7A2.73 2.73 0 0 0 16 4a2.78 2.78 0 0 0-5 1.8c0 1.2.8 2 1.5 2.8L16 12z"/>
            {%- when 'help' -%}
              <circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/>
            {%- when 'chat' -%}
              <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>
            {%- when 'truck' -%}
              <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
            {%- when 'shield' -%}
              <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.1 7.5 9.5 4.3-1.4 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/>
            {%- when 'clock' -%}
              <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
            {%- when 'pin' -%}
              <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
            {%- when 'star' -%}
              <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>
          {%- endcase -%}
        </svg>
      {%- endif -%}
    </span>
  {%- endif -%}

  <div class="cb-strip__content">
    {%- if block.settings.item_title != blank -%}
      <p class="cb-strip__title">
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}">{{ block.settings.item_title | escape }}</a>
        {%- else -%}
          {{- block.settings.item_title | escape -}}
        {%- endif -%}
      </p>
    {%- endif -%}
    {%- if block.settings.item_text != blank -%}
      <p class="cb-strip__text">{{ block.settings.item_text | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cb-strip__item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .cb-strip__icon {
    display: inline-flex;
    flex: none;
    color: var(--cbw-accent);
  }

  .cb-strip__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cb-strip__title {
    margin: 0;
    font-family: var(--cbw-font-heading);
    font-weight: var(--cb-strip-item-title-weight, var(--cbw-font-heading-weight));
    font-size: var(--cb-strip-item-title-size, 11px);
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cbw-text);
  }

  .cb-strip__title a {
    color: inherit;
    text-decoration: none;
  }

  /* With a link, the whole feature is clickable. */
  .cb-strip__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .cb-strip__item--link:hover .cb-strip__title {
    color: var(--cbw-accent);
  }

  .cb-strip__item--link:has(a:focus-visible) {
    outline: 2px solid var(--cbw-text);
    outline-offset: 4px;
  }

  .cb-strip__title a:focus-visible {
    outline: none;
  }

  .cb-strip__text {
    margin: 0;
    font-family: var(--cbw-font-body);
    font-weight: var(--cb-strip-item-text-weight, var(--cbw-font-body-weight));
    font-size: var(--cb-strip-item-text-size, 12px);
    line-height: 1.6;
    color: var(--cbw-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Feature",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "racket", "label": "Racket" },
        { "value": "people", "label": "People" },
        { "value": "store", "label": "Shop front" },
        { "value": "heart_hand", "label": "Hand with heart" },
        { "value": "help", "label": "Question" },
        { "value": "chat", "label": "Chat" },
        { "value": "truck", "label": "Delivery" },
        { "value": "shield", "label": "Shield" },
        { "value": "clock", "label": "Clock" },
        { "value": "pin", "label": "Map pin" },
        { "value": "star", "label": "Star" },
        { "value": "none", "label": "None" }
      ],
      "default": "racket"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Upload your own SVG (or PNG). It replaces the built-in icon above."
    },
    {
      "type": "checkbox",
      "id": "custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses this section's icon colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.custom_icon != blank }}"
    },
    {
      "type": "text",
      "id": "item_title",
      "label": "Title",
      "info": "Shown in capitals.",
      "default": "Badminton people"
    },
    {
      "type": "textarea",
      "id": "item_text",
      "label": "Text",
      "default": "Advice from players, coaches and stringers who know the game."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. Makes the whole feature clickable."
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Feature" }]
}
{% endschema %}
