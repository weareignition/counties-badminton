{%- liquid
  assign linked_collection = block.settings.collection
  assign image = block.settings.image | default: linked_collection.featured_image
  assign card_title = block.settings.card_title | default: linked_collection.title
  assign url = block.settings.link | default: linked_collection.url | default: routes.collections_url
  assign link_label = block.settings.link_label | replace: '[count]', linked_collection.products_count
-%}

<a href="{{ url }}" class="cb-category__card cb-category-card" {{ block.shopify_attributes }}>
  <div class="cb-category-card__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 420
        | image_tag: widths: '140, 280, 420', sizes: '140px', loading: 'lazy', class: 'cb-category__image'
      }}
    {%- else -%}
      {{ 'collection-2' | placeholder_svg_tag: 'cb-category__image cb-category__image--placeholder' }}
    {%- endif -%}

    {%- if block.settings.badge_text != blank -%}
      <span class="cb-category__badge cb-category__badge--{{ block.settings.badge_style }}">
        {{- block.settings.badge_text | escape -}}
      </span>
    {%- endif -%}
  </div>

  <div class="cb-category-card__body">
    {%- if card_title != blank -%}
      <h3 class="cb-category-card__title">{{ card_title | escape }}</h3>
    {%- endif -%}

    {%- if block.settings.description != blank -%}
      <p class="cb-category-card__description">
        {{- block.settings.description | escape | newline_to_br -}}
      </p>
    {%- endif -%}

    {%- if link_label != blank -%}
      <span class="cb-category__cta cb-category__cta--{{ block.settings.link_style }}">
        {{- link_label | escape -}}
        <svg class="cb-category__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    {%- endif -%}
  </div>
</a>

{% stylesheet %}
  .cb-category-card {
    align-items: center;
    gap: 14px;
    padding: 12px;
  }

  .cb-category-card__media {
    position: relative;
    flex: none;
    width: clamp(96px, 34%, 140px);
    aspect-ratio: 8 / 7;
    overflow: hidden;
    border-radius: calc(var(--cbc-radius) * 0.5);
    background: var(--cbc-surface);
  }

  .cb-category-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
  }

  .cb-category-card__title {
    margin: 0;
    font-family: var(--cbc-font-heading);
    font-weight: var(--cbc-font-heading-weight);
    font-size: 16px;
    line-height: 1.2;
    color: var(--cbc-text);
  }

  .cb-category-card__description {
    margin: 0;
    font-family: var(--cbc-font-body);
    font-weight: var(--cbc-font-body-weight);
    font-size: 12px;
    line-height: 1.5;
    color: var(--cbc-muted);
  }

  .cb-category-card .cb-category__cta {
    margin-top: 4px;
  }

  @media screen and (min-width: 750px) {
    .cb-category-card {
      gap: 20px;
      padding: 16px;
    }

    .cb-category-card__title {
      font-size: 17px;
    }

    .cb-category-card__description {
      font-size: 13px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Category card",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave the image, title or link empty to use the collection's."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge"
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Badge style",
      "options": [
        { "value": "accent", "label": "Accent" },
        { "value": "dark", "label": "Dark" },
        { "value": "light", "label": "Light" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Title",
      "default": "Category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "info": "Use [count] to show how many products are in the collection.",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "Link color",
      "options": [
        { "value": "text", "label": "Text" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "text"
    }
  ],
  "presets": [{ "name": "[CB] Category card" }]
}
{% endschema %}
