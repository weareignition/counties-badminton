{%- liquid
  assign linked_collection = block.settings.collection
  assign image = block.settings.image | default: linked_collection.featured_image
  assign card_title = block.settings.card_title | default: linked_collection.title
  assign url = block.settings.link | default: linked_collection.url | default: routes.collections_url
  assign link_label = block.settings.link_label | replace: '[count]', linked_collection.products_count
-%}

<a
  href="{{ url }}"
  class="cb-category__card cb-category-card"
  style="
    --cb-category-card-badge-size: {{ block.settings.badge_size }}px;
    --cb-category-card-badge-weight: {{ block.settings.badge_weight }};
    --cb-category-card-title-size: {{ block.settings.title_size }}px;
    --cb-category-card-title-weight: {{ block.settings.title_weight }};
    --cb-category-card-description-size: {{ block.settings.description_size }}px;
    --cb-category-card-description-weight: {{ block.settings.description_weight }};
    --cb-category-card-link-size: {{ block.settings.link_size }}px;
    --cb-category-card-link-weight: {{ block.settings.link_weight }};
  "
  {{ block.shopify_attributes }}
>
  <div class="cb-category-card__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 420
        | image_tag: widths: '140, 280, 420', sizes: '140px', loading: 'lazy', class: 'cb-category__image'
      }}
    {%- else -%}
      {{ 'collection-2' | placeholder_svg_tag: 'cb-category__image cb-category__image--placeholder' }}
    {%- endif -%}

    {%- if block.settings.badge_text != blank -%}
      <span class="cb-category__badge cb-category__badge--{{ block.settings.badge_style }}">
        {{- block.settings.badge_text | escape -}}
      </span>
    {%- endif -%}
  </div>

  <div class="cb-category-card__body">
    {%- if card_title != blank -%}
      <h3 class="cb-category-card__title">{{ card_title | escape }}</h3>
    {%- endif -%}

    {%- if block.settings.description != blank -%}
      <p class="cb-category-card__description">
        {{- block.settings.description | escape | newline_to_br -}}
      </p>
    {%- endif -%}

    {%- if link_label != blank -%}
      <span class="cb-category__cta cb-category__cta--{{ block.settings.link_style }}">
        {{- link_label | escape -}}
        <svg class="cb-category__arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    {%- endif -%}
  </div>
</a>

{% stylesheet %}
  .cb-category-card {
    align-items: center;
    gap: 14px;
    padding: 12px;
  }

  .cb-category-card__media {
    position: relative;
    flex: none;
    width: clamp(96px, 34%, 140px);
    aspect-ratio: 8 / 7;
    overflow: hidden;
    border-radius: calc(var(--cbc-radius) * 0.5);
    background: var(--cbc-surface);
  }

  /* The badge and link are styled in the section; their sizes are set per card here. */
  .cb-category-card .cb-category__badge {
    font-weight: var(--cb-category-card-badge-weight, var(--cbc-font-body-strong));
    font-size: var(--cb-category-card-badge-size, 9px);
  }

  .cb-category-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 0;
  }

  .cb-category-card__title {
    margin: 0;
    font-family: var(--cbc-font-heading);
    font-weight: var(--cb-category-card-title-weight, var(--cbc-font-heading-weight));
    font-size: calc(var(--cb-category-card-title-size, 17px) * 16 / 17);
    line-height: 1.2;
    color: var(--cbc-text);
  }

  .cb-category-card__description {
    margin: 0;
    font-family: var(--cbc-font-body);
    font-weight: var(--cb-category-card-description-weight, var(--cbc-font-body-weight));
    font-size: calc(var(--cb-category-card-description-size, 13px) * 12 / 13);
    line-height: 1.5;
    color: var(--cbc-muted);
  }

  .cb-category-card .cb-category__cta {
    margin-top: 4px;
    font-weight: var(--cb-category-card-link-weight, var(--cbc-font-body-strong));
    font-size: var(--cb-category-card-link-size, 12px);
  }

  @media screen and (min-width: 750px) {
    .cb-category-card {
      gap: 20px;
      padding: 16px;
    }

    .cb-category-card__title {
      font-size: var(--cb-category-card-title-size, 17px);
    }

    .cb-category-card__description {
      font-size: var(--cb-category-card-description-size, 13px);
    }
  }
{% endstylesheet %}

