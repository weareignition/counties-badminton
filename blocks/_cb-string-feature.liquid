{%- if block.settings.feature_title != blank or block.settings.feature_text != blank -%}
  <li
    class="cb-string-feature{% if block.settings.custom_icon == blank and block.settings.icon == 'none' %} cb-string-feature--no-icon{% endif %}"
    style="
      --cb-string-feature-title-size: {{ block.settings.title_size }}px;
      --cb-string-feature-title-weight: {{ block.settings.title_weight }};
      --cb-string-feature-description-size: {{ block.settings.description_size }}px;
      --cb-string-feature-description-weight: {{ block.settings.description_weight }};
    "
    {{ block.shopify_attributes }}
  >
    {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
      <span class="cb-string-feature__icon" aria-hidden="true">
        {%- if block.settings.custom_icon != blank -%}
          {%- render 'cb-icon-upload', image: block.settings.custom_icon, size: 16, tint: block.settings.custom_icon_tint -%}
        {%- else -%}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            {%- case block.settings.icon -%}
              {%- when 'timer' -%}
                <circle cx="12" cy="13.5" r="7.5"/><path d="M12 10v3.5l2.5 2M9.5 2.5h5M12 2.5V6"/>
              {%- when 'gauge' -%}
                <path d="M4 17a8 8 0 1 1 16 0"/><path d="m12 17 3.5-5.5"/><circle cx="12" cy="17" r="1"/>
              {%- when 'sliders' -%}
                <path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>
              {%- when 'check' -%}
                <circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>
              {%- when 'shield' -%}
                <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.1 7.5 9.5 4.3-1.4 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/>
              {%- when 'calendar' -%}
                <rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
              {%- when 'racket' -%}
                <ellipse cx="9" cy="9" rx="5" ry="6.2" transform="rotate(-45 9 9)"/><path d="m12.6 12.6 7.4 7.4"/>
              {%- when 'star' -%}
                <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
            {%- endcase -%}
          </svg>
        {%- endif -%}
      </span>
    {%- endif -%}
    {%- if block.settings.feature_title != blank -%}
      <p class="cb-string-feature__title">{{ block.settings.feature_title | escape }}</p>
    {%- endif -%}
    {%- if block.settings.feature_text != blank -%}
      <p class="cb-string-feature__text">{{ block.settings.feature_text | escape }}</p>
    {%- endif -%}
  </li>
{%- endif -%}

{% stylesheet %}
  .cb-string-feature {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: start;
    column-gap: 14px;
    padding: 12px 0;
  }

  .cb-string-feature + .cb-string-feature {
    border-top: 1px solid var(--cbs-border);
  }

  .cb-string-feature--no-icon {
    grid-template-columns: minmax(0, 1fr);
  }

  .cb-string-feature__icon {
    display: inline-flex;
    grid-row: span 2;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--cbs-border);
    border-radius: 7px;
    background: var(--cbs-surface);
    color: var(--cbs-accent);
  }

  .cb-string-feature__title {
    margin: 0;
    font-family: var(--cbs-font-heading);
    font-weight: var(--cb-string-feature-title-weight, var(--cbs-font-heading-weight));
    font-size: var(--cb-string-feature-title-size, 14px);
    line-height: 1.3;
    color: var(--cbs-text);
  }

  .cb-string-feature__text {
    margin: 3px 0 0;
    font-family: var(--cbs-font-body);
    font-weight: var(--cb-string-feature-description-weight, var(--cbs-font-body-weight));
    font-size: var(--cb-string-feature-description-size, 13px);
    line-height: 1.5;
    color: var(--cbs-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Feature",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "timer", "label": "Timer" },
        { "value": "gauge", "label": "Gauge" },
        { "value": "sliders", "label": "Sliders" },
        { "value": "check", "label": "Check" },
        { "value": "shield", "label": "Shield" },
        { "value": "calendar", "label": "Calendar" },
        { "value": "racket", "label": "Racket" },
        { "value": "star", "label": "Star" },
        { "value": "none", "label": "None" }
      ],
      "default": "check"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Upload your own SVG (or PNG). It replaces the built-in icon above."
    },
    {
      "type": "checkbox",
      "id": "custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses this section's icon colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.custom_icon != blank }}"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "Title",
      "default": "Feature title"
    },
    {
      "type": "textarea",
      "id": "feature_text",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "description_weight",
      "label": "Description weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Feature" }]
}
{% endschema %}
