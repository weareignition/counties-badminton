{%- if block.settings.feature_text != blank -%}
  <span class="cb-pd-feature" style="--cb-pd-feature-text-size: {{ block.settings.text_size }}px; --cb-pd-feature-text-weight: {{ block.settings.text_weight }};" {{ block.shopify_attributes }}>
    {%- if block.settings.custom_icon != blank -%}
      {%- render 'cb-icon-upload', image: block.settings.custom_icon, size: 13, tint: block.settings.custom_icon_tint -%}
    {%- elsif block.settings.icon != 'none' -%}
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- case block.settings.icon -%}
          {%- when 'bag' -%}
            <path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8a3 3 0 0 1 6 0"/>
          {%- when 'clock' -%}
            <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
          {%- when 'chat' -%}
            <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1.1-4.6A8 8 0 1 1 21 12z"/>
          {%- when 'wrench' -%}
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.6 2.6-2.4-.6-.6-2.4 2.6-2.6z"/>
          {%- when 'truck' -%}
            <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>
          {%- when 'check' -%}
            <path d="M20 6 9 17l-5-5"/>
          {%- when 'pin' -%}
            <path d="M12 21s-7-6.5-7-12a7 7 0 0 1 14 0c0 5.5-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/>
          {%- when 'shield' -%}
            <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/>
          {%- when 'star' -%}
            <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3l-5.5 2.9 1-6.2L3 9.6l6.2-.9z"/>
        {%- endcase -%}
      </svg>
    {%- endif -%}
    <span>{{ block.settings.feature_text | escape }}</span>
  </span>
{%- endif -%}

{% stylesheet %}
  .cb-pd-feature {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-pd-feature-text-weight, var(--cb-font-body-weight, 400));
    font-size: var(--cb-pd-feature-text-size, 10.5px);
    line-height: 1.3;
    color: var(--cbpd-grey, #a1a1aa);
  }

  .cb-pd-feature svg,
  .cb-pd-feature .cb-icon-upload {
    flex: none;
    color: var(--cb-color-accent, #d71f27);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Product feature",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "bag", "label": "Bag" },
        { "value": "clock", "label": "Clock" },
        { "value": "chat", "label": "Chat" },
        { "value": "wrench", "label": "Wrench" },
        { "value": "truck", "label": "Truck" },
        { "value": "check", "label": "Check" },
        { "value": "pin", "label": "Map pin" },
        { "value": "shield", "label": "Shield" },
        { "value": "star", "label": "Star" },
        { "value": "none", "label": "None" }
      ],
      "default": "check"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Upload your own SVG (or PNG). It replaces the built-in icon above."
    },
    {
      "type": "checkbox",
      "id": "custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses the accent colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.custom_icon != blank }}"
    },
    {
      "type": "text",
      "id": "feature_text",
      "label": "Text",
      "default": "Click & collect Papakura"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 10.5
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Product feature" }]
}
{% endschema %}
