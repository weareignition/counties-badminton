{%- liquid
  assign guide = block.settings.article
  assign photo_product = block.settings.product

  # Once an article is chosen its own title, excerpt and image show, unless "Use custom title and summary" is on.
  # The custom text also previews the card before an article is chosen.
  assign use_custom_text = block.settings.use_custom_text
  if guide == blank
    assign use_custom_text = true
  endif

  # The custom title is formatted text (italic words show in the accent colour); an article's title is plain text.
  assign card_title = guide.title | escape
  assign summary = ''
  if use_custom_text
    if block.settings.card_title != blank
      assign card_title = block.settings.card_title
    endif
    assign summary = block.settings.summary | escape | newline_to_br
  endif
  if summary == blank and guide != blank
    assign summary = guide.excerpt | default: guide.content | strip_html | truncatewords: 30
  endif
  assign card_title = card_title | default: 'Guide title'

  # Photo: custom photo, then the article's image, then the chosen product's photo.
  assign photo = block.settings.image | default: guide.image | default: photo_product.featured_image

  # Link: custom link, then the article, then the product (until guides are written as blog posts).
  assign url = block.settings.link | default: guide.url | default: photo_product.url
-%}

<article
  class="cb-pguide"
  style="
    --cb-pguide-card-label-size: {{ block.settings.label_size }}px;
    --cb-pguide-card-label-weight: {{ block.settings.label_weight }};
    --cb-pguide-card-title-size: {{ block.settings.title_size }}px;
    --cb-pguide-card-title-weight: {{ block.settings.title_weight }};
    --cb-pguide-card-summary-size: {{ block.settings.summary_size }}px;
    --cb-pguide-card-summary-weight: {{ block.settings.summary_weight }};
    --cb-pguide-card-button-size: {{ block.settings.button_size }}px;
    --cb-pguide-card-button-weight: {{ block.settings.button_weight }};
  "
  {{ block.shopify_attributes }}
>
  {%- if section.settings.show_photos != false -%}
  <{% if url != blank %}a href="{{ url }}" tabindex="-1" aria-hidden="true"{% else %}div{% endif %} class="cb-pguide__media{% if block.settings.image == blank and guide.image == blank %} cb-pguide__media--product{% endif %}">
    {%- if photo != blank -%}
      {{
        photo
        | image_url: width: 800
        | image_tag:
          widths: '200, 300, 400, 600, 800',
          sizes: '(min-width: 750px) 400px, 90vw',
          loading: 'lazy',
          alt: ''
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'cb-pguide__placeholder' }}
    {%- endif -%}
  </{% if url != blank %}a{% else %}div{% endif %}>
  {%- endif -%}

  {%- if block.settings.label != blank -%}
    <p class="cb-pguide__label">{{ block.settings.label | escape }}</p>
  {%- endif -%}

  <h3 class="cb-pguide__title">{{ card_title }}</h3>

  {%- if summary != blank -%}
    <p class="cb-pguide__text">{{ summary }}</p>
  {%- endif -%}

  {%- if block.settings.button_label != blank and url != blank -%}
    <a class="cb-pguide__button" href="{{ url }}">{{ block.settings.button_label | escape }}</a>
  {%- endif -%}
</article>

{% stylesheet %}
  .cb-pguide {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: var(--cbpg-card-padding, 26px);
    border-radius: var(--cbpg-card-radius, 15px);
    background: var(--cbpg-card, #1b1b1b);
    color: var(--cbpg-text, #ffffff);
  }

  .cb-pguide__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: var(--cbpg-photo-height, 196px);
    overflow: hidden;
    border: 1px solid var(--cbpg-frame, rgb(255 255 255 / 0.08));
    border-radius: var(--cbpg-photo-radius, 8px);
    background: var(--cbpg-photo-bg, transparent);
  }

  .cb-pguide__media img {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* A product photo sits on a square white tile inside the dark frame, so transparent photos match. */
  .cb-pguide__media--product img {
    aspect-ratio: 1;
    background: #ffffff;
  }

  .cb-pguide__placeholder {
    width: 50%;
    height: 100%;
    fill: rgb(255 255 255 / 0.15);
  }

  .cb-pguide .cb-pguide__label {
    margin: 15px 0 0;
    font-family: var(--cbpg-font-body);
    font-weight: var(--cb-pguide-card-label-weight, var(--cbpg-font-body-strong));
    font-size: var(--cb-pguide-card-label-size, 10px);
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cbpg-accent, #d71f27);
  }

  .cb-pguide .cb-pguide__title {
    margin: 20px 0 0;
    font-family: var(--cbpg-title-font, var(--cbpg-font-body));
    font-weight: var(--cb-pguide-card-title-weight, var(--cbpg-title-weight, var(--cbpg-font-body-strong)));
    font-size: var(--cb-pguide-card-title-size, 21px);
    line-height: 1.25;
    letter-spacing: 0;
    color: var(--cbpg-text, #ffffff);
  }

  .cb-pguide__title em {
    font-style: normal;
    color: var(--cbpg-accent, #d71f27);
  }

  .cb-pguide .cb-pguide__text {
    margin: 14px 0 0;
    font-family: var(--cbpg-font-body);
    font-weight: var(--cb-pguide-card-summary-weight, var(--cbpg-font-body-weight));
    font-size: var(--cb-pguide-card-summary-size, 13px);
    line-height: 1.6;
    color: var(--cbpg-muted, #d0d0d4);
  }

  /* Without a photo (section setting) the label, or the title, starts the card. */
  .cb-pguide.cb-pguide > :first-child {
    margin-top: 0;
  }

  .cb-pguide__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 45px;
    margin-top: 14px;
    padding: 0 19px;
    border: 1px solid var(--cbpg-button-border, rgb(255 255 255 / 0.08));
    border-radius: var(--cbpg-button-radius, 8px);
    background: var(--cbpg-button-bg, rgb(255 255 255 / 0.02));
    font-family: var(--cbpg-font-body);
    font-weight: var(--cb-pguide-card-button-weight, var(--cbpg-font-body-strong));
    font-size: var(--cb-pguide-card-button-size, 12px);
    line-height: 1.2;
    text-decoration: none;
    color: var(--cbpg-accent, #d71f27);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .cb-pguide__button:hover {
    border-color: var(--cbpg-accent, #d71f27);
  }

  .cb-pguide__button:focus-visible {
    outline: 2px solid var(--cbpg-accent, #d71f27);
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Player guide card",
  "tag": null,
  "settings": [
    {
      "type": "article",
      "id": "article",
      "label": "Article",
      "info": "The card shows this blog post's title, excerpt and image, and links to it."
    },
    {
      "type": "checkbox",
      "id": "use_custom_text",
      "label": "Use custom title and summary",
      "info": "Off: the card shows the article's own title and excerpt.",
      "default": false
    },
    {
      "type": "inline_richtext",
      "id": "card_title",
      "label": "Custom title",
      "info": "Used when the box above is on, and as a preview before an article is chosen. Italic words show in the accent colour."
    },
    {
      "type": "textarea",
      "id": "summary",
      "label": "Custom summary",
      "info": "Used when the box above is on, and as a preview before an article is chosen."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom photo",
      "info": "Leave empty to use the article's image."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Photo from a product",
      "info": "Used when there's no custom photo and the article has no image. Until an article is chosen, the button links to this product."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Small red text above the title.",
      "default": "Player guide"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Read guide →"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link",
      "info": "Leave empty to link to the article."
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 10,
      "max": 56,
      "step": 0.5,
      "unit": "px",
      "default": 21
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "summary_size",
      "label": "Summary size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "summary_weight",
      "label": "Summary weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
