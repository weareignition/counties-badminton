<div
  class="cb-quiz__content"
  style="--cbq-content-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-quiz__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cbq-content-gap, 18px);
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Content group",
  "tag": null,
  "blocks": [
    { "type": "cb-subheader" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" },
    { "type": "_cb-quiz-button" },
    { "type": "_cb-quiz-features" }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "Space between blocks",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "[CB] Content group",
      "blocks": {
        "eyebrow": {
          "type": "cb-subheader",
          "settings": { "subheader_text": "Not sure what you need?", "show_dot": true, "letter_spacing": 12 }
        },
        "heading": {
          "type": "cb-heading",
          "settings": {
            "heading_text": "Let us find your racket.",
            "mobile_scale": 80,
            "line_height": 108,
            "uppercase": true,
            "wrap": "wrap"
          }
        },
        "text": {
          "type": "cb-paragraph",
          "settings": {
            "body_text": "<p>Tell us your level, playing tactics and string preferences. We will calculate frame weight, flex stiffness and balance point to narrow down to your top 3 calibrated matches.</p>",
            "line_height": 165,
            "max_width_unit": "ch",
            "max_width_ch": 52
          }
        },
        "button": { "type": "_cb-quiz-button" }
      },
      "block_order": ["eyebrow", "heading", "text", "button"]
    }
  ]
}
{% endschema %}
