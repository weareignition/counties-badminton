<div class="cb-lab__actions" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-lab__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 6px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Button row",
  "tag": null,
  "blocks": [
    { "type": "_cb-lab-button" },
    { "type": "_cb-lab-note" }
  ],
  "presets": [
    {
      "name": "[CB] Button row",
      "blocks": {
        "button": { "type": "_cb-lab-button" },
        "note": { "type": "_cb-lab-note" }
      },
      "block_order": ["button", "note"]
    }
  ]
}
{% endschema %}
