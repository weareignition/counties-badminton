<div
  class="cb-fintro-feature"
  style="
    --cb-fintro-feature-title-size: {{ block.settings.title_size }}px;
    --cb-fintro-feature-title-weight: {{ block.settings.title_weight }};
    --cb-fintro-feature-text-size: {{ block.settings.text_size }}px;
    --cb-fintro-feature-text-weight: {{ block.settings.text_weight }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
    <span class="cb-fintro-feature__icon" aria-hidden="true">
      {%- if block.settings.custom_icon != blank -%}
        {%- render 'cb-icon-upload', image: block.settings.custom_icon, size: 18, tint: block.settings.custom_icon_tint -%}
      {%- else -%}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {%- case block.settings.icon -%}
            {%- when 'racket' -%}
              <ellipse cx="14.5" cy="8.5" rx="4.6" ry="5.8" transform="rotate(45 14.5 8.5)"/><path d="m10.4 12.6-6.4 6.4"/><circle cx="17.8" cy="18.2" r="2.3" fill="currentColor" stroke="none"/>
            {%- when 'sliders' -%}
              <path d="M21 4h-7M10 4H3M21 12h-9M8 12H3M21 20h-5M12 20H3M14 2v4M8 10v4M16 18v4"/>
            {%- when 'badge_check' -%}
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76z"/><path d="m9 12 2 2 4-4"/>
            {%- when 'shield' -%}
              <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.1 7.5 9.5 4.3-1.4 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/>
            {%- when 'target' -%}
              <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>
            {%- when 'star' -%}
              <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.3l-5.6 2.9 1.1-6.2L3 9.6l6.2-.9z"/>
            {%- when 'store' -%}
              <path d="M4.5 9 6 4h12l1.5 5"/><path d="M4.5 9h15v1.2a2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0z"/><path d="M6 12.5V20h12v-7.5M10 20v-4h4v4"/>
            {%- when 'chat' -%}
              <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.7A8 8 0 1 1 21 12z"/>
          {%- endcase -%}
        </svg>
      {%- endif -%}
    </span>
  {%- endif -%}
  <div class="cb-fintro-feature__body">
    {%- if block.settings.feature_title != blank -%}
      <h3 class="cb-fintro-feature__title">{{ block.settings.feature_title | escape }}</h3>
    {%- endif -%}
    {%- if block.settings.feature_text != blank -%}
      <p class="cb-fintro-feature__text">{{ block.settings.feature_text | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .cb-fintro-feature {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    text-align: left;
  }

  .cb-fintro-feature__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--cbfi-button-radius, 4px);
    background: var(--cbfi-panel);
    color: var(--cbfi-accent);
  }

  .cb-fintro-feature__body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .cb-fintro-feature .cb-fintro-feature__title {
    margin: 0;
    font-family: var(--cbfi-font-heading);
    font-weight: var(--cb-fintro-feature-title-weight, var(--cbfi-font-heading-regular-weight));
    font-size: var(--cb-fintro-feature-title-size, 18px);
    line-height: 1.25;
    letter-spacing: 0;
    color: var(--cbfi-text);
  }

  .cb-fintro-feature__body > * + .cb-fintro-feature__text {
    margin-top: 3px;
  }

  .cb-fintro-feature__text {
    margin: 0;
    font-family: var(--cbfi-font-body);
    font-weight: var(--cb-fintro-feature-text-weight, var(--cbfi-font-body-weight));
    font-size: var(--cb-fintro-feature-text-size, 12px);
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--cbfi-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Feature",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "racket", "label": "Racket" },
        { "value": "sliders", "label": "Sliders" },
        { "value": "badge_check", "label": "Badge check" },
        { "value": "shield", "label": "Shield" },
        { "value": "target", "label": "Target" },
        { "value": "star", "label": "Star" },
        { "value": "store", "label": "Shop" },
        { "value": "chat", "label": "Chat" },
        { "value": "none", "label": "None" }
      ],
      "default": "racket"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Upload your own SVG (or PNG). It replaces the built-in icon above."
    },
    {
      "type": "checkbox",
      "id": "custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses this section's icon colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.custom_icon != blank }}"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "Title",
      "default": "Built around your play"
    },
    {
      "type": "textarea",
      "id": "feature_text",
      "label": "Text",
      "default": "Style-first matching prioritizing power angles, whip, and net touch."
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 10,
      "max": 56,
      "step": 0.5,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Feature" }]
}
{% endschema %}
