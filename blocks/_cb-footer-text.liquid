{%- if block.settings.body_text != blank -%}
  <div class="cb-footer__text" {{ block.shopify_attributes }}>
    {{ block.settings.body_text }}
  </div>
{%- endif -%}

{% stylesheet %}
  .cb-footer__text {
    max-width: 46ch;
    font-family: var(--cbft-font-body);
    font-weight: var(--cbft-font-body-weight);
    font-size: 14px;
    line-height: 1.6;
    color: var(--cbft-soft);
  }

  .cb-footer__text > * {
    margin: 0;
  }

  .cb-footer__text > * + * {
    margin-top: 0.75em;
  }

  .cb-footer__text a {
    color: var(--cbft-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Text",
      "default": "<p>Tell customers about your store.</p>"
    }
  ],
  "presets": [{ "name": "[CB] Text" }]
}
{% endschema %}
