<div
  class="cb-faq__header cb-faq__header--{{ block.settings.alignment }}"
  style="--cbfq-header-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-faq__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cbfq-header-gap, 8px);
    min-width: 0;
  }

  .cb-faq__header--center {
    align-items: center;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Header",
  "tag": null,
  "blocks": [
    { "type": "cb-subheader" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between lines",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "[CB] Header",
      "blocks": {
        "eyebrow": { "type": "cb-subheader", "settings": { "subheader_text": "Frequently asked", "letter_spacing": 0 } },
        "heading": { "type": "cb-heading", "settings": { "heading_text": "Stringing questions", "wrap": "wrap" } },
        "text": {
          "type": "cb-paragraph",
          "settings": {
            "body_text": "<p>Answers directly from our workshop technicians in Papakura.</p>",
            "letter_spacing": -1,
            "max_width_unit": "px"
          }
        }
      },
      "block_order": ["eyebrow", "heading", "text"]
    }
  ]
}
{% endschema %}
