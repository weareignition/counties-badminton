<div
  class="cb-info-detail"
  style="
    --cb-info-detail-label-size: {{ block.settings.label_size }}px;
    --cb-info-detail-label-weight: {{ block.settings.label_weight }};
    --cb-info-detail-value-size: {{ block.settings.value_size }}px;
    --cb-info-detail-value-weight: {{ block.settings.value_weight }};
    --cb-info-detail-note-size: {{ block.settings.note_size }}px;
    --cb-info-detail-note-weight: {{ block.settings.note_weight }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.detail_label != blank -%}
    <p class="cb-info-detail__label">{{ block.settings.detail_label | escape }}</p>
  {%- endif -%}
  {%- if block.settings.detail_value != blank -%}
    <p class="cb-info-detail__value">{{ block.settings.detail_value | escape }}</p>
  {%- endif -%}
  {%- if block.settings.detail_note != blank -%}
    <p class="cb-info-detail__note cb-info-detail__note--{{ block.settings.note_style }}">
      {{- block.settings.detail_note | escape -}}
    </p>
  {%- endif -%}
</div>

{% stylesheet %}
  .cb-info-detail {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cb-info-detail__label {
    margin: 0 0 4px;
    font-family: var(--cbi-font-body);
    font-weight: var(--cb-info-detail-label-weight, var(--cbi-font-body-strong));
    font-size: var(--cb-info-detail-label-size, 10px);
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cbi-muted);
  }

  .cb-info-detail__value {
    margin: 0;
    font-family: var(--cbi-font-heading);
    font-weight: var(--cb-info-detail-value-weight, var(--cbi-font-heading-weight));
    font-size: var(--cb-info-detail-value-size, 15px);
    line-height: 1.3;
    color: var(--cbi-text);
  }

  .cb-info-detail__note {
    margin: 0;
    font-family: var(--cbi-font-body);
    font-weight: var(--cb-info-detail-note-weight, var(--cbi-font-body-weight));
    font-size: var(--cb-info-detail-note-size, 12px);
    line-height: 1.45;
  }

  .cb-info-detail__note--muted {
    color: var(--cbi-muted);
  }

  .cb-info-detail__note--success {
    color: var(--cbi-success);
  }

  .cb-info-detail__note--accent {
    color: var(--cbi-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Detail",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "detail_label",
      "label": "Label",
      "info": "Shown in small capitals.",
      "default": "Opening hours"
    },
    {
      "type": "text",
      "id": "detail_value",
      "label": "Value",
      "default": "Monday – Sunday: 9:00 AM – 8:00 PM"
    },
    {
      "type": "text",
      "id": "detail_note",
      "label": "Note"
    },
    {
      "type": "select",
      "id": "note_style",
      "label": "Note color",
      "options": [
        { "value": "muted", "label": "Muted" },
        { "value": "success", "label": "Green" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "muted"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "value_size",
      "label": "Value size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "value_weight",
      "label": "Value weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "note_size",
      "label": "Note size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "note_weight",
      "label": "Note weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Detail" }]
}
{% endschema %}
