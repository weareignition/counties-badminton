{%- comment -%}
  One customer review for [CB] Reviews: stars, a quoted title, the review, the reviewer and a badge. The section's
  Design 2 leads with an initials box, the reviewer and the stars, and quotes the review itself.
  "Sample review" (on in the section's preset) shows the card only in the theme editor, so placeholder reviews never
  reach the store.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign show = true
  if s.sample and request.design_mode == false
    assign show = false
  endif
  if s.review_title == blank and s.review_text == blank
    assign show = false
  endif

  # Design 2: "Marcus K." becomes MK, and the detail and badge share a line.
  assign name_words = s.reviewer | split: ' '
  assign initials = name_words.first | slice: 0
  if name_words.size > 1
    assign last_initial = name_words.last | slice: 0
    assign initials = initials | append: last_initial
  endif
  assign initials = initials | upcase

  assign detail_line = s.reviewer_detail
  if s.reviewer_detail != blank and s.badge != blank
    assign detail_line = s.reviewer_detail | append: ' • ' | append: s.badge
  elsif s.badge != blank
    assign detail_line = s.badge
  endif
-%}

{%- if show -%}
  <article class="cb-review{% if s.sample %} cb-review--sample{% endif %}" style="--cbrv-title-size: {{ s.title_size }}px; --cbrv-title-weight: {{ s.title_weight }}; --cbrv-text-size: {{ s.text_size }}px; --cbrv-text-weight: {{ s.text_weight }}; --cb-review-reviewer-size: {{ s.reviewer_size }}px; --cb-review-reviewer-weight: {{ s.reviewer_weight }}; --cb-review-detail-size: {{ s.detail_size }}px; --cb-review-detail-weight: {{ s.detail_weight }}; --cb-review-meta-size: {{ s.meta_size }}px; --cb-review-meta-weight: {{ s.meta_weight }}; --cb-review-initials-size: {{ s.initials_size }}px; --cb-review-initials-weight: {{ s.initials_weight }};" {{ block.shopify_attributes }}>
    {%- if section.settings.design == '2' -%}
      <div class="cb-review__head">
        {%- if initials != blank -%}
          <span class="cb-review__avatar" aria-hidden="true">{{ initials | escape }}</span>
        {%- endif -%}
        <div class="cb-review__who">
          {%- if s.reviewer != blank -%}
            <p class="cb-review__name">{{ s.reviewer | escape }}</p>
          {%- endif -%}
          {%- if detail_line != blank -%}
            <p class="cb-review__detail">{{ detail_line | escape }}</p>
          {%- endif -%}
        </div>
        {%- if s.stars > 0 -%}
          {%- render 'cb-stars', rating: s.stars, size: 12 -%}
        {%- endif -%}
      </div>
      {%- if s.review_title != blank -%}
        <h3 class="cb-review__title">{{ s.review_title | escape }}</h3>
      {%- endif -%}
      {%- if s.review_text != blank -%}
        <p class="cb-review__text">
          {%- if s.quotes -%}&quot;{%- endif -%}
          {{- s.review_text | escape | newline_to_br -}}
          {%- if s.quotes -%}&quot;{%- endif -%}
        </p>
      {%- endif -%}
      {%- if s.meta_text != blank -%}
        <p class="cb-review__meta">{{ s.meta_text | escape }}</p>
      {%- endif -%}
    {%- else -%}
      {%- if s.stars > 0 -%}
        {%- render 'cb-stars', rating: s.stars, size: 10.5 -%}
      {%- endif -%}
      {%- if s.review_title != blank -%}
        <h3 class="cb-review__title">
          {%- if s.quotes -%}&rdquo;{{ s.review_title | escape }}&rdquo;{%- else -%}{{ s.review_title | escape }}{%- endif -%}
        </h3>
      {%- endif -%}
      {%- if s.review_text != blank -%}
        <p class="cb-review__text">{{ s.review_text | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if s.reviewer != blank or s.badge != blank -%}
        <footer class="cb-review__footer">
          <span class="cb-review__name">{{ s.reviewer | escape }}</span>
          {%- if s.badge != blank -%}<span class="cb-review__badge">{{ s.badge | escape }}</span>{%- endif -%}
        </footer>
      {%- endif -%}
    {%- endif -%}
  </article>
{%- endif -%}

{% stylesheet %}
  .cb-review {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--cbrv-card-padding, 16px);
    border-radius: var(--cbrv-card-radius, 2px);
    background: var(--cbrv-card, #1c1b1b);
  }

  .cb-review--sample {
    outline: 1px dashed rgb(255 255 255 / 0.25);
    outline-offset: -1px;
  }

  .cb-review .cb-review__sample {
    margin: 0 0 10px;
    font-size: 10px;
    color: rgb(255 255 255 / 0.55);
  }

  .cb-review .cb-review__title {
    margin: 6px 0 0;
    font-family: var(--cb-font-heading, var(--font-heading--family));
    font-weight: var(--cbrv-title-weight, var(--cb-font-heading-weight, 700));
    font-size: var(--cbrv-title-size, 11px);
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--cb-color-text, #ffffff);
  }

  .cb-review .cb-review__text {
    margin: 3px 0 0;
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cbrv-text-weight, inherit);
    font-size: var(--cbrv-text-size, 10.5px);
    line-height: 1.65;
    color: var(--cb-color-muted, #a1a1aa);
  }

  .cb-review > .cb-stars + .cb-review__text {
    margin-top: 10px;
  }

  .cb-review .cb-review__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    align-self: stretch;
    margin-top: auto;
    padding-top: 22px;
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-review-reviewer-weight, inherit);
    font-size: var(--cb-review-reviewer-size, 10px);
    line-height: 1.4;
  }

  .cb-review__name {
    color: var(--cb-color-muted, #a1a1aa);
  }

  .cb-review__badge {
    color: var(--cbrv-badge, #f2aaa0);
  }
{% endstylesheet %}

