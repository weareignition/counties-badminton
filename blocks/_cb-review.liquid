{%- comment -%}
  One customer review for [CB] Reviews: stars, a quoted title, the review, the reviewer and a badge.
  "Sample review" (on in the section's preset) shows the card only in the theme editor, so placeholder reviews never
  reach the store.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign show = true
  if s.sample and request.design_mode == false
    assign show = false
  endif
  if s.review_title == blank and s.review_text == blank
    assign show = false
  endif
-%}

{%- if show -%}
  <article class="cb-review{% if s.sample %} cb-review--sample{% endif %}" style="--cbrv-title-size: {{ s.title_size }}px; --cbrv-title-weight: {{ s.title_weight }}; --cbrv-text-size: {{ s.text_size }}px; --cbrv-text-weight: {{ s.text_weight }}; --cb-review-reviewer-size: {{ s.reviewer_size }}px; --cb-review-reviewer-weight: {{ s.reviewer_weight }};" {{ block.shopify_attributes }}>
    {%- if s.stars > 0 -%}
      {%- render 'cb-stars', rating: s.stars, size: 10.5 -%}
    {%- endif -%}
    {%- if s.review_title != blank -%}
      <h3 class="cb-review__title">
        {%- if s.quotes -%}&rdquo;{{ s.review_title | escape }}&rdquo;{%- else -%}{{ s.review_title | escape }}{%- endif -%}
      </h3>
    {%- endif -%}
    {%- if s.review_text != blank -%}
      <p class="cb-review__text">{{ s.review_text | escape | newline_to_br }}</p>
    {%- endif -%}
    {%- if s.reviewer != blank or s.badge != blank -%}
      <footer class="cb-review__footer">
        <span class="cb-review__name">{{ s.reviewer | escape }}</span>
        {%- if s.badge != blank -%}<span class="cb-review__badge">{{ s.badge | escape }}</span>{%- endif -%}
      </footer>
    {%- endif -%}
  </article>
{%- endif -%}

{% stylesheet %}
  .cb-review {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    box-sizing: border-box;
    padding: var(--cbrv-card-padding, 16px);
    border-radius: var(--cbrv-card-radius, 2px);
    background: var(--cbrv-card, #1c1b1b);
  }

  .cb-review--sample {
    outline: 1px dashed rgb(255 255 255 / 0.25);
    outline-offset: -1px;
  }

  .cb-review .cb-review__sample {
    margin: 0 0 10px;
    font-size: 10px;
    color: rgb(255 255 255 / 0.55);
  }

  .cb-review .cb-review__title {
    margin: 6px 0 0;
    font-family: var(--cb-font-heading, var(--font-heading--family));
    font-weight: var(--cbrv-title-weight, var(--cb-font-heading-weight, 700));
    font-size: var(--cbrv-title-size, 11px);
    line-height: 1.3;
    letter-spacing: 0;
    color: var(--cb-color-text, #ffffff);
  }

  .cb-review .cb-review__text {
    margin: 3px 0 0;
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cbrv-text-weight, inherit);
    font-size: var(--cbrv-text-size, 10.5px);
    line-height: 1.65;
    color: var(--cb-color-muted, #a1a1aa);
  }

  .cb-review > .cb-stars + .cb-review__text {
    margin-top: 10px;
  }

  .cb-review .cb-review__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    align-self: stretch;
    margin-top: auto;
    padding-top: 22px;
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-review-reviewer-weight, inherit);
    font-size: var(--cb-review-reviewer-size, 10px);
    line-height: 1.4;
  }

  .cb-review__name {
    color: var(--cb-color-muted, #a1a1aa);
  }

  .cb-review__badge {
    color: var(--cbrv-badge, #f2aaa0);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Review",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "sample",
      "label": "Sample review",
      "info": "Shown only in the theme editor. Untick it once this is a real customer review.",
      "default": false
    },
    {
      "type": "range",
      "id": "stars",
      "label": "Stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "review_title",
      "label": "Title"
    },
    {
      "type": "checkbox",
      "id": "quotes",
      "label": "Quote marks around the title",
      "default": true
    },
    {
      "type": "textarea",
      "id": "review_text",
      "label": "Review"
    },
    {
      "type": "text",
      "id": "reviewer",
      "label": "Reviewer",
      "info": "e.g. first name, last initial and club."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "info": "Only for reviews from real buyers.",
      "default": "Verified Buyer"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Review text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 10.5
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Review text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "reviewer_size",
      "label": "Reviewer and badge size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "reviewer_weight",
      "label": "Reviewer and badge weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Review" }]
}
{% endschema %}
