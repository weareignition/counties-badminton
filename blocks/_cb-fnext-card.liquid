{%- liquid
  assign url = block.settings.button_link
  assign button_tag = 'span'
  if url != blank
    assign button_tag = 'a'
  endif
-%}
<div
  class="cb-fnext-card"
  style="
    --cb-fnext-card-heading-size: {{ block.settings.heading_size }}px;
    --cb-fnext-card-heading-weight: {{ block.settings.heading_weight }};
    --cb-fnext-card-text-size: {{ block.settings.text_size }}px;
    --cb-fnext-card-text-weight: {{ block.settings.text_weight }};
    --cb-fnext-card-button-size: {{ block.settings.button_size }}px;
    --cb-fnext-card-button-weight: {{ block.settings.button_weight }};
    --cb-fnext-card-note-size: {{ block.settings.note_size }}px;
    --cb-fnext-card-note-weight: {{ block.settings.note_weight }};
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
    <span class="cb-fnext-card__icon" aria-hidden="true">
      {%- if block.settings.custom_icon != blank -%}
        {%- render 'cb-icon-upload', image: block.settings.custom_icon, size: 18, tint: block.settings.custom_icon_tint -%}
      {%- else -%}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {%- case block.settings.icon -%}
            {%- when 'store' -%}
              <path d="M4.5 9 6 4h12l1.5 5"/><path d="M4.5 9h15v1.2a2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0z"/><path d="M6 12.5V20h12v-7.5M10 20v-4h4v4"/>
            {%- when 'racket' -%}
              <ellipse cx="14.5" cy="8.5" rx="4.6" ry="5.8" transform="rotate(45 14.5 8.5)"/><path d="m10.4 12.6-6.4 6.4"/><circle cx="17.8" cy="18.2" r="2.3" fill="currentColor" stroke="none"/>
            {%- when 'wrench' -%}
              <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>
            {%- when 'chat' -%}
              <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.7A8 8 0 1 1 21 12z"/>
            {%- when 'pin' -%}
              <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
            {%- when 'calendar' -%}
              <rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
            {%- when 'target' -%}
              <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2" fill="currentColor"/>
          {%- endcase -%}
        </svg>
      {%- endif -%}
    </span>
  {%- endif -%}

  {%- if block.settings.card_heading != blank -%}
    <h3 class="cb-fnext-card__heading">{{ block.settings.card_heading | escape }}</h3>
  {%- endif -%}
  {%- if block.settings.card_text != blank -%}
    <p class="cb-fnext-card__text">{{ block.settings.card_text | escape }}</p>
  {%- endif -%}

  {%- if block.settings.button_label != blank or block.settings.note_text != blank -%}
    <div class="cb-fnext-card__actions">
      {%- if block.settings.button_label != blank -%}
        <{{ button_tag }}
          {% if url != blank %}
            href="{{ url }}"
          {% endif %}
          class="cb-fnext-card__button cb-fnext-card__button--{{ block.settings.button_style }}"
        >
          <span>{{ block.settings.button_label | escape }}</span>
          {%- if block.settings.show_arrow -%}
            <svg width="11" height="11" viewBox="4 4 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          {%- endif -%}
        </{{ button_tag }}>
      {%- endif -%}
      {%- if block.settings.note_text != blank -%}
        <span class="cb-fnext-card__note">
          {%- if block.settings.show_note_dot -%}
            <span class="cb-fnext-card__note-dot" aria-hidden="true"></span>
          {%- endif -%}
          {{- block.settings.note_text | escape -}}
        </span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .cb-fnext-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: 24px;
    border-radius: var(--cbfn-radius);
    background: var(--cbfn-card);
  }

  .cb-fnext-card__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    margin-bottom: 18px;
    border-radius: 4px;
    background: var(--cbfn-icon-box);
    color: var(--cbfn-accent);
  }

  .cb-fnext-card .cb-fnext-card__heading {
    margin: 0;
    font-family: var(--cbfn-font-heading);
    font-weight: var(--cb-fnext-card-heading-weight, var(--cbfn-font-heading-weight));
    font-size: calc(var(--cb-fnext-card-heading-size, 28px) * 24 / 28);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--cbfn-text);
  }

  .cb-fnext-card .cb-fnext-card__text {
    max-width: 480px;
    margin: 10px 0 0;
    font-family: var(--cbfn-font-body);
    font-weight: var(--cb-fnext-card-text-weight, var(--cbfn-font-body-weight));
    font-size: var(--cb-fnext-card-text-size, 12px);
    line-height: 1.6;
    color: var(--cbfn-muted);
  }

  .cb-fnext-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 14px;
    margin-top: auto;
    padding-top: 26px;
  }

  .cb-fnext-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 39px;
    padding: 0 18px;
    border-radius: 3px;
    font-family: var(--cbfn-font-heading);
    font-weight: var(--cb-fnext-card-button-weight, var(--cbfn-font-heading-medium-weight));
    font-size: var(--cb-fnext-card-button-size, 16px);
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .cb-fnext-card__button--light {
    background: var(--cbfn-light);
    color: var(--cbfn-light-text);
  }

  .cb-fnext-card__button--accent {
    background: var(--cbfn-accent);
    color: var(--cbfn-text);
  }

  .cb-fnext-card__button--dark {
    background: var(--cbfn-icon-box);
    color: var(--cbfn-text);
  }

  a.cb-fnext-card__button--light:hover {
    background: color-mix(in srgb, var(--cbfn-light) 86%, #000);
  }

  a.cb-fnext-card__button--accent:hover {
    background: color-mix(in srgb, var(--cbfn-accent) 88%, #000);
  }

  a.cb-fnext-card__button--dark:hover {
    background: color-mix(in srgb, var(--cbfn-text) 10%, var(--cbfn-icon-box));
  }

  .cb-fnext-card__button svg {
    flex: none;
    transition: transform 0.2s ease;
  }

  a.cb-fnext-card__button:hover svg {
    transform: translateX(3px);
  }

  a.cb-fnext-card__button:focus-visible {
    outline: 2px solid var(--cbfn-text);
    outline-offset: 3px;
  }

  .cb-fnext-card__note {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--cbfn-font-body);
    font-weight: var(--cb-fnext-card-note-weight, 500);
    font-size: var(--cb-fnext-card-note-size, 10px);
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cbfn-muted);
  }

  .cb-fnext-card__note-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbfn-dot);
  }

  @media screen and (min-width: 750px) {
    .cb-fnext-card {
      padding: 32px;
    }

    .cb-fnext-card .cb-fnext-card__heading {
      font-size: var(--cb-fnext-card-heading-size, 28px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-fnext-card__button,
    .cb-fnext-card__button svg {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Help card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "store", "label": "Shop" },
        { "value": "racket", "label": "Racket" },
        { "value": "wrench", "label": "Wrench" },
        { "value": "chat", "label": "Chat" },
        { "value": "pin", "label": "Location" },
        { "value": "calendar", "label": "Calendar" },
        { "value": "target", "label": "Target" },
        { "value": "none", "label": "None" }
      ],
      "default": "store"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Upload your own SVG (or PNG). It replaces the built-in icon above."
    },
    {
      "type": "checkbox",
      "id": "custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses this section's icon colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.custom_icon != blank }}"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Heading",
      "default": "Not sure between two frames?"
    },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "Text",
      "default": "Visit our Papakura Pro Shop at 41R Elliot Street to test court demo frames or speak with our coaches."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Ask the Pro Shop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "light", "label": "White" },
        { "value": "accent", "label": "Accent" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show arrow on button",
      "default": false
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Note beside the button",
      "info": "Small text in capitals. Leave empty to hide."
    },
    {
      "type": "checkbox",
      "id": "show_note_dot",
      "label": "Show status dot",
      "default": true
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "info": "Scaled down on phones.",
      "min": 10,
      "max": 56,
      "step": 0.5,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "button_size",
      "label": "Button text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Button text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "note_size",
      "label": "Note size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "note_weight",
      "label": "Note weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Help card" }]
}
{% endschema %}
