{%- comment -%}
  Add to cart (submits the section's product form; the section's script adds it with Horizon's cart events so the
  cart drawer opens) and an optional second button: a link, a jump to the [CB] Stringing builder, or "add this product too" (e.g. a stringing service),
  which adds the racket and that product together.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign variant = product.selected_or_first_available_variant
  assign addon_variant = s.addon_product.selected_or_first_available_variant
-%}

<div
  class="cb-pd-buy cb-pd-buy--{{ s.layout | default: 'stack' }}{% if s.uppercase %} cb-pd-buy--upper{% endif %}{% if s.cart_font == 'heading' %} cb-pd-buy--heading{% endif %}"
  style="--cbpd-buy-height: {{ s.button_height }}px; --cbpd-cart-size: {{ s.cart_text_size }}px; --cbpd-cart-weight: {{ s.cart_text_weight }}; --cb-pd-buy-addon-size: {{ s.addon_text_size }}px; --cb-pd-buy-addon-weight: {{ s.addon_text_weight }}; --cb-pd-buy-message-size: {{ s.message_size }}px; --cb-pd-buy-message-weight: {{ s.message_weight }};"
  {{ block.shopify_attributes }}
>
  <button
    type="submit"
    class="cb-pd-buy__button cb-pd-buy__button--cart"
    data-cb-pdp-add
    data-label="{{ s.cart_label | escape }}"
    data-sold-out="{{ s.sold_out_label | escape }}"
    data-added="{{ s.added_label | escape }}"
    {% unless variant.available %}disabled{% endunless %}
  >
    {%- if s.cart_icon != blank -%}
      {%- render 'cb-icon-upload', image: s.cart_icon, size: 14, tint: true -%}
    {%- elsif s.show_icons -%}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L21 7H6"/></svg>
    {%- endif -%}
    <span data-cb-pdp-add-text>
      {%- if variant.available -%}{{ s.cart_label | escape }}{%- else -%}{{ s.sold_out_label | escape }}{%- endif -%}
    </span>
  </button>

  {%- if s.addon_label != blank -%}
    {%- capture addon_icon -%}
      {%- if s.addon_icon != blank -%}
        {%- render 'cb-icon-upload', image: s.addon_icon, size: 14, tint: true -%}
      {%- elsif s.show_icons -%}
        {%- case s.addon_icon_type -%}
          {%- when 'store' -%}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l1.5-5h15L21 9M3 9h18M3 9v11h18V9M9 20v-6h6v6"/></svg>
          {%- when 'calendar' -%}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
          {%- when 'none' -%}
          {%- else -%}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16M8 3v18M16 3v18"/></svg>
        {%- endcase -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if s.addon_mode == 'product' and addon_variant != blank -%}
      <button
        type="button"
        class="cb-pd-buy__button cb-pd-buy__button--addon"
        data-cb-pdp-addon="{{ addon_variant.id }}"
        data-label="{{ s.addon_label | escape }}"
        data-added="{{ s.added_label | escape }}"
        {% unless variant.available and addon_variant.available %}disabled{% endunless %}
      >
        {{- addon_icon -}}
        <span>{{ s.addon_label | escape }}</span>
      </button>
    {%- elsif s.addon_mode == 'builder' -%}
      <a class="cb-pd-buy__button cb-pd-buy__button--addon" href="#stringing-builder">
        {{- addon_icon -}}
        <span>{{ s.addon_label | escape }}</span>
      </a>
    {%- elsif s.addon_mode == 'link' and s.addon_link != blank -%}
      <a class="cb-pd-buy__button cb-pd-buy__button--addon" href="{{ s.addon_link }}">
        {{- addon_icon -}}
        <span>{{ s.addon_label | escape }}</span>
      </a>
    {%- endif -%}
  {%- endif -%}

  <p class="cb-pd-buy__message" data-cb-pdp-message role="status" hidden></p>
</div>

{% stylesheet %}
  .cb-pd-buy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Two classes: Horizon styles buttons and links globally. */
  .cb-pd-buy .cb-pd-buy__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 0 16px;
    border: 0;
    border-radius: 2px;
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-pd-buy-addon-weight, var(--cb-font-body-strong, 600));
    font-size: var(--cb-pd-buy-addon-size, 11px);
    line-height: 1.2;
    text-decoration: none;
    color: #ffffff;
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .cb-pd-buy--upper .cb-pd-buy__button {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cb-pd-buy .cb-pd-buy__button--cart {
    background: var(--cb-color-accent, #d71f27);
  }

  @media screen and (max-width: 749px) {
    .cb-pd-buy--row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .cb-pd-buy .cb-pd-buy__button--cart {
    min-height: var(--cbpd-buy-height, 44px);
    font-weight: var(--cbpd-cart-weight, var(--cb-font-body-strong, 600));
    font-size: var(--cbpd-cart-size, 11px);
  }

  .cb-pd-buy--heading .cb-pd-buy__button--cart {
    font-family: var(--cb-font-heading, var(--font-heading--family));
    font-weight: var(--cbpd-cart-weight, var(--cb-font-heading-weight, 700));
    letter-spacing: 0.04em;
  }

  /* Row: add to cart takes the space, the second button sits beside it. */
  .cb-pd-buy--row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 11px;
  }

  .cb-pd-buy--row .cb-pd-buy__button {
    min-height: var(--cbpd-buy-height, 44px);
  }

  .cb-pd-buy--row .cb-pd-buy__button--addon {
    padding: 0 22px;
    font-size: calc(var(--cb-pd-buy-addon-size, 11px) * 9.5 / 11);
  }

  .cb-pd-buy--row .cb-pd-buy__message {
    grid-column: 1 / -1;
  }

  .cb-pd-buy .cb-pd-buy__button--cart:hover {
    background: color-mix(in srgb, var(--cb-color-accent, #d71f27) 88%, #000);
  }

  .cb-pd-buy .cb-pd-buy__button--addon {
    min-height: 40px;
    background: var(--cbpd-addon, #222222);
  }

  .cb-pd-buy .cb-pd-buy__button--addon:hover {
    background: color-mix(in srgb, var(--cbpd-addon, #222222) 80%, #fff);
  }

  .cb-pd-buy .cb-pd-buy__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .cb-pd-buy .cb-pd-buy__button[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }

  .cb-pd-buy .cb-pd-buy__button:focus-visible {
    outline: 2px solid var(--cb-color-text, #ffffff);
    outline-offset: 3px;
  }

  .cb-pd-buy .cb-pd-buy__message {
    margin: 0;
    font-family: var(--cb-font-body, var(--font-body--family));
    font-weight: var(--cb-pd-buy-message-weight, inherit);
    font-size: var(--cb-pd-buy-message-size, 12px);
    line-height: 1.5;
    color: #f2aaa0;
  }

  .cb-pd-buy__hint {
    margin: 0;
    font-size: 11px;
    color: rgb(255 255 255 / 0.6);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Buy buttons",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "cart_label",
      "label": "Add to cart button",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out button",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "After adding",
      "default": "Added to cart"
    },
    {
      "type": "image_picker",
      "id": "cart_icon",
      "label": "Add to cart icon",
      "info": "Optional. Upload your own SVG to replace the cart icon."
    },
    {
      "type": "header",
      "content": "Second button"
    },
    {
      "type": "text",
      "id": "addon_label",
      "label": "Label",
      "info": "Leave empty to hide the second button.",
      "default": "Add professional stringing"
    },
    {
      "type": "select",
      "id": "addon_mode",
      "label": "What it does",
      "options": [
        { "value": "link", "label": "Opens a link" },
        { "value": "product", "label": "Adds this product and another product" },
        { "value": "builder", "label": "Goes to the [CB] Stringing builder on this page" }
      ],
      "default": "link"
    },
    {
      "type": "url",
      "id": "addon_link",
      "label": "Link",
      "visible_if": "{{ block.settings.addon_mode == 'link' }}"
    },
    {
      "type": "product",
      "id": "addon_product",
      "label": "Product to add too",
      "info": "Used when 'What it does' adds another product, e.g. a stringing service."
    },
    {
      "type": "image_picker",
      "id": "addon_icon",
      "label": "Icon",
      "info": "Optional. Upload your own SVG to replace the strings icon."
    },
    {
      "type": "select",
      "id": "addon_icon_type",
      "label": "Built-in icon",
      "options": [
        { "value": "strings", "label": "Strings" },
        { "value": "store", "label": "Shop" },
        { "value": "calendar", "label": "Calendar" },
        { "value": "none", "label": "None" }
      ],
      "default": "strings"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stack", "label": "Stacked" },
        { "value": "row", "label": "Side by side" }
      ],
      "default": "stack"
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Add to cart height",
      "min": 36,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "cart_font",
      "label": "Add to cart font",
      "options": [
        { "value": "body", "label": "Body font" },
        { "value": "heading", "label": "Heading font, bold" }
      ],
      "default": "body"
    },
    {
      "type": "range",
      "id": "cart_text_size",
      "label": "Add to cart text size",
      "min": 9,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "cart_text_weight",
      "label": "Add to cart text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase labels",
      "default": true
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "addon_text_size",
      "label": "Second button text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11,
      "info": "Smaller when the buttons sit side by side."
    },
    {
      "type": "select",
      "id": "addon_text_weight",
      "label": "Second button text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "message_size",
      "label": "Error message size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "message_weight",
      "label": "Error message weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Buy buttons" }]
}
