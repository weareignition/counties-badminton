{%- if block.settings.badge_text != blank -%}
  <p class="cb-finder__badge" {{ block.shopify_attributes }}>
    {%- if block.settings.show_dot -%}
      <span class="cb-finder__badge-dot" aria-hidden="true"></span>
    {%- endif -%}
    {{- block.settings.badge_text | escape -}}
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-finder__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    margin: 0;
    padding: 6px 12px;
    border: 1px solid var(--cbf-border);
    border-radius: 999px;
    background: var(--cbf-card);
    font-family: var(--cbf-font-body);
    font-weight: var(--cbf-font-body-strong);
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cbf-text);
  }

  .cb-finder__badge-dot {
    position: relative;
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbf-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cb-finder__badge-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: cb-finder-pulse 2s ease-out infinite;
    }
  }

  @keyframes cb-finder-pulse {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Badge",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Text",
      "info": "Shown in capitals.",
      "default": "Guided equipment fitting"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show accent dot",
      "default": true
    }
  ],
  "presets": [{ "name": "[CB] Badge" }]
}
{% endschema %}
