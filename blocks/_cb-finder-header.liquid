<div
  class="cb-finder__header cb-finder__header--{{ block.settings.alignment }}"
  style="--cbf-header-width: {{ block.settings.max_width }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-finder__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: var(--cbf-header-width, 640px);
  }

  .cb-finder__header--center {
    align-items: center;
    align-self: center;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Header",
  "tag": null,
  "blocks": [
    { "type": "_cb-finder-badge" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 640
    }
  ],
  "presets": [
    {
      "name": "[CB] Header",
      "blocks": {
        "badge": { "type": "_cb-finder-badge" },
        "heading": {
          "type": "cb-heading",
          "settings": {
            "heading_text": "Not sure which racket suits you?",
            "size": 56,
            "mobile_sizing": "fluid",
            "fluid_min": 34,
            "fluid_vw": 8,
            "line_height": 105,
            "letter_spacing": -2,
            "wrap": "pretty"
          }
        },
        "text": {
          "type": "cb-paragraph",
          "settings": {
            "body_text": "<p>Tell customers how the racket finder helps them choose.</p>",
            "size": 15,
            "mobile_size": 15,
            "max_width_unit": "ch",
            "max_width_ch": 56
          }
        }
      },
      "block_order": ["badge", "heading", "text"]
    }
  ]
}
{% endschema %}
