{%- assign menu = block.settings.menu -%}

<nav
  class="cb-footer-menu"
  style="--cb-footer-menu-heading-size: {{ block.settings.heading_size }}px; --cb-footer-menu-heading-weight: {{ block.settings.heading_weight }}; --cb-footer-menu-link-size: {{ block.settings.link_size }}px; --cb-footer-menu-link-weight: {{ block.settings.link_weight }};"
  {% if block.settings.menu_heading != blank %}
    aria-label="{{ block.settings.menu_heading | escape }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.menu_heading != blank -%}
    <h2 class="cb-footer-menu__heading">{{ block.settings.menu_heading | escape }}</h2>
  {%- endif -%}
  <ul class="cb-footer-menu__list" role="list">
    {%- if menu != blank and menu.links.size > 0 -%}
      {%- for link in menu.links -%}
        <li class="cb-footer__link-item">
          <a
            href="{{ link.url }}"
            class="cb-footer__link"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title | escape -}}
          </a>
        </li>
      {%- endfor -%}
    {%- else -%}
      {% content_for 'blocks' %}
    {%- endif -%}
  </ul>
</nav>

{% stylesheet %}
  .cb-footer-menu {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }

  .cb-footer-menu__heading {
    margin: 0;
    font-family: var(--cbft-font-heading);
    font-weight: var(--cb-footer-menu-heading-weight, var(--cbft-font-heading-weight));
    font-size: var(--cb-footer-menu-heading-size, 13px);
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cbft-text);
  }

  .cb-footer-menu__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cb-footer__link {
    font-family: var(--cbft-font-body);
    font-weight: var(--cb-footer-menu-link-weight, var(--cbft-font-body-weight));
    font-size: var(--cb-footer-menu-link-size, 14px);
    line-height: 1.4;
    color: var(--cbft-soft);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a.cb-footer__link:hover {
    color: var(--cbft-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a.cb-footer__link:focus-visible {
    outline: 2px solid var(--cbft-text);
    outline-offset: 2px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Link column",
  "tag": null,
  "blocks": [{ "type": "_cb-footer-link" }],
  "settings": [
    {
      "type": "text",
      "id": "menu_heading",
      "label": "Heading",
      "info": "Shown in capitals.",
      "default": "Links"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Optional. Choosing a menu shows its links instead of the [CB] Link blocks. Edit menus in Content > Menus."
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "link_size",
      "label": "Link size",
      "info": "Applies to the menu's links and the [CB] Link blocks.",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "link_weight",
      "label": "Link weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [
    {
      "name": "[CB] Link column",
      "blocks": {
        "link_1": { "type": "_cb-footer-link" },
        "link_2": { "type": "_cb-footer-link" }
      },
      "block_order": ["link_1", "link_2"]
    }
  ]
}
{% endschema %}
