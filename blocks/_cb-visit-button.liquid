{%- liquid
  # Link order: the set link, then Google Maps directions to the address, then the contact page.
  assign link = block.settings.link
  assign external = false
  if link == blank and block.settings.directions_address != blank
    assign destination = block.settings.directions_address | url_encode
    assign link = 'https://www.google.com/maps/dir/?api=1&destination=' | append: destination
    assign external = true
  endif
  if link == blank
    assign link = routes.root_url | append: 'pages/contact'
  endif
-%}

{%- if block.settings.label != blank -%}
  <a
    href="{{ link }}"
    class="cb-visit__button cb-visit__button--{{ block.settings.style }}"
    style="--cb-visit-button-text-size: {{ block.settings.text_size }}px; --cb-visit-button-text-weight: {{ block.settings.text_weight }};"
    {% if external %}
      target="_blank" rel="noopener"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{- block.settings.label | escape -}}
    {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
      {%- if block.settings.custom_icon != blank -%}
        {%- render 'cb-icon-upload', image: block.settings.custom_icon, size: 14, tint: block.settings.custom_icon_tint -%}
      {%- else -%}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'store' -%}
              <path d="M4.5 9 6 4h12l1.5 5"/><path d="M4.5 9h15v1.2a2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0z"/><path d="M6 12.5V20h12v-7.5M10 20v-4h4v4"/>
            {%- when 'pin' -%}
              <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
            {%- when 'arrow' -%}
              <path d="M5 12h14M13 6l6 6-6 6"/>
          {%- endcase -%}
        </svg>
      {%- endif -%}
    {%- endif -%}
    {%- if external -%}
      <span class="visually-hidden"> (opens Google Maps)</span>
    {%- endif -%}
  </a>
{%- endif -%}

{% stylesheet %}
  .cb-visit__button {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 42px;
    padding: 11px 22px;
    border: 1px solid transparent;
    border-radius: 2px;
    font-family: var(--cbv-font-body);
    font-weight: var(--cb-visit-button-text-weight, var(--cbv-font-body-strong));
    font-size: var(--cb-visit-button-text-size, 11px);
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .cb-visit__button svg {
    flex: none;
  }

  .cb-visit__button--light {
    background: var(--cbv-button-bg);
    color: var(--cbv-button-text);
  }

  .cb-visit__button--light:hover {
    background: color-mix(in srgb, var(--cbv-button-bg) 86%, var(--cbv-button-text));
  }

  .cb-visit__button--accent {
    background: var(--cbv-accent);
    color: #fff;
  }

  .cb-visit__button--accent:hover {
    background: color-mix(in srgb, var(--cbv-accent) 85%, #000);
  }

  .cb-visit__button--outline {
    border-color: var(--cbv-border-strong);
    background: transparent;
    color: var(--cbv-text);
  }

  .cb-visit__button--outline:hover {
    border-color: var(--cbv-text);
  }

  .cb-visit__button:focus-visible {
    outline: 2px solid var(--cbv-text);
    outline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Visit pro shop"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Leave empty for Google Maps directions to the address below."
    },
    {
      "type": "text",
      "id": "directions_address",
      "label": "Directions address",
      "default": "41R Elliot Street, Papakura, Auckland"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "accent", "label": "Accent" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "store", "label": "Shop front" },
        { "value": "pin", "label": "Map pin" },
        { "value": "arrow", "label": "Arrow" },
        { "value": "none", "label": "None" }
      ],
      "default": "store"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Upload your own SVG (or PNG). It replaces the built-in icon above."
    },
    {
      "type": "checkbox",
      "id": "custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses this section's icon colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.custom_icon != blank }}"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Button text size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Button text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Button" }]
}
{% endschema %}
