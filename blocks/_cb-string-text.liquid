{%- if block.settings.body_text != blank -%}
  <div
    class="cb-string__text"
    style="--cbs-text-size: {{ block.settings.size }}px;"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.body_text }}
  </div>
{%- endif -%}

{% stylesheet %}
  .cb-string__text {
    max-width: 62ch;
    font-family: var(--cbs-font-body);
    font-weight: var(--cbs-font-body-weight);
    font-size: var(--cbs-text-size, 14px);
    line-height: 1.65;
    color: var(--cbs-muted);
  }

  .cb-string__text > * {
    margin: 0;
  }

  .cb-string__text > * + * {
    margin-top: 0.75em;
  }

  .cb-string__text a {
    color: var(--cbs-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Text",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Text",
      "default": "<p>Tell customers about your stringing service.</p>"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [{ "name": "[CB] Text" }]
}
{% endschema %}
