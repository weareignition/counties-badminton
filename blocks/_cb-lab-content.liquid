<div
  class="cb-lab__content"
  style="--cbl-content-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-lab__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: center;
    gap: var(--cbl-content-gap, 18px);
    min-width: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Content group",
  "tag": null,
  "blocks": [
    { "type": "cb-subheader" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" },
    { "type": "_cb-lab-boxes" },
    { "type": "_cb-lab-actions" }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "Space between blocks",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "[CB] Content group",
      "blocks": {
        "eyebrow": {
          "type": "cb-subheader",
          "settings": { "subheader_text": "Electronic stringing lab", "show_dot": true, "letter_spacing": 12 }
        },
        "heading": {
          "type": "cb-heading",
          "settings": {
            "heading_text": "Your racket is only half the setup.",
            "size": 30,
            "mobile_scale": 80,
            "line_height": 108,
            "uppercase": true,
            "wrap": "wrap"
          }
        },
        "text": {
          "type": "cb-paragraph",
          "settings": {
            "body_text": "<p>Need help choosing string or tension? Our team strings rackets seven days a week on electronic constant-pull machines and calibrates every frame to your specific arm conditioning and shuttle response.</p>",
            "size": 13,
            "mobile_size": 13,
            "line_height": 165,
            "max_width_unit": "ch"
          }
        }
      },
      "block_order": ["eyebrow", "heading", "text"]
    }
  ]
}
{% endschema %}
