{%- if block.settings.heading_text != blank -%}
  <{{ block.settings.tag }}
    class="cb-finder__heading"
    style="--cbf-heading-size: {{ block.settings.size }}px;"
    {{ block.shopify_attributes }}
  >
    {{- block.settings.heading_text -}}
  </{{ block.settings.tag }}>
{%- endif -%}

{% stylesheet %}
  .cb-finder__heading {
    margin: 0;
    font-family: var(--cbf-font-heading);
    font-weight: var(--cbf-font-heading-weight);
    font-size: clamp(34px, 8vw, var(--cbf-heading-size, 56px));
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--cbf-text);
    text-wrap: pretty;
  }

  .cb-finder__heading em {
    font-style: normal;
    color: var(--cbf-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Heading",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading_text",
      "label": "Heading",
      "info": "Italic text is shown in the accent color.",
      "default": "Not sure which racket suits you?"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Desktop size",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "select",
      "id": "tag",
      "label": "HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h2"
    }
  ],
  "presets": [{ "name": "[CB] Heading" }]
}
{% endschema %}
