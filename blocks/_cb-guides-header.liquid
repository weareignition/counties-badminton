<div
  class="cb-guides__header cb-guides__header--{{ block.settings.alignment }}"
  style="--cbg-header-width: {{ block.settings.max_width }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .cb-guides__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: var(--cbg-header-width, 720px);
  }

  .cb-guides__header--center {
    align-items: center;
    align-self: center;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Header",
  "tag": null,
  "blocks": [
    { "type": "cb-subheader" },
    { "type": "cb-heading" },
    { "type": "cb-paragraph" },
    { "type": "cb-button" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 720
    }
  ],
  "presets": [
    {
      "name": "[CB] Header",
      "blocks": {
        "eyebrow": {
          "type": "cb-subheader",
          "settings": { "subheader_text": "Technical guidance", "size": 11, "letter_spacing": 12, "space_below": -4 }
        },
        "heading": {
          "type": "cb-heading",
          "settings": {
            "heading_text": "We don’t expect you to know what 4U, head-heavy or 26 lbs means. That’s our job.",
            "size": 48,
            "mobile_sizing": "fluid",
            "fluid_min": 30,
            "fluid_vw": 6.5,
            "line_height": 106,
            "letter_spacing": -2
          }
        },
        "text": {
          "type": "cb-paragraph",
          "settings": { "body_text": "<p>Tell customers what these guides cover.</p>", "max_width_unit": "ch" }
        }
      },
      "block_order": ["eyebrow", "heading", "text"]
    }
  ]
}
{% endschema %}
