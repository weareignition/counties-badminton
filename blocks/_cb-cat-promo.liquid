{%- liquid
  assign tag = 'div'
  if block.settings.link != blank
    assign tag = 'a'
  endif
  assign icon_side = false
  if block.settings.icon_layout == 'side' and block.settings.icon != 'none' or block.settings.custom_icon != blank
    assign icon_side = true
  endif
-%}

{%- capture icon -%}
  {%- if block.settings.custom_icon != blank or block.settings.icon != 'none' -%}
    {%- if block.settings.custom_icon != blank -%}
      {%- render 'cb-icon-upload', image: block.settings.custom_icon, size: 14, tint: block.settings.custom_icon_tint -%}
    {%- else -%}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- case block.settings.icon -%}
          {%- when 'tools' -%}
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>
          {%- when 'racket' -%}
            <ellipse cx="9" cy="9" rx="5" ry="6.2" transform="rotate(-45 9 9)"/><path d="m12.6 12.6 7.4 7.4"/>
          {%- when 'shield' -%}
            <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.1 7.5 9.5 4.3-1.4 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/>
          {%- when 'clock' -%}
            <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
          {%- when 'info' -%}
            <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
          {%- when 'store' -%}
            <path d="M4.5 9 6 4h12l1.5 5"/><path d="M4.5 9h15v1.2a2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0 2.5 2.5 0 0 1-5 0z"/><path d="M6 12.5V20h12v-7.5M10 20v-4h4v4"/>
          {%- when 'pin' -%}
            <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
          {%- when 'bag' -%}
            <rect x="4" y="9" width="16" height="12" rx="1.5"/><circle cx="12" cy="9" r="3.5"/>
        {%- endcase -%}
      </svg>
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

<{{ tag }}
  {% if block.settings.link != blank %}
    href="{{ block.settings.link }}"
  {% endif %}
  class="cb-cat-promo{% if icon_side %} cb-cat-promo--icon-side{% endif %}{% if block.settings.title_color == 'text' %} cb-cat-promo--plain-title{% endif %}{% if block.settings.look == 'card' %} cb-cat-promo--card{% endif %}{% if block.settings.accent_border %} cb-cat-promo--accent{% endif %}"
  style="
    --cb-cat-promo-title-size: {{ block.settings.title_size }}px;
    --cb-cat-promo-title-weight: {{ block.settings.title_weight }};
    --cb-cat-promo-text-size: {{ block.settings.text_size }}px;
    --cb-cat-promo-text-weight: {{ block.settings.text_weight }};
    --cb-cat-promo-footer-size: {{ block.settings.footer_size }}px;
    --cb-cat-promo-footer-weight: {{ block.settings.footer_weight }};
  "
  {{ block.shopify_attributes }}
>
  {%- if icon_side -%}
    <span class="cb-cat-promo__icon">{{ icon }}</span>
  {%- endif -%}

  <div class="cb-cat-promo__content">
    {%- if block.settings.promo_title != blank -%}
      <p class="cb-cat-promo__title">
        {%- unless icon_side -%}
          {{ icon }}
        {%- endunless -%}
        <span>{{ block.settings.promo_title | escape }}</span>
        {%- if block.settings.show_dot -%}
          <span class="cb-cat-promo__dot" aria-hidden="true"></span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if block.settings.promo_text != blank -%}
      <p class="cb-cat-promo__text">{{ block.settings.promo_text | escape }}</p>
    {%- endif -%}

    {%- if block.settings.footer_label != blank or block.settings.footer_value != blank -%}
      <div class="cb-cat-promo__footer">
        <span>{{ block.settings.footer_label | escape }}</span>
        <strong>{{ block.settings.footer_value | escape }}</strong>
      </div>
    {%- endif -%}
  </div>
</{{ tag }}>

{% stylesheet %}
  .cb-cat-promo {
    display: flex;
    gap: 12px;
    margin-top: 20px;
    padding: 16px;
    border: 1px solid var(--cbk-border);
    border-radius: 4px;
    background: var(--cbk-card);
    color: inherit;
    text-decoration: none;
  }

  .cb-cat-promo__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .cb-cat-promo__icon {
    display: inline-flex;
    flex: none;
    margin-top: 1px;
    color: var(--cbk-accent);
  }

  .cb-cat-promo__icon svg,
  .cb-cat-promo__icon .cb-icon-upload {
    width: 16px;
    height: 16px;
  }

  .cb-cat-promo--plain-title .cb-cat-promo__title {
    color: var(--cbk-text);
  }

  .cb-cat-promo__dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cbk-accent);
  }

  a.cb-cat-promo:hover {
    border-color: var(--cbk-border-strong);
  }

  .cb-cat-promo__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--cbk-font-body);
    font-weight: var(--cb-cat-promo-title-weight, var(--cbk-font-body-strong));
    font-size: var(--cb-cat-promo-title-size, 11px);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cbk-accent);
  }

  .cb-cat-promo__text {
    margin: 0;
    font-family: var(--cbk-font-body);
    font-weight: var(--cb-cat-promo-text-weight, inherit);
    font-size: var(--cb-cat-promo-text-size, 12px);
    line-height: 1.55;
    color: var(--cbk-soft);
  }

  /* Label and value share a line when they fit, otherwise the value drops underneath. */
  .cb-cat-promo__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 8px;
    padding-top: 10px;
    border-top: 1px solid var(--cbk-border);
    font-family: var(--cbk-font-body);
    font-weight: var(--cb-cat-promo-footer-weight, inherit);
    font-size: var(--cb-cat-promo-footer-size, 11px);
    color: var(--cbk-muted);
  }

  .cb-cat-promo__footer strong {
    white-space: nowrap;
    font-weight: max(var(--cb-cat-promo-footer-weight, 0), var(--cbk-font-body-strong));
    color: var(--cbk-text);
  }

  /* Card look, matching card-style filters. Two classes beat the compact rules. */
  .cb-cat-promo.cb-cat-promo--card {
    gap: 14px;
    margin-top: 0;
    padding: 20px;
    border-radius: 8px;
  }

  .cb-cat-promo--card .cb-cat-promo__content {
    gap: 6px;
  }

  .cb-cat-promo--card .cb-cat-promo__icon svg,
  .cb-cat-promo--card .cb-cat-promo__icon .cb-icon-upload {
    width: 20px;
    height: 20px;
  }

  .cb-cat-promo--card .cb-cat-promo__title {
    font-family: var(--cbk-font-heading);
    font-weight: var(--cb-cat-promo-title-weight, var(--cbk-font-heading-medium-weight));
    font-size: calc(var(--cb-cat-promo-title-size, 11px) * 15 / 11);
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
  }

  .cb-cat-promo--card .cb-cat-promo__text {
    font-size: calc(var(--cb-cat-promo-text-size, 12px) * 13 / 12);
    line-height: 1.5;
    color: color-mix(in srgb, var(--cbk-text) 62%, transparent);
  }

  .cb-cat-promo.cb-cat-promo--accent {
    border-color: color-mix(in srgb, var(--cbk-accent) 28%, transparent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Promo card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "tools", "label": "Tools" },
        { "value": "racket", "label": "Racket" },
        { "value": "shield", "label": "Shield" },
        { "value": "clock", "label": "Clock" },
        { "value": "info", "label": "Info" },
        { "value": "store", "label": "Shop front" },
        { "value": "pin", "label": "Map pin" },
        { "value": "bag", "label": "Bag" },
        { "value": "none", "label": "None" }
      ],
      "default": "tools"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "Upload your own SVG (or PNG). It replaces the built-in icon above."
    },
    {
      "type": "checkbox",
      "id": "custom_icon_tint",
      "label": "Colour it like the built-in icons",
      "info": "For one-colour SVGs: uses this section's icon colour. Turn off to keep the file's own colours.",
      "default": true,
      "visible_if": "{{ block.settings.custom_icon != blank }}"
    },
    {
      "type": "select",
      "id": "look",
      "label": "Look",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "card", "label": "Card (matches card-style filters)" }
      ],
      "default": "compact"
    },
    {
      "type": "checkbox",
      "id": "accent_border",
      "label": "Accent border",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_layout",
      "label": "Icon position",
      "options": [
        { "value": "inline", "label": "Beside the title" },
        { "value": "side", "label": "Own column on the left" }
      ],
      "default": "inline"
    },
    {
      "type": "select",
      "id": "title_color",
      "label": "Title color",
      "options": [
        { "value": "accent", "label": "Accent" },
        { "value": "text", "label": "Text" }
      ],
      "default": "accent"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Accent dot after the title",
      "default": false
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Title",
      "default": "Certified restring service"
    },
    {
      "type": "textarea",
      "id": "promo_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "footer_label",
      "label": "Footer label"
    },
    {
      "type": "text",
      "id": "footer_value",
      "label": "Footer value"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "info": "The Card look shows it larger.",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "info": "The Card look shows it slightly larger.",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "footer_size",
      "label": "Footer size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "footer_weight",
      "label": "Footer weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Promo card" }]
}
{% endschema %}
