{%- liquid
  assign tag = 'div'
  if block.settings.link != blank
    assign tag = 'a'
  endif
-%}

<{{ tag }}
  {% if block.settings.link != blank %}
    href="{{ block.settings.link }}"
  {% endif %}
  class="cb-cat-promo"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.promo_title != blank -%}
    <p class="cb-cat-promo__title">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- case block.settings.icon -%}
          {%- when 'tools' -%}
            <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>
          {%- when 'racket' -%}
            <ellipse cx="9" cy="9" rx="5" ry="6.2" transform="rotate(-45 9 9)"/><path d="m12.6 12.6 7.4 7.4"/>
          {%- when 'shield' -%}
            <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.1 7.5 9.5 4.3-1.4 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/>
          {%- when 'clock' -%}
            <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
          {%- when 'info' -%}
            <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
        {%- endcase -%}
      </svg>
      {{- block.settings.promo_title | escape -}}
    </p>
  {%- endif -%}

  {%- if block.settings.promo_text != blank -%}
    <p class="cb-cat-promo__text">{{ block.settings.promo_text | escape }}</p>
  {%- endif -%}

  {%- if block.settings.footer_label != blank or block.settings.footer_value != blank -%}
    <div class="cb-cat-promo__footer">
      <span>{{ block.settings.footer_label | escape }}</span>
      <strong>{{ block.settings.footer_value | escape }}</strong>
    </div>
  {%- endif -%}
</{{ tag }}>

{% stylesheet %}
  .cb-cat-promo {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 20px;
    padding: 16px;
    border: 1px solid var(--cbk-border);
    border-radius: 4px;
    background: var(--cbk-card);
    color: inherit;
    text-decoration: none;
  }

  a.cb-cat-promo:hover {
    border-color: var(--cbk-border-strong);
  }

  .cb-cat-promo__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--cbk-font-body);
    font-weight: var(--cbk-font-body-strong);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cbk-accent);
  }

  .cb-cat-promo__text {
    margin: 0;
    font-family: var(--cbk-font-body);
    font-size: 12px;
    line-height: 1.55;
    color: var(--cbk-soft);
  }

  /* Label and value share a line when they fit, otherwise the value drops underneath. */
  .cb-cat-promo__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 8px;
    padding-top: 10px;
    border-top: 1px solid var(--cbk-border);
    font-family: var(--cbk-font-body);
    font-size: 11px;
    color: var(--cbk-muted);
  }

  .cb-cat-promo__footer strong {
    white-space: nowrap;
    font-weight: var(--cbk-font-body-strong);
    color: var(--cbk-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Promo card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "tools", "label": "Tools" },
        { "value": "racket", "label": "Racket" },
        { "value": "shield", "label": "Shield" },
        { "value": "clock", "label": "Clock" },
        { "value": "info", "label": "Info" }
      ],
      "default": "tools"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "Title",
      "default": "Certified restring service"
    },
    {
      "type": "textarea",
      "id": "promo_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "footer_label",
      "label": "Footer label"
    },
    {
      "type": "text",
      "id": "footer_value",
      "label": "Footer value"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [{ "name": "[CB] Promo card" }]
}
{% endschema %}
