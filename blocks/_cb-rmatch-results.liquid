    },
    {
      "type": "text",
      "id": "exclude_words",
      "label": "Leave out rackets whose title contains",
      "info": "Comma separated.",
      "default": "2nd hand, junior, kid"
    },
    {
      "type": "header",
      "content": "Results heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your racket matches"
    },
    {
      "type": "text",
      "id": "results_heading",
      "label": "Heading",
      "default": "Here’s what we’d put in your hand."
    },
