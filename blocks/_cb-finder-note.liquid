{%- if block.settings.note_text != blank -%}
  <p class="cb-finder__note" {{ block.shopify_attributes }}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {%- case block.settings.icon -%}
        {%- when 'check' -%}
          <circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>
        {%- when 'clock' -%}
          <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
        {%- when 'shield' -%}
          <path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.1 7.5 9.5 4.3-1.4 7.5-4.9 7.5-9.5V6z"/><path d="m9 12 2 2 4-4"/>
        {%- when 'star' -%}
          <path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>
        {%- when 'info' -%}
          <circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>
      {%- endcase -%}
    </svg>
    <span>{{ block.settings.note_text | escape }}</span>
  </p>
{%- endif -%}

{% stylesheet %}
  .cb-finder__note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--cbf-font-body);
    font-weight: var(--cbf-font-body-weight);
    font-size: 12px;
    line-height: 1.5;
    color: var(--cbf-muted);
  }

  .cb-finder__note svg {
    flex: none;
    color: var(--cbf-accent);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Note",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Icon",
      "options": [
        { "value": "check", "label": "Check" },
        { "value": "clock", "label": "Clock" },
        { "value": "shield", "label": "Shield" },
        { "value": "star", "label": "Star" },
        { "value": "info", "label": "Info" }
      ],
      "default": "check"
    },
    {
      "type": "text",
      "id": "note_text",
      "label": "Text",
      "default": "Takes less than 2 minutes."
    }
  ],
  "presets": [{ "name": "[CB] Note" }]
}
{% endschema %}
