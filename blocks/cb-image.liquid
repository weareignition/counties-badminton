{%- comment -%}
  A photo panel for any section: cropped to a chosen shape (5:2 by default), with an optional phone image and shape,
  rounded corners and a thin border. Width and box styling come from snippets/cb-text-box.
{%- endcomment -%}
{%- liquid
  assign s = block.settings
  assign desktop = s.image | default: s.mobile_image
  assign phone = s.mobile_image | default: s.image

  assign ratio = s.ratio
  if ratio == 'original'
    assign ratio = desktop.aspect_ratio | default: 2.5
  endif
  assign mobile_ratio = s.mobile_ratio
  if mobile_ratio == 'same'
    assign mobile_ratio = ratio
  elsif mobile_ratio == 'original'
    assign mobile_ratio = phone.aspect_ratio | default: ratio
  endif

  assign alt = s.alt | default: desktop.alt | escape
  assign loading = 'lazy'
  assign priority = 'auto'
  if s.eager
    assign loading = 'eager'
    assign priority = 'high'
  endif

  assign tag = 'div'
  if s.link != blank
    assign tag = 'a'
  endif
-%}

<{{ tag }}
  {% if s.link != blank %}href="{{ s.link }}"{% endif %}
  class="cb-image{% render 'cb-text-box', settings: s, part: 'class' %}"
  style="
    --cb-image-ratio: {{ ratio }};
    --cb-image-ratio-mobile: {{ mobile_ratio }};
    {%- if desktop.presentation.focal_point %} --cb-image-focus: {{ desktop.presentation.focal_point }};{% endif %}
    {%- if phone.presentation.focal_point %} --cb-image-focus-mobile: {{ phone.presentation.focal_point }};{% endif %}
    {% render 'cb-text-box', settings: s, part: 'style' %}
  "
  {{ block.shopify_attributes }}
>
  {%- if desktop != blank -%}
    <picture class="cb-image__picture">
      {%- if s.mobile_image != blank and s.image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ s.mobile_image | image_url: width: 400 }} 400w,
            {{ s.mobile_image | image_url: width: 750 }} 750w,
            {{ s.mobile_image | image_url: width: 1100 }} 1100w
          "
          sizes="100vw"
        >
      {%- endif -%}
      {{
        desktop
        | image_url: width: 2400
        | image_tag:
          widths: '400, 750, 1100, 1500, 1920, 2400',
          sizes: '(min-width: 1200px) 1120px, 100vw',
          loading: loading,
          fetchpriority: priority,
          alt: alt,
          class: 'cb-image__img'
      }}
    </picture>
  {%- else -%}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'cb-image__placeholder' }}
  {%- endif -%}
</{{ tag }}>

{% stylesheet %}
  .cb-image {
    display: block;
    position: relative;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: var(--cb-image-ratio-mobile, var(--cb-image-ratio, 2.5));
    background: var(--cb-box-bg, #0b0b0b);
  }

  .cb-image__picture,
  .cb-image__img,
  .cb-image__placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cb-image__img {
    object-fit: cover;
    object-position: var(--cb-image-focus-mobile, var(--cb-image-focus, 50% 50%));
  }

  .cb-image__placeholder {
    background: #1b1b1b;
    fill: rgb(255 255 255 / 0.12);
  }

  @media screen and (min-width: 750px) {
    .cb-image {
      aspect-ratio: var(--cb-image-ratio, 2.5);
    }

    .cb-image__img {
      object-position: var(--cb-image-focus, 50% 50%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "To choose which part stays in view when the photo is cropped, set its focal point in the image picker."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Phone image",
      "info": "Optional. Shown on screens under 750px wide instead of the image above."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Image description",
      "info": "For screen readers. Leave empty to use the image's own alt text."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Shape"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Shape",
      "options": [
        { "value": "original", "label": "Image's own shape" },
        { "value": "3 / 1", "label": "3:1" },
        { "value": "5 / 2", "label": "5:2 (wide banner)" },
        { "value": "2 / 1", "label": "2:1" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "4:5 (portrait)" }
      ],
      "default": "5 / 2"
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Shape on phones",
      "options": [
        { "value": "same", "label": "Same as above" },
        { "value": "original", "label": "Image's own shape" },
        { "value": "3 / 1", "label": "3:1" },
        { "value": "5 / 2", "label": "5:2 (wide banner)" },
        { "value": "2 / 1", "label": "2:1" },
        { "value": "16 / 9", "label": "16:9" },
        { "value": "3 / 2", "label": "3:2" },
        { "value": "4 / 3", "label": "4:3" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "4:5 (portrait)" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "checkbox",
      "id": "eager",
      "label": "Load right away",
      "info": "Turn on for an image near the top of the page, so it shows faster.",
      "default": false
    },
    {
      "type": "header",
      "content": "Width"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "value": "auto", "label": "Auto (follows the section)" },
        { "value": "fit", "label": "Fit the text" },
        { "value": "full", "label": "Full width" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "width_px",
      "label": "Custom width",
      "min": 100,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 400,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Box"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "info": "Shows behind the photo while it loads, and around it when there is padding."
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Padding top and bottom",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Padding left and right",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border",
      "info": "0 = no border.",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "info": "Leave empty for a faint version of the text colour.",
      "visible_if": "{{ block.settings.border_width > 0 }}",
      "default": "#ffffff14"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "[CB] Image"
    }
  ]
}
{% endschema %}
