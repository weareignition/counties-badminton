{%- liquid
  # The logo is decorative when the brand name is shown beside it (the link already reads the name).
  assign logo_alt = shop.name
  if block.settings.brand_name != blank
    assign logo_alt = ''
  endif
-%}

<a
  href="{{ routes.root_url }}"
  class="cb-footer__lockup"
  style="--cb-footer-logo-name-size: {{ block.settings.name_size }}px; --cb-footer-logo-name-weight: {{ block.settings.name_weight }}; --cb-footer-logo-tagline-size: {{ block.settings.tagline_size }}px; --cb-footer-logo-tagline-weight: {{ block.settings.tagline_weight }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.logo != blank -%}
    <span
      class="cb-footer__logo-box"
      style="--cbft-logo-bg: {{ block.settings.logo_background }}; --cbft-logo-height: {{ block.settings.logo_height }}px;"
    >
      {{
        block.settings.logo
        | image_url: width: 480
        | image_tag: widths: '200, 320, 480', sizes: '200px', loading: 'lazy', alt: logo_alt
      }}
    </span>
  {%- endif -%}
  {%- if block.settings.brand_name != blank or block.settings.tagline != blank -%}
    <span class="cb-footer__lockup-text">
      {%- if block.settings.brand_name != blank -%}
        <span class="cb-footer__brand-name">{{ block.settings.brand_name | escape }}</span>
      {%- endif -%}
      {%- if block.settings.tagline != blank -%}
        <span class="cb-footer__tagline">{{ block.settings.tagline | escape }}</span>
      {%- endif -%}
    </span>
  {%- endif -%}
</a>

{% stylesheet %}
  .cb-footer__lockup {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .cb-footer__lockup:focus-visible {
    outline: 2px solid var(--cbft-text);
    outline-offset: 4px;
  }

  .cb-footer__logo-box {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    min-width: 140px;
    padding: 7px 18px;
    border-radius: 4px;
    background: var(--cbft-logo-bg, #fff);
  }

  .cb-footer__logo-box img {
    display: block;
    width: auto;
    max-width: 220px;
    height: var(--cbft-logo-height, 26px);
    object-fit: contain;
  }

  .cb-footer__lockup-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cb-footer__brand-name {
    font-family: var(--cbft-font-heading);
    font-weight: var(--cb-footer-logo-name-weight, var(--cbft-font-heading-weight));
    font-size: var(--cb-footer-logo-name-size, 15px);
    line-height: 1.2;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--cbft-text);
  }

  .cb-footer__tagline {
    font-family: var(--cbft-font-body);
    font-weight: var(--cb-footer-logo-tagline-weight, var(--cbft-font-body-weight));
    font-size: var(--cb-footer-logo-tagline-size, 11px);
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cbft-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Logo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "color",
      "id": "logo_background",
      "label": "Logo background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Name",
      "info": "Shown in capitals beside the logo.",
      "default": "Counties Manukau"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Badminton Pro Shop"
    },
    {
      "type": "header",
      "content": "Text sizes and weights"
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Name size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "select",
      "id": "name_weight",
      "label": "Name weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    },
    {
      "type": "range",
      "id": "tagline_size",
      "label": "Tagline size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 11
    },
    {
      "type": "select",
      "id": "tagline_weight",
      "label": "Tagline weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial"
    }
  ],
  "presets": [{ "name": "[CB] Logo" }]
}
{% endschema %}
