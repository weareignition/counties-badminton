              }
            },
            "brands": {
              "type": "_cb-fintro-feature",
              "settings": {
                "icon": "sliders",
                "feature_title": "Unbiased multi-brand stock",
                "feature_text": "Direct authorized stock from Yonex, Victor, Ashaway, and Babolat."
              }
            },
            "guidance": {
              "type": "_cb-fintro-feature",
              "settings": {
                "icon": "badge_check",
                "feature_title": "Specialist Pro Shop guidance",
                "feature_text": "Backed by certified stringers and on-court coaches in Papakura."
              }
            }
          },
          "block_order": ["play", "brands", "guidance"]
        }
      },
      "block_order": ["content", "features"]
    }
  ]
}
{% endschema %}
