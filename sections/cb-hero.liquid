{%- liquid
  assign s = section.settings
  assign font_scope = '#cb-hero-' | append: section.id

  # Designs 5, 6 and 7 show a breadcrumb at the top.
  assign crumb_sep = blank
  if s.design == '5' or s.design == '7'
    assign crumb_sep = '/'
  elsif s.design == '6'
    assign crumb_sep = '&gt;'
  endif
-%}

{% render 'cb-font-styles',
  selector: font_scope,
  prefix: 'cbh',
  heading_font: s.heading_font,
  body_font: s.body_font
%}

<section
  id="cb-hero-{{ section.id }}"
  class="cb-hero cb-hero--design-{{ s.design | default: '1' }}{% if s.design == '6' %} cb-hero--design-5{% endif %}{% if s.design == '7' %} cb-hero--design-4{% endif %}{% if s.media_first_mobile %} cb-hero--media-first{% endif %}{% if s.design == '2' and s.media_edge == 'margin' %} cb-hero--media-margin{% endif %}"
  style="
    --cbh-bg: {{ s.background_color }};
    --cbh-glow: {{ s.glow_color }};
    --cbh-text: {{ s.text_color }};
    --cbh-muted: {{ s.text_color | color_modify: 'alpha', 0.72 }};
    --cbh-border: {{ s.text_color | color_modify: 'alpha', 0.12 }};
    --cbh-surface: {{ s.text_color | color_modify: 'alpha', 0.04 }};
    --cbh-accent: {{ s.accent_color }};
    --cbh-accent-text: {{ s.accent_text_color }};
    --cbh-max-width: {{ s.max_width }}px;
    --cbh-gap: {{ s.column_gap }}px;
    --cbh-pt: {{ s.padding_top }}px;
    --cbh-pb: {{ s.padding_bottom }}px;
    --cbh-content-col: {{ s.content_width }}fr;
    --cbh-media-col: {{ 100 | minus: s.content_width }}fr;
  "
>
  {%- if crumb_sep != blank and s.breadcrumb != blank -%}
    {%- assign crumbs = s.breadcrumb | split: '/' -%}
    <nav
      class="cb-hero__crumbs"
      aria-label="Breadcrumb"
      style="--cb-hero-crumb-size: {{ s.breadcrumb_size }}px; --cb-hero-crumb-weight: {{ s.breadcrumb_weight }};"
    >
      {%- for crumb in crumbs -%}
        {%- assign crumb_label = crumb | strip | escape -%}
        {%- if forloop.last -%}
          <span class="cb-hero__crumb-current" aria-current="page">{{ crumb_label }}</span>
        {%- elsif forloop.first -%}
          <a href="{{ routes.root_url }}">{{ crumb_label }}</a>
          <span aria-hidden="true">{{ crumb_sep }}</span>
        {%- else -%}
          <span>{{ crumb_label }}</span>
          <span aria-hidden="true">{{ crumb_sep }}</span>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <div class="cb-hero__inner">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .cb-hero {
    position: relative;
    overflow: hidden;
    color: var(--cbh-text);
    background:
      radial-gradient(60% 80% at 0% 0%, var(--cbh-glow) 0%, transparent 70%),
      var(--cbh-bg);
    padding: calc(var(--cbh-pt) * 0.6) 16px calc(var(--cbh-pb) * 0.6);
  }

  .cb-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    max-width: var(--cbh-max-width);
    margin-inline: auto;
  }

  .cb-hero--media-first .cb-hero__media {
    order: -1;
  }

  @media screen and (min-width: 750px) {
    .cb-hero {
      padding: calc(var(--cbh-pt) * 0.8) 32px calc(var(--cbh-pb) * 0.8);
    }
  }

  @media screen and (min-width: 990px) {
    .cb-hero {
      padding: var(--cbh-pt) 48px var(--cbh-pb);
    }

    .cb-hero__inner {
      grid-template-columns: minmax(0, var(--cbh-content-col)) minmax(0, var(--cbh-media-col));
      gap: var(--cbh-gap);
    }

    .cb-hero--media-first .cb-hero__media {
      order: 0;
    }
  }

  /*
   * Design 2: the image runs full-bleed down the right half (edge to edge, no frame) and the text column
   * carries the section padding, lining up with the other sections' content edge.
   * Rules are prefixed with .cb-hero--design-2 so they beat the blocks' own defaults in any stylesheet order.
   */
  .cb-hero.cb-hero--design-2 {
    padding: 0;
  }

  .cb-hero--design-2 .cb-hero__inner {
    gap: 0;
    max-width: none;
  }

  .cb-hero--design-2 .cb-hero__content {
    padding: calc(var(--cbh-pt) * 0.6) 16px calc(var(--cbh-pb) * 0.6);
  }

  .cb-hero--design-2 .cb-hero__media-frame {
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .cb-hero--design-2 .cb-hero__badge {
    padding: 0;
    border: 0;
    background: none;
    font-size: calc(var(--cb-hero-badge-text-size, 12px) * 11 / 12);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .cb-hero--design-2 .cb-hero__badge-main {
    color: var(--cbh-accent);
  }

  .cb-hero--design-2 .cb-hero__button {
    min-height: 46px;
    padding: 12px 20px;
    border-radius: 3px;
    font-size: calc(var(--cb-hero-button-label-size, 14px) * 12 / 14);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cb-hero--design-2 .cb-hero__feature {
    font-size: calc(var(--cb-hero-feature-text-size, 14px) * 12 / 14);
    font-weight: var(--cb-hero-feature-text-weight, var(--cbh-font-body-weight));
  }

  /* Design 2 labels: smaller, near-square corners, solid dark background without a border. */
  .cb-hero--design-2 .cb-hero__label {
    padding: 4px 8px;
    border-radius: 2px;
    font-size: calc(var(--cb-hero-label-text-size, 12px) * 10 / 12);
  }

  .cb-hero--design-2 .cb-hero__label--dark {
    border: 0;
    background: rgb(24 24 24 / 0.92);
    color: #ececec;
  }

  .cb-hero--design-2 .cb-hero__label--caps {
    font-size: calc(var(--cb-hero-label-text-size, 12px) * 9 / 12);
    letter-spacing: 0.05em;
  }

  @media screen and (min-width: 750px) {
    .cb-hero--design-2 .cb-hero__content {
      padding: calc(var(--cbh-pt) * 0.8) 32px calc(var(--cbh-pb) * 0.8);
    }

    /* Features take their natural width so they sit on one line. */
    .cb-hero--design-2 .cb-hero__features {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 28px;
    }

    .cb-hero--design-2 .cb-hero__label {
      padding: 6px 10px;
      font-size: calc(var(--cb-hero-label-text-size, 12px) * 11 / 12);
    }

    .cb-hero--design-2 .cb-hero__label--caps {
      font-size: calc(var(--cb-hero-label-text-size, 12px) * 10 / 12);
    }
  }

  @media screen and (min-width: 990px) {
    .cb-hero--design-2 .cb-hero__inner {
      align-items: stretch;
    }

    .cb-hero--design-2 .cb-hero__content {
      align-self: center;
      padding: var(--cbh-pt) var(--cbh-gap) var(--cbh-pb) max(48px, calc((100vw - var(--cbh-max-width)) / 2));
    }

    .cb-hero--design-2 .cb-hero__media-frame {
      height: 100%;
      min-height: 460px;
      aspect-ratio: auto;
    }

    /* "Page margin": the image stops at the same margin the text column starts from. */
    .cb-hero--design-2.cb-hero--media-margin .cb-hero__media {
      margin-right: max(48px, calc((100vw - var(--cbh-max-width)) / 2));
    }
  }

  /*
   * Design 3: the photo sits on a white mat inside a dark panel, with its label overhanging the mat's corner.
   * The badge is a dark-red box and the buttons and features are smaller and quieter.
   * Rules are prefixed with .cb-hero--design-3 so they beat the blocks' own defaults in any stylesheet order.
   */
  .cb-hero--design-3 {
    --cbh-mat: 8px;
  }

  .cb-hero--design-3 .cb-hero__badge {
    gap: 5px;
    padding: 7px 10px;
    border-color: color-mix(in srgb, var(--cbh-accent) 30%, transparent);
    border-radius: 3px;
    background: color-mix(in srgb, var(--cbh-accent) 10%, transparent);
    font-size: calc(var(--cb-hero-badge-text-size, 12px) * 10 / 12);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--cbh-accent);
  }

  .cb-hero--design-3 .cb-hero__badge-sep,
  .cb-hero--design-3 .cb-hero__badge-secondary {
    color: inherit;
  }

  .cb-hero--design-3 .cb-hero__buttons {
    gap: 16px;
  }

  .cb-hero--design-3 .cb-hero__button {
    min-height: 44px;
    padding: 12px 24px;
    border-radius: 3px;
    font-size: calc(var(--cb-hero-button-label-size, 14px) * 11 / 14);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .cb-hero--design-3 .cb-hero__feature {
    font-size: calc(var(--cb-hero-feature-text-size, 14px) * 12 / 14);
    font-weight: var(--cb-hero-feature-text-weight, var(--cbh-font-body-weight));
    color: color-mix(in srgb, var(--cbh-text) 80%, transparent);
  }

  .cb-hero--design-3 .cb-hero__media {
    padding: 16px;
    border: 1px solid var(--cbh-border);
    border-radius: 4px;
    background: var(--cbh-surface);
  }

  .cb-hero--design-3 .cb-hero__media-frame {
    overflow: visible;
    border: 0;
    background: #fff;
    box-shadow: none;
  }

  .cb-hero--design-3 .cb-hero__image,
  .cb-hero--design-3 .cb-hero__gradient {
    inset: var(--cbh-mat);
    width: calc(100% - var(--cbh-mat) * 2);
    height: calc(100% - var(--cbh-mat) * 2);
  }

  .cb-hero--design-3 .cb-hero__labels {
    inset: -8px;
  }

  .cb-hero--design-3 .cb-hero__label--dark {
    padding: 10px 12px;
    border: 0;
    border-radius: 2px;
    background: rgb(11 11 11 / 0.9);
    font-size: calc(var(--cb-hero-label-text-size, 12px) * 11 / 12);
    font-weight: var(--cb-hero-label-text-weight, var(--cbh-font-body-weight));
    color: #d8d8d8;
  }

  .cb-hero--design-3 .cb-hero__label--dark::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 10px;
    border-radius: 50%;
    vertical-align: 1px;
    background: var(--cbh-accent);
  }

  @media screen and (min-width: 750px) {
    .cb-hero--design-3 {
      --cbh-mat: 16px;
    }

    .cb-hero--design-3 .cb-hero__media {
      padding: 32px;
    }

    .cb-hero--design-3 .cb-hero__labels {
      inset: -14px;
    }
  }

  /*
   * Design 4: the photo sits in a plain dark frame with a two-line label; the badge is plain accent text and the
   * features have no divider. Rules are prefixed with .cb-hero--design-4 so they beat the blocks' own defaults.
   */
  .cb-hero--design-4 .cb-hero__content,
  .cb-hero--design-5 .cb-hero__content {
    --cbh-muted: color-mix(in srgb, var(--cbh-text) 62%, transparent);
    --cb-color-muted: var(--cbh-muted);
  }

  .cb-hero--design-4 .cb-hero__badge,
  .cb-hero--design-5 .cb-hero__badge {
    padding: 0;
    border: 0;
    background: none;
    font-size: calc(var(--cb-hero-badge-text-size, 12px) * 10 / 12);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .cb-hero--design-4 .cb-hero__badge-main,
  .cb-hero--design-5 .cb-hero__badge-main {
    color: var(--cbh-accent);
  }

  .cb-hero--design-4 .cb-hero__button {
    min-height: 45px;
    padding: 14px 32px;
    border-radius: 3px;
    font-size: calc(var(--cb-hero-button-label-size, 14px) * 10 / 14);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .cb-hero--design-4 .cb-hero__button--secondary {
    border-color: color-mix(in srgb, var(--cbh-text) 85%, transparent);
    background: transparent;
  }

  .cb-hero--design-4 .cb-hero__button--secondary:hover {
    border-color: var(--cbh-text);
    background: color-mix(in srgb, var(--cbh-text) 8%, transparent);
  }

  .cb-hero--design-4 .cb-hero__features {
    margin-top: 8px;
  }

  .cb-hero--design-4 .cb-hero__feature,
  .cb-hero--design-5 .cb-hero__feature {
    font-weight: var(--cb-hero-feature-text-weight, var(--cbh-font-body-weight));
    color: var(--cbh-muted);
  }

  .cb-hero--design-4 .cb-hero__media-frame {
    border: 8px solid color-mix(in srgb, var(--cbh-text) 5%, var(--cbh-bg));
    box-shadow: none;
  }

  .cb-hero--design-4 .cb-hero__label--dark {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 12px;
    padding: 9px 16px;
    border: 0;
    border-radius: 3px;
    background: rgb(32 32 33 / 0.96);
    font-size: calc(var(--cb-hero-label-text-size, 12px) * 10 / 12);
    letter-spacing: 0.1em;
    color: #fff;
  }

  .cb-hero--design-4 .cb-hero__label--dark::before {
    content: '';
    grid-row: 1 / span 2;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--cbh-accent);
  }

  .cb-hero--design-4 .cb-hero__label-secondary {
    font-size: calc(var(--cb-hero-label-text-size, 12px) * 12.5 / 12);
    letter-spacing: 0;
    white-space: normal;
    opacity: 0.6;
  }

  @media screen and (min-width: 750px) {
    .cb-hero--design-4 .cb-hero__media-frame {
      border-width: 12px;
    }
  }

  /*
   * Design 5: text and photo share one rounded panel, with the photo filling its right side edge to edge.
   * Rules are prefixed with .cb-hero--design-5 so they beat the blocks' own defaults in any stylesheet order.
   */
  .cb-hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    max-width: var(--cbh-max-width);
    margin: 0 auto 18px;
    font-family: var(--cbh-font-body);
    font-size: var(--cb-hero-crumb-size, 12px);
    font-weight: var(--cb-hero-crumb-weight, var(--cbh-font-body-weight));
    line-height: 1.3;
    color: color-mix(in srgb, var(--cbh-text) 45%, transparent);
  }

  .cb-hero__crumbs a {
    color: color-mix(in srgb, var(--cbh-text) 70%, transparent);
    text-decoration: none;
  }

  .cb-hero__crumbs a:hover {
    color: var(--cbh-text);
  }

  .cb-hero__crumb-current {
    color: var(--cbh-text);
  }

  .cb-hero--design-5 .cb-hero__inner {
    gap: 0;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--cbh-text) 6%, transparent);
    border-radius: 8px;
    background: color-mix(in srgb, var(--cbh-text) 5.5%, var(--cbh-bg));
  }

  .cb-hero--design-5 .cb-hero__content {
    padding: 28px 20px;
  }

  .cb-hero--design-5 .cb-hero__buttons {
    gap: 18px;
  }

  .cb-hero--design-5 .cb-hero__button {
    min-height: 48px;
    padding: 14px 28px;
    border-radius: 3px;
    font-size: calc(var(--cb-hero-button-label-size, 14px) * 12 / 14);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cb-hero--design-5 .cb-hero__button--secondary {
    background: transparent;
  }

  .cb-hero--design-5 .cb-hero__button--secondary:hover {
    background: color-mix(in srgb, var(--cbh-text) 8%, transparent);
  }

  .cb-hero--design-5 .cb-hero__features--divider {
    border-top-color: color-mix(in srgb, var(--cbh-text) 60%, transparent);
  }

  .cb-hero--design-5 .cb-hero__feature {
    font-size: calc(var(--cb-hero-feature-text-size, 14px) * 12 / 14);
  }

  .cb-hero--design-5 .cb-hero__media-frame {
    height: 100%;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  @media screen and (min-width: 750px) {
    .cb-hero--design-5 .cb-hero__content {
      padding: 40px 32px;
    }
  }

  @media screen and (min-width: 990px) {
    .cb-hero--design-5 .cb-hero__content {
      align-self: center;
      padding: 56px;
    }

    .cb-hero--design-5 .cb-hero__media-frame {
      min-height: 460px;
      aspect-ratio: auto;
    }

    .cb-hero--design-5 .cb-hero__media {
      border-left: 1px solid color-mix(in srgb, var(--cbh-text) 6%, transparent);
    }
  }

  /*
   * Design 6: Design 5's panel (the section carries both classes) with the whole photo inset on the right, shown
   * uncropped at its own shape, plus a dark badge box and a filled secondary button.
   */
  .cb-hero--design-6 .cb-hero__crumbs {
    gap: 4px;
    margin-bottom: 28px;
  }

  .cb-hero--design-6 .cb-hero__crumbs a {
    color: inherit;
  }

  .cb-hero--design-6 .cb-hero__crumbs a:hover {
    color: var(--cbh-text);
  }

  .cb-hero--design-6 .cb-hero__inner {
    border: 0;
  }

  .cb-hero--design-6 .cb-hero__badge {
    gap: 7px;
    padding: 6px 11px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--cbh-text) 2.5%, var(--cbh-bg));
    letter-spacing: 0.08em;
  }

  .cb-hero--design-6 .cb-hero__badge-main {
    color: color-mix(in srgb, var(--cbh-text) 85%, transparent);
  }

  .cb-hero--design-6 .cb-hero__badge-dot {
    width: 4px;
    height: 4px;
  }

  .cb-hero--design-6 .cb-hero__button {
    padding: 14px 26px;
  }

  .cb-hero--design-6 .cb-hero__button--secondary {
    border-color: transparent;
    background: color-mix(in srgb, var(--cbh-text) 9%, var(--cbh-bg));
  }

  .cb-hero--design-6 .cb-hero__button--secondary:hover {
    border-color: transparent;
    background: color-mix(in srgb, var(--cbh-text) 14%, var(--cbh-bg));
  }

  .cb-hero--design-6 .cb-hero__features {
    margin-top: 24px;
  }

  .cb-hero--design-6 .cb-hero__media {
    align-self: center;
    padding: 0 20px 24px;
    border-left: 0;
  }

  .cb-hero--design-6 .cb-hero__media-frame {
    height: auto;
    min-height: 0;
    overflow: visible;
    aspect-ratio: auto;
    background: none;
  }

  .cb-hero--design-6 .cb-hero__image {
    position: static;
    display: block;
    height: auto;
    border-radius: var(--cbh-radius, 12px);
  }

  .cb-hero--design-6 .cb-hero__image--placeholder {
    aspect-ratio: var(--cbh-ratio, 4 / 3);
  }

  @media screen and (min-width: 750px) {
    .cb-hero--design-6 .cb-hero__media {
      padding: 0 32px 40px;
    }

    .cb-hero--design-6 .cb-hero__features {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
    }
  }

  @media screen and (min-width: 990px) {
    .cb-hero--design-6 .cb-hero__content {
      padding: 64px 0 64px 64px;
    }

    .cb-hero--design-6 .cb-hero__media {
      padding: 40px 32px;
    }

    .cb-hero--design-6 .cb-hero__media-frame {
      translate: 0 var(--cbh-image-nudge, 0px);
    }
  }

  /*
   * Design 7: Design 4's dark photo frame (the section carries both classes) with a breadcrumb, a grey badge, a filled
   * secondary button and a line above the features. Italic heading text sits on its own line in grey. The badge and
   * buttons use the heading font, and their text sizes here are the settings' own values.
   */
  .cb-hero--design-7 .cb-hero__crumbs {
    gap: 4px 9px;
    margin-bottom: 48px;
  }

  .cb-hero--design-7 .cb-hero__crumbs a {
    color: inherit;
  }

  .cb-hero--design-7 .cb-hero__crumbs a:hover {
    color: var(--cbh-text);
  }

  .cb-hero--design-7 .cb-hero__crumbs [aria-hidden] {
    opacity: 0.25;
  }

  .cb-hero--design-7 .cb-hero__badge {
    font-family: var(--cbh-font-heading);
    font-size: var(--cb-hero-badge-text-size, 12px);
  }

  .cb-hero--design-7 .cb-hero__badge-main {
    color: var(--cbh-muted);
  }

  .cb-hero--design-7 .cb-heading em {
    display: block;
    color: var(--cbh-muted);
  }

  .cb-hero--design-7 .cb-hero__buttons {
    gap: 16px;
  }

  .cb-hero--design-7 .cb-hero__button {
    min-height: 47px;
    padding: 12px 32px;
    font-family: var(--cbh-font-heading);
    font-size: var(--cb-hero-button-label-size, 14px);
  }

  .cb-hero--design-7 .cb-hero__button--secondary {
    padding-inline: 25px;
    border-color: color-mix(in srgb, var(--cbh-text) 7%, transparent);
    background: color-mix(in srgb, var(--cbh-text) 5.5%, var(--cbh-bg));
    color: color-mix(in srgb, var(--cbh-text) 85%, transparent);
  }

  .cb-hero--design-7 .cb-hero__button--secondary:hover {
    border-color: color-mix(in srgb, var(--cbh-text) 20%, transparent);
    background: color-mix(in srgb, var(--cbh-text) 10%, var(--cbh-bg));
  }

  .cb-hero--design-7 .cb-hero__features--divider {
    margin-top: var(--cbh-divider-above, 12px);
    border-top-color: color-mix(in srgb, var(--cbh-text) 38%, transparent);
  }

  .cb-hero--design-7 .cb-hero__feature {
    color: color-mix(in srgb, var(--cbh-text) 78%, transparent);
  }

  .cb-hero--design-7 .cb-hero__feature-icon svg,
  .cb-hero--design-7 .cb-hero__feature-icon img,
  .cb-hero--design-7 .cb-hero__feature-icon .cb-icon-upload {
    width: 19px;
    height: 19px;
  }

  .cb-hero--design-7 .cb-hero__media-frame {
    border-width: 8px;
  }

  .cb-hero--design-7 .cb-hero__image {
    border-radius: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cb-hero__content > *,
    .cb-hero__media {
      animation: cb-hero-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .cb-hero__content > *:nth-child(2) { animation-delay: 0.06s; }
    .cb-hero__content > *:nth-child(3) { animation-delay: 0.12s; }
    .cb-hero__content > *:nth-child(4) { animation-delay: 0.18s; }
    .cb-hero__content > *:nth-child(n + 5) { animation-delay: 0.24s; }
    .cb-hero__media { animation-delay: 0.15s; }
  }

  @keyframes cb-hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

