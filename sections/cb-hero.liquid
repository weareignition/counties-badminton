{
  "name": "[CB] Hero",
  "tag": "div",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_cb-hero-content" },
    { "type": "_cb-hero-media" }
  ],
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "design",
      "label": "Design",
      "options": [
        { "value": "1", "label": "Design 1 – framed image" },
        { "value": "2", "label": "Design 2 – full-bleed image" },
        { "value": "3", "label": "Design 3 – photo on a white mat" },
        { "value": "4", "label": "Design 4 – photo in a dark frame" },
        { "value": "5", "label": "Design 5 – text and photo in one panel" },
        { "value": "6", "label": "Design 6 – text and inset photo in one panel" },
        { "value": "7", "label": "Design 7 – dark photo frame with a breadcrumb" }
      ],
      "default": "1"
    },
    {
      "type": "text",
      "id": "breadcrumb",
      "label": "Breadcrumb",
      "info": "Shown above the panel. Separate the steps with /, e.g. Home / Equipment / Bags. The first step links to the home page.",
      "visible_if": "{{ section.settings.design == '5' or section.settings.design == '6' or section.settings.design == '7' }}"
    },
    {
      "type": "range",
      "id": "breadcrumb_size",
      "label": "Breadcrumb size",
      "min": 6,
      "max": 30,
      "step": 0.5,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.design == '5' or section.settings.design == '6' or section.settings.design == '7' }}"
    },
    {
      "type": "select",
      "id": "breadcrumb_weight",
      "label": "Breadcrumb weight",
      "options": [
        { "value": "initial", "label": "Default" },
        { "value": "100", "label": "Thin" },
        { "value": "200", "label": "Extra light" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra bold" },
        { "value": "900", "label": "Black" }
      ],
      "default": "initial",
      "visible_if": "{{ section.settings.design == '5' or section.settings.design == '6' or section.settings.design == '7' }}"
    },
    {
      "type": "select",
      "id": "media_edge",
      "label": "Image reaches",
      "info": "On desktop. Page margin stops the image at the same margin as the text side.",
      "options": [
        { "value": "screen", "label": "Screen edge" },
        { "value": "margin", "label": "Page margin" }
      ],
      "default": "screen",
      "visible_if": "{{ section.settings.design == '2' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content column width",
      "min": 40,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 55
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 960,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "checkbox",
      "id": "media_first_mobile",
      "label": "Show media first on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
