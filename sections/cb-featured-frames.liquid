{%- liquid
  assign s = section.settings
  assign font_scope = '#cb-frames-' | append: section.id
-%}

{% render 'cb-font-styles',
  selector: font_scope,
  prefix: 'cbp',
  heading_font: s.heading_font,
  body_font: s.body_font
%}

<section
  id="cb-frames-{{ section.id }}"
  class="cb-frames"
  data-cb-frames
  style="
    --cbp-bg: {{ s.background_color }};
    --cbp-card: {{ s.card_background_color }};
    --cbp-border: {{ s.border_color }};
    --cbp-border-hover: {{ s.text_color | color_modify: 'alpha', 0.25 }};
    --cbp-surface: {{ s.text_color | color_modify: 'alpha', 0.04 }};
    --cbp-surface-strong: {{ s.text_color | color_modify: 'alpha', 0.06 }};
    --cbp-text: {{ s.text_color }};
    --cbp-muted: {{ s.text_color | color_modify: 'alpha', 0.6 }};
    --cbp-accent: {{ s.accent_color }};
    --cbp-accent-text: {{ s.accent_text_color }};
    --cbp-image-bg: {{ s.image_background_color }};
    --cbp-perk: {{ s.perk_color }};
    --cbp-star: {{ s.star_color }};
    --cbp-star-empty: {{ s.text_color | color_modify: 'alpha', 0.2 }};
    --cbp-radius: {{ s.card_radius }}px;
    --cbp-max-width: {{ s.max_width }}px;
    --cbp-stack-gap: {{ s.stack_gap }}px;
    --cbp-pt: {{ s.padding_top }}px;
    --cbp-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="cb-frames__inner">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .cb-frames {
    color: var(--cbp-text);
    background: var(--cbp-bg);
    padding: calc(var(--cbp-pt) * 0.6) 16px calc(var(--cbp-pb) * 0.6);
    /* Keeps the section clear of the sticky header when other sections scroll to it. */
    scroll-margin-top: var(--header-height, 0px);
  }

  .cb-frames__inner {
    display: flex;
    flex-direction: column;
    gap: calc(var(--cbp-stack-gap) * 0.75);
    max-width: var(--cbp-max-width);
    margin-inline: auto;
  }

  @media screen and (min-width: 750px) {
    .cb-frames {
      padding: calc(var(--cbp-pt) * 0.8) 32px calc(var(--cbp-pb) * 0.8);
    }

    .cb-frames__inner {
      gap: var(--cbp-stack-gap);
    }
  }

  @media screen and (min-width: 990px) {
    .cb-frames {
      padding: var(--cbp-pt) 48px var(--cbp-pb);
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const ROOT = '[data-cb-frames]';

    const applyFilter = (root, value) => {
      for (const pill of root.querySelectorAll('[data-cb-filter]')) {
        pill.setAttribute('aria-pressed', String(pill.dataset.cbFilter === value));
      }

      let shown = 0;
      for (const card of root.querySelectorAll('[data-cb-filter-keys]')) {
        const match = value === 'all' || card.dataset.cbFilterKeys.split(' ').includes(value);
        card.hidden = !match;
        if (match) shown += 1;
      }

      const empty = root.querySelector('[data-cb-frames-empty]');
      if (empty) empty.hidden = shown > 0;
    };

    document.addEventListener('click', (event) => {
      const pill = event.target.closest?.('[data-cb-filter]');
      const root = pill?.closest(ROOT);
      if (root) applyFilter(root, pill.dataset.cbFilter);
    });

    // In the theme editor, show a card when it's selected even if the active filter hides it.
    document.addEventListener('shopify:block:select', (event) => {
      const card = event.target.closest?.('[data-cb-filter-keys]');
      const root = card?.closest(ROOT);
      if (root && card.hidden) applyFilter(root, 'all');
    });

    // Other sections (e.g. [CB] Playing tactics) can filter this grid by dispatching
    // a bubbling 'cb:frames-filter' event on it with { detail: { value } }.
    document.addEventListener('cb:frames-filter', (event) => {
      const root = event.target.closest?.(ROOT);
      if (root) applyFilter(root, event.detail?.value || 'all');
    });
  })();
{% endjavascript %}

