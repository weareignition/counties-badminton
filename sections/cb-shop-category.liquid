{%- liquid
  assign s = section.settings
  assign font_scope = '#cb-category-' | append: section.id
-%}

{% render 'cb-font-styles',
  selector: font_scope,
  prefix: 'cbc',
  heading_font: s.heading_font,
  body_font: s.body_font
%}

<section
  id="cb-category-{{ section.id }}"
  class="cb-category"
  style="
    --cbc-bg: {{ s.background_color }};
    --cbc-card: {{ s.card_background_color }};
    --cbc-text: {{ s.text_color }};
    --cbc-muted: {{ s.text_color | color_modify: 'alpha', 0.6 }};
    --cbc-border: {{ s.text_color | color_modify: 'alpha', 0.08 }};
    --cbc-border-hover: {{ s.text_color | color_modify: 'alpha', 0.22 }};
    --cbc-surface: {{ s.text_color | color_modify: 'alpha', 0.04 }};
    --cbc-accent: {{ s.accent_color }};
    --cbc-accent-text: {{ s.accent_text_color }};
    --cbc-radius: {{ s.card_radius }}px;
    --cbc-max-width: {{ s.max_width }}px;
    --cbc-stack-gap: {{ s.stack_gap }}px;
    --cbc-pt: {{ s.padding_top }}px;
    --cbc-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="cb-category__inner">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  .cb-category {
    color: var(--cbc-text);
    background: var(--cbc-bg);
    padding: calc(var(--cbc-pt) * 0.6) 16px calc(var(--cbc-pb) * 0.6);
  }

  .cb-category__inner {
    display: flex;
    flex-direction: column;
    gap: calc(var(--cbc-stack-gap) * 0.75);
    max-width: var(--cbc-max-width);
    margin-inline: auto;
  }

  @media screen and (min-width: 750px) {
    .cb-category {
      padding: calc(var(--cbc-pt) * 0.8) 32px calc(var(--cbc-pb) * 0.8);
    }

    .cb-category__inner {
      gap: var(--cbc-stack-gap);
    }
  }

  @media screen and (min-width: 990px) {
    .cb-category {
      padding: var(--cbc-pt) 48px var(--cbc-pb);
    }
  }

  /* Shared by the featured card and category cards */
  .cb-category__card {
    position: relative;
    display: flex;
    min-width: 0;
    background: var(--cbc-card);
    border: 1px solid var(--cbc-border);
    border-radius: var(--cbc-radius);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .cb-category__card:hover {
    border-color: var(--cbc-border-hover);
  }

  .cb-category__card:focus-visible {
    outline: 2px solid var(--cbc-text);
    outline-offset: 3px;
  }

  .cb-category__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .cb-category__image--placeholder {
    fill: var(--cbc-muted);
    background: var(--cbc-surface);
  }

  .cb-category__badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 1;
    max-width: calc(100% - 16px);
    padding: 3px 6px;
    border-radius: 3px;
    font-family: var(--cbc-font-body);
    font-weight: var(--cbc-font-body-strong);
    font-size: 9px;
    line-height: 1.25;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cb-category__badge--accent {
    background: var(--cbc-accent);
    color: var(--cbc-accent-text);
  }

  .cb-category__badge--dark {
    background: rgb(0 0 0 / 0.75);
    color: #fff;
  }

  .cb-category__badge--light {
    background: rgb(255 255 255 / 0.9);
    color: #111;
  }

  .cb-category__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--cbc-font-body);
    font-weight: var(--cbc-font-body-strong);
    font-size: 12px;
    line-height: 1.3;
    color: var(--cbc-text);
  }

  .cb-category__cta--accent {
    color: var(--cbc-accent);
  }

  .cb-category__arrow {
    flex: none;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .cb-category__card:hover .cb-category__arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cb-category__card:hover .cb-category__image {
      transform: scale(1.04);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Shop by category",
  "tag": "div",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_cb-category-header" },
    { "type": "_cb-category-grid" }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 960,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "stack_gap",
      "label": "Space between header and cards",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "info": "Used for the section heading and card titles.",
      "default": "space_grotesk_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "info": "Used for the eyebrow, text, descriptions, badges and links.",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background",
      "default": "#181818"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d71f27"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Text on accent",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "[CB] Shop by category",
      "category": "t:categories.collections",
      "blocks": {
        "header": {
          "type": "_cb-category-header",
          "blocks": {
            "eyebrow": {
              "type": "cb-subheader",
              "settings": { "subheader_text": "Shop by category", "size": 11, "letter_spacing": 12, "space_below": 10 }
            },
            "heading": {
              "type": "cb-heading",
              "settings": {
                "heading_text": "Shop badminton gear",
                "size": 40,
                "mobile_sizing": "fluid",
                "line_height": 110,
                "letter_spacing": -2
              }
            },
            "text": {
              "type": "cb-paragraph",
              "settings": {
                "body_text": "<p>Curated directly by Counties Manukau stringers and players. Tested on Papakura courts.</p>",
                "size": 13,
                "mobile_size": 13,
                "line_height": 155,
                "max_width_unit": "ch"
              }
            }
          },
          "block_order": ["eyebrow", "heading", "text"]
        },
        "grid": {
          "type": "_cb-category-grid",
          "blocks": {
            "featured": {
              "type": "_cb-category-featured",
              "settings": {
                "badge_text": "Core specialty",
                "badge_style": "accent",
                "image_label": "Victor • Yonex • Ashaway",
                "card_title": "Rackets",
                "description": "Power, speed & control frames calibrated for singles attack and fast doubles exchanges. Tested at 41R Elliot St.",
                "link_label": "Explore 40+ Frames",
                "link_style": "accent"
              }
            },
            "list": {
              "type": "_cb-category-list",
              "blocks": {
                "card_1": {
                  "type": "_cb-category-card",
                  "settings": {
                    "badge_text": "Grip & stability",
                    "badge_style": "dark",
                    "card_title": "Court Footwear",
                    "description": "Grip, lateral stability and ankle support engineered specifically for wooden courts.",
                    "link_label": "View Footwear",
                    "link_style": "text"
                  }
                },
                "card_2": {
                  "type": "_cb-category-card",
                  "settings": {
                    "badge_text": "Flight tested",
                    "badge_style": "dark",
                    "card_title": "Match Shuttles",
                    "description": "Tournament feather & high-durability hybrid shuttles for club nights and match play.",
                    "link_label": "Bulk & Club Shuttles",
                    "link_style": "text"
                  }
                },
                "card_3": {
                  "type": "_cb-category-card",
                  "settings": {
                    "badge_text": "24h lab",
                    "badge_style": "accent",
                    "card_title": "Stringing",
                    "description": "Electronic linear tension pull, custom string selection and 24-hour turnaround at Papakura.",
                    "link_label": "Book Stringing",
                    "link_style": "text"
                  }
                }
              },
              "block_order": ["card_1", "card_2", "card_3"]
            }
          },
          "block_order": ["featured", "list"]
        }
      },
      "block_order": ["header", "grid"]
    }
  ]
}
{% endschema %}
