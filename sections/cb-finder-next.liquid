    {
      "type": "url",
      "id": "retake_link",
      "label": "Retake link",
      "info": "Used when the quiz isn't on this page, e.g. the racket finder page."
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Shop link text",
      "info": "Leave empty to hide.",
      "default": "Shop all rackets"
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "info": "The chosen style sets the heading weight. Buttons use its medium style.",
      "default": "space_grotesk_n6"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0b0b0b"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Cards and retake button",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "icon_box_color",
      "label": "Icon boxes and dark buttons",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#a1a1aa"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d71f27"
    },
    {
      "type": "color",
      "id": "light_button_color",
      "label": "White button",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "light_button_text_color",
      "label": "White button text",
      "default": "#0b0b0b"
    },
    {
      "type": "color",
      "id": "dot_color",
