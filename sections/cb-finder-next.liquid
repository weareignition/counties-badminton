{%- liquid
  assign s = section.settings
  assign font_scope = '#cb-fnext-' | append: section.id
  assign retake_link = s.retake_link | default: '#racket-finder'
-%}

{% render 'cb-font-styles',
  selector: font_scope,
  prefix: 'cbfn',
  heading_font: s.heading_font,
  body_font: s.body_font
%}

<section
  id="cb-fnext-{{ section.id }}"
  class="cb-fnext"
  style="
    --cbfn-bg: {{ s.background_color }};
    --cbfn-card: {{ s.card_color }};
    --cbfn-icon-box: {{ s.icon_box_color }};
    --cbfn-text: {{ s.text_color }};
    --cbfn-muted: {{ s.muted_text_color }};
    --cbfn-accent: {{ s.accent_color }};
    --cbfn-light: {{ s.light_button_color }};
    --cbfn-light-text: {{ s.light_button_text_color }};
    --cbfn-dot: {{ s.dot_color }};
    --cbfn-radius: {{ s.card_radius }}px;
    --cbfn-gap: {{ s.card_gap }}px;
    --cbfn-max-width: {{ s.max_width }}px;
    --cbfn-stack-gap: {{ s.stack_gap }}px;
    --cbfn-pt: {{ s.padding_top }}px;
    --cbfn-pb: {{ s.padding_bottom }}px;
    --cb-finder-next-links-size: {{ s.links_size }}px;
    --cb-finder-next-links-weight: {{ s.links_weight }};
  "
>
  <div class="cb-fnext__inner">
    <div class="cb-fnext__cards">
      {% content_for 'blocks' %}
    </div>

    {%- if s.retake_label != blank or s.shop_label != blank -%}
      <div class="cb-fnext__row">
        {%- if s.retake_label != blank -%}
          <a class="cb-fnext__retake" href="{{ retake_link }}" data-cb-fnext-retake>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v6"/><path d="M7.1 6.1a8 8 0 1 0 9.8 0"/></svg>
            <span>{{ s.retake_label | escape }}</span>
          </a>
        {%- endif -%}
        {%- if s.shop_label != blank -%}
          <a class="cb-fnext__shop" href="{{ s.shop_link | default: routes.all_products_collection_url }}">{{ s.shop_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cb-fnext {
    color: var(--cbfn-text);
    background: var(--cbfn-bg);
    padding: calc(var(--cbfn-pt) * 0.7) 16px calc(var(--cbfn-pb) * 0.7);
  }

  .cb-fnext__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--cbfn-stack-gap) * 0.6);
    max-width: var(--cbfn-max-width);
    margin-inline: auto;
  }

  .cb-fnext__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    width: 100%;
  }

  .cb-fnext__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 19px;
  }

  .cb-fnext__retake,
  .cb-fnext__shop {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 43px;
    font-family: var(--cbfn-font-heading);
    font-weight: var(--cb-finder-next-links-weight, var(--cbfn-font-heading-medium-weight));
    font-size: var(--cb-finder-next-links-size, 16px);
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .cb-fnext__retake {
    padding: 0 24px;
    border-radius: 3px;
    background: var(--cbfn-card);
    color: var(--cbfn-text);
  }

  .cb-fnext__retake:hover {
    background: color-mix(in srgb, var(--cbfn-text) 8%, var(--cbfn-card));
  }

  .cb-fnext__retake svg {
    flex: none;
  }

  .cb-fnext__shop {
    color: var(--cbfn-muted);
  }

  .cb-fnext__shop:hover {
    color: var(--cbfn-text);
  }

  .cb-fnext__retake:focus-visible,
  .cb-fnext__shop:focus-visible {
    outline: 2px solid var(--cbfn-text);
    outline-offset: 3px;
  }

  @media screen and (min-width: 750px) {
    .cb-fnext {
      padding: var(--cbfn-pt) 32px var(--cbfn-pb);
    }

    .cb-fnext__inner {
      gap: var(--cbfn-stack-gap);
    }

    .cb-fnext__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--cbfn-gap);
    }
  }

  @media screen and (min-width: 990px) {
    .cb-fnext {
      padding-inline: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cb-fnext__retake,
    .cb-fnext__shop {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    // "Retake finder" restarts the racket quiz on this page (Racket matcher or Racket finder quiz) and scrolls to it;
    // with no quiz on the page it follows its link.
    document.addEventListener('click', (event) => {
      const link = event.target.closest?.('[data-cb-fnext-retake]');
      if (!link) return;
      const restart = document.querySelector('[data-cb-rmatch] [data-cb-rmatch-restart], [data-cb-quiz-section] [data-cb-quiz-restart]');
      if (!restart) return;
      event.preventDefault();
      restart.click();
      const quiz = restart.closest('[data-cb-rmatch], [data-cb-quiz-section]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      quiz?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "[CB] Finder next steps",
  "tag": "div",
  "class": "section-wrapper",
  "blocks": [{ "type": "_cb-fnext-card" }],
  "max_blocks": 4,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1060
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "stack_gap",
      "label": "Space above the bottom links",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Bottom links"
    },
    {
      "type": "text",
      "id": "retake_label",
      "label": "Retake button",
      "info": "Restarts the racket quiz on this page. Leave empty to hide.",
      "default": "Retake finder"
