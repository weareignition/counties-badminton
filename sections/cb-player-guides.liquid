          "settings": {
            "label": "Related guide",
            "card_title": "Understanding String Tension",
            "summary": "See how higher and lower tensions change control, power and forgiveness, and how to find a practical starting point for your game.",
            "product": "yonex-badminton-string-10m-packet"
          }
        },
        "shuttles": {
          "type": "_cb-pguide-card",
          "settings": {
            "label": "Related guide",
            "card_title": "Shuttle Speeds Explained",
            "summary": "Understand speed ratings, temperature and hall conditions so you can choose a shuttle that flies correctly for training or competition.",
            "product": "victor-ncs-caron-sonic-shuttlecock-tube-of-6"
          }
        },
        "grip": {
