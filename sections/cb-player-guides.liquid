        },
        "tension": {
          "type": "_cb-pguide-card",
          "settings": {
            "card_title": "Understanding String Tension",
            "summary": "See how higher and lower tensions change control, power and forgiveness, and how to find a practical starting point for your game.",
            "product": "yonex-badminton-string-10m-packet"
          }
        },
        "shuttles": {
          "type": "_cb-pguide-card",
          "settings": {
            "card_title": "Shuttle Speeds Explained",
            "summary": "Understand speed ratings, temperature and hall conditions so you can choose a shuttle that flies correctly for training or competition.",
            "product": "victor-ncs-caron-sonic-shuttlecock-tube-of-6"
          }
        },
        "grip": {
          "type": "_cb-pguide-card",
          "settings": {
            "card_title": "Grip Sizing & Comfort",
            "summary": "Explore how thickness, texture and absorbency affect control and comfort, plus simple ways to adjust your grip for your hand and playing intensity.",
            "product": "yonex-cushion-leather-grip"
          }
        }
      },
      "block_order": ["header", "racket", "tension", "shuttles", "grip"]
    },
    {
      "name": "[CB] Related guides",
      "category": "t:categories.text",
      "settings": {
        "columns": 3,
        "show_photos": false,
        "equal_height": false
      },
      "blocks": {
        "header": {
          "type": "_cb-pguide-header",
          "blocks": {
            "eyebrow": {
              "type": "cb-subheader",
              "settings": {
                "subheader_text": "Keep learning",
                "size": 11,
                "space_below": 3
              }
            },
            "heading": {
              "type": "cb-heading",
              "settings": {
                "heading_text": "Related guides",
                "size": 40,
