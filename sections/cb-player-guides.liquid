          "settings": {
            "label": "Related guide",
            "card_title": "Grip Sizing & Comfort",
            "summary": "Explore how thickness, texture and absorbency affect control and comfort, plus simple ways to adjust your grip for your hand and playing intensity.",
            "product": "yonex-cushion-leather-grip"
