{%- liquid
  assign s = section.settings
  assign tablet_columns = s.columns | at_most: 2
-%}
{%- comment -%} Fonts for the optional heading come from the first card's font settings via the same variables. {%- endcomment -%}
{%- if s.heading != blank or s.eyebrow != blank or s.text != blank -%}
  {%- assign font_scope = '#cb-bundles-' | append: section.id | append: ' .cb-bundles__head' -%}
  {% render 'cb-font-styles',
    selector: font_scope,
    prefix: 'cbbu',
    heading_font: s.heading_font,
    body_font: s.body_font
  %}
{%- endif -%}

<section
  id="cb-bundles-{{ section.id }}"
  class="cb-bundles{% if s.equal_height %} cb-bundles--equal{% endif %}"
  style="
    --cbbu-bg: {{ s.background_color }};
    --cbbu-card: {{ s.card_color }};
    --cbbu-frame: {{ s.frame_color }};
    --cbbu-photo: {{ s.photo_color }};
    --cbbu-text: {{ s.text_color }};
    --cbbu-soft: {{ s.item_text_color }};
    --cbbu-muted: {{ s.muted_text_color }};
    --cbbu-accent: {{ s.accent_color }};
    --cbbu-radius: {{ s.card_radius }}px;
    --cbbu-columns: {{ s.columns }};
    --cbbu-columns-tablet: {{ tablet_columns }};
    --cbbu-gap: {{ s.card_gap }}px;
    --cbbu-max-width: {{ s.max_width }}px;
    --cbbu-pt: {{ s.padding_top }}px;
    --cbbu-pb: {{ s.padding_bottom }}px;
    --cb-bundles-eyebrow-size: {{ s.eyebrow_size }}px;
    --cb-bundles-eyebrow-weight: {{ s.eyebrow_weight }};
    --cb-bundles-heading-size: {{ s.heading_size }}px;
    --cb-bundles-heading-weight: {{ s.heading_weight }};
    --cb-bundles-text-size: {{ s.text_size }}px;
    --cb-bundles-text-weight: {{ s.text_weight }};
  "
>
  <div class="cb-bundles__inner">
    {%- if s.heading != blank or s.eyebrow != blank or s.text != blank -%}
      <div class="cb-bundles__head">
        {%- if s.eyebrow != blank -%}
          <p class="cb-bundles__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="cb-bundles__heading">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <p class="cb-bundles__text">{{ s.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="cb-bundles__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% stylesheet %}
  .cb-bundles {
    color: var(--cbbu-text);
    background: var(--cbbu-bg);
    padding: calc(var(--cbbu-pt) * 0.7) 16px calc(var(--cbbu-pb) * 0.7);
  }

  .cb-bundles__inner {
    max-width: var(--cbbu-max-width);
    margin-inline: auto;
  }

  .cb-bundles__head {
    margin-bottom: 32px;
  }

  .cb-bundles .cb-bundles__eyebrow {
    margin: 0;
    font-family: var(--cbbu-font-body);
    font-weight: var(--cb-bundles-eyebrow-weight, var(--cbbu-font-body-strong));
    font-size: var(--cb-bundles-eyebrow-size, 10px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cbbu-accent);
  }

  .cb-bundles .cb-bundles__heading {
    margin: 10px 0 0;
    font-family: var(--cbbu-font-heading);
    font-weight: var(--cb-bundles-heading-weight, var(--cbbu-font-heading-medium-weight));
    font-size: calc(var(--cb-bundles-heading-size, 32px) * 26 / 32);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--cbbu-text);
  }

  .cb-bundles .cb-bundles__text {
    max-width: 640px;
    margin: 12px 0 0;
    font-family: var(--cbbu-font-body);
    font-weight: var(--cb-bundles-text-weight, inherit);
    font-size: var(--cb-bundles-text-size, 15px);
    line-height: 1.55;
    color: var(--cbbu-muted);
  }

  /* Cards keep their own height (like the design) unless "Same height cards" is on. */
  .cb-bundles__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 16px;
  }

  .cb-bundles--equal .cb-bundles__grid {
    align-items: stretch;
  }

  .cb-bundles--equal .cb-bundle__button {
    margin-top: auto;
  }

  .cb-bundles--equal .cb-bundle__items {
    margin-bottom: 18px;
  }

  @media screen and (min-width: 750px) {
    .cb-bundles {
      padding: var(--cbbu-pt) 32px var(--cbbu-pb);
    }

    .cb-bundles .cb-bundles__heading {
      font-size: var(--cb-bundles-heading-size, 32px);
    }

    .cb-bundles__grid {
      grid-template-columns: repeat(var(--cbbu-columns-tablet, 2), minmax(0, 1fr));
      gap: var(--cbbu-gap);
    }
  }

  @media screen and (min-width: 990px) {
    .cb-bundles {
      padding-inline: 48px;
    }

    .cb-bundles__grid {
      grid-template-columns: repeat(var(--cbbu-columns), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
