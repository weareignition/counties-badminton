{%- comment -%}
  A panel built from the shared blocks: [CB] Subheader, Heading, Paragraph and Button run across the full width,
  [CB] Highlight cards and [CB] Cards fill the columns below them.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign font_scope = '#cb-suits-' | append: section.id
  assign tablet_columns = s.columns | at_most: s.tablet_columns
-%}

{% render 'cb-font-styles',
  selector: font_scope,
  prefix: 'cbsu',
  heading_font: s.heading_font,
  body_font: s.body_font
%}

<section
  id="cb-suits-{{ section.id }}"
  class="cb-suits{% if s.equal_height %} cb-suits--equal{% endif %}"
  style="
    --cbsu-bg: {{ s.background_color }};
    --cbsu-panel: {{ s.panel_color }};
    --cbsu-text: {{ s.text_color }};
    --cbsu-muted: {{ s.muted_text_color }};
    --cbsu-accent: {{ s.accent_color }};
    --cbsu-max-width: {{ s.max_width }}px;
    --cbsu-side: {{ s.side_padding }}px;
    --cbsu-panel-padding: {{ s.panel_padding }}px;
    --cbsu-radius: {{ s.panel_radius }}px;
    --cbsu-columns: {{ s.columns }};
    --cbsu-columns-tablet: {{ tablet_columns }};
    --cbsu-card-gap: {{ s.card_gap }}px;
    --cbsu-text-gap: {{ s.text_gap }}px;
    --cbsu-cards-gap: {{ s.cards_gap }}px;
    --cbsu-pt: {{ s.padding_top }}px;
    --cbsu-pb: {{ s.padding_bottom }}px;
  "
>
  <div class="cb-suits__panel">
    <div class="cb-suits__grid">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cb-suits {
    color: var(--cbsu-text);
    background: var(--cbsu-bg);
    padding: var(--cbsu-pt) 16px var(--cbsu-pb);
  }

  .cb-suits__panel {
    max-width: var(--cbsu-max-width);
    box-sizing: border-box;
    margin-inline: auto;
    padding: calc(var(--cbsu-panel-padding) * 0.6);
    border-radius: var(--cbsu-radius);
    background: var(--cbsu-panel);
  }

  /* Text blocks span the row; cards fill the columns. */
  .cb-suits__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--cbsu-card-gap);
  }

  .cb-suits--equal .cb-suits__grid {
    align-items: stretch;
  }

  .cb-suits__grid > :not(.cb-hcard, .cb-card) {
    grid-column: 1 / -1;
    align-self: start;
  }

  .cb-suits__grid > .cb-button:not(.cb-button--full) {
    justify-self: start;
  }

  /* Text that follows text sits closer; the last block before the cards sets the space above them. */
  .cb-suits__grid > :is(.cb-subheader, .cb-heading, .cb-paragraph, .cb-button) + :is(.cb-subheader, .cb-heading, .cb-paragraph, .cb-button) {
    margin-top: calc(var(--cbsu-text-gap) - var(--cbsu-card-gap));
  }

  .cb-suits__grid > :not(.cb-hcard, .cb-card):has(+ :is(.cb-hcard, .cb-card)) {
    margin-bottom: calc(var(--cbsu-cards-gap) - var(--cbsu-card-gap));
  }

  .cb-suits__grid:empty::before {
    content: '';
    display: block;
    min-height: 80px;
    border: 1px dashed rgb(255 255 255 / 0.2);
  }

  @media screen and (min-width: 750px) {
    .cb-suits {
      padding-inline: var(--cbsu-side);
    }

    .cb-suits__panel {
      padding: var(--cbsu-panel-padding);
    }

    .cb-suits__grid {
      grid-template-columns: repeat(var(--cbsu-columns-tablet), minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 990px) {
    .cb-suits__grid {
      grid-template-columns: repeat(var(--cbsu-columns), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "[CB] Who it suits",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
