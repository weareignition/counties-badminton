{%- doc -%}
  A row of star icons filled to a rating (partly filled stars for decimals, e.g. 4.9). Filled stars use
  --cb-stars-color (default: the accent), empty ones --cb-stars-empty.

  @param {number} rating - The rating, e.g. 4.9.
  @param {number} [scale] - Highest rating. Defaults to 5.
  @param {number} [size] - Star size in px. Defaults to 10.
{%- enddoc -%}

{%- liquid
  assign max = scale | default: 5 | plus: 0
  assign star_size = size | default: 10
  # The viewBox is cropped to the star, so stars touch and the size is the star's width.
  assign star_height = star_size | times: 0.954 | round: 2
  assign percent = rating | times: 100.0 | divided_by: max
  if percent > 100
    assign percent = 100
  elsif percent < 0
    assign percent = 0
  endif
  capture row
    for i in (1..max)
      echo '<svg width="' | append: star_size | append: '" height="' | append: star_height | append: '" viewBox="2.2 2.2 19.6 18.7" aria-hidden="true"><path d="M12 2.2l2.95 6.3 6.85.85-5.05 4.75 1.3 6.8L12 17.55 5.95 20.9l1.3-6.8L2.2 9.35l6.85-.85z"/></svg>'
    endfor
  endcapture
-%}

<span class="cb-stars" role="img" aria-label="{{ rating }} / {{ max }}" style="--cb-stars-fill: {{ percent | round: 1 }}%;">
  <span class="cb-stars__row cb-stars__row--empty">{{ row }}</span>
  <span class="cb-stars__row cb-stars__row--full">{{ row }}</span>
</span>

{%- comment -%} Styles live in the sections that use stars ([CB] Reviews). {%- endcomment -%}
